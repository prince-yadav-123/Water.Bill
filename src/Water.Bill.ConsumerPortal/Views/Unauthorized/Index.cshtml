@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Denied";
    string? permission = ViewBag.Permission as string;
    string? returnUrl = ViewBag.ReturnUrl as string;
}

<div class="card" style="max-width:540px;margin:80px auto;text-align:center;padding:48px 40px;">
    <div style="font-size:52px;margin-bottom:24px;color:#dc2626;">!</div>
    <h2 style="font-size:24px;font-weight:700;color:#0f172a;margin-bottom:8px;">Access Denied</h2>
    <p style="color:#64748b;margin-bottom:24px;">
        You do not have the required permission to view this page.
    </p>

    @if (!string.IsNullOrEmpty(permission))
    {
        <div style="display:inline-block;background:#fef2f2;color:#b91c1c;padding:6px 16px;border-radius:6px;border:1px solid #fecaca;font-size:13px;font-family:monospace;margin-bottom:28px;">
            @Uri.UnescapeDataString(permission)
        </div>
    }

    <p style="color:#64748b;font-size:14px;margin-bottom:32px;">
        If you believe this is a mistake, please contact support or your administrator to review the assigned permissions.
    </p>

    <div class="d-flex justify-content-center gap-2 flex-wrap">
        @if (!string.IsNullOrEmpty(returnUrl))
        {
            <a class="btn btn-outline-primary" href="javascript:history.back()">Go Back</a>
        }
        <a class="btn btn-primary" href="/Consumer/Dashboard">Go to Dashboard</a>
    </div>
</div>
