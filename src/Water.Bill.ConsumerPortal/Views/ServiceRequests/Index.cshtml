@model Water.Bill.ConsumerPortal.ViewModels.ConsumerServiceRequestListViewModel
@{
    string StatusClass(string? status) => status switch
    {
        "Submitted" or "Pending" or "UnderReview" => "text-bg-primary",
        "Approved" => "text-bg-success",
        "Rejected" => "text-bg-danger",
        _ => "text-bg-secondary"
    };
    string RequestType(string? appType) => appType == "TRN" ? "Name Transfer" : "Connection Change";
}

<div class="wb-newconn-page-shell">
    <div class="wb-page-head">
        <div>
            <h1>My Service Requests</h1>
            <p>Track name transfer and connection change requests submitted for your linked connections.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-action="ConnectionChange">Connection Change</a>
            <a class="btn btn-primary" asp-action="NameTransfer">Name Transfer</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <section class="wb-page-card wb-approval-section">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Search</label>
                <input class="form-control" name="search" value="@Model.Search" placeholder="Application no / consumer no / name" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select class="form-select" name="status">
                    <option value="">All Status</option>
                    @foreach (var item in new[] { "Submitted", "UnderReview", "Approved", "Rejected" })
                    {
                        <option value="@item" selected="@(Model.Status == item)">@item</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">Filter</button>
            </div>
        </form>
    </section>

    <section class="wb-page-card wb-approval-section">
        <div class="table-responsive wb-approval-table-wrap">
            <table class="table align-middle wb-table wb-approval-table">
                <thead>
                <tr>
                    <th>Application No</th>
                    <th>Type</th>
                    <th>Consumer No</th>
                    <th>Name</th>
                    <th>Property</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Applications.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No service requests found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Applications)
                    {
                        <tr>
                            <td><strong>@item.ApplicationId</strong></td>
                            <td>@RequestType(item.AppType)</td>
                            <td>@item.ConsNo</td>
                            <td>@item.ConName</td>
                            <td>@($"{item.SectorVill} / {item.Block}-{item.PlotNo}".Trim(' ', '/', '-'))</td>
                            <td><span class="badge @StatusClass(item.ApplicationStatus)">@item.ApplicationStatus</span></td>
                            <td>@(item.EnterDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.ApplicationId">View</a></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
