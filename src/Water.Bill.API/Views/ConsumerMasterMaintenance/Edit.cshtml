@model Water.Bill.API.Models.Consumers.ConsumerMasterMaintenanceFormViewModel
@{
    ViewData["Title"] = "Edit Consumer";
}

<div class="wb-page-head">
    <div>
        <h1>Edit Consumer</h1>
        <p>Maintain old-compatible consumer master fields without changing consumer number or old table structure.</p>
    </div>
    <div class="wb-actions">
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-consumerNo="@Model.ConsumerNo">Back</a>
    </div>
</div>

<section class="wb-page-card wb-admin-card">
    <form asp-action="Edit" method="post" class="wb-bulk-bill-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ConsumerNo" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="wb-form-section-head">
            <h2 class="wb-section-title mb-1">Basic Details</h2>
            <p class="text-muted mb-0">Consumer number is protected. Update only the fields required for maintenance.</p>
        </div>

        <div class="wb-form-grid wb-form-grid-2">
            <div class="wb-form-field">
                <label class="form-label">Consumer No</label>
                <input class="form-control" value="@Model.ConsumerNo" readonly />
            </div>
            <div class="wb-form-field">
                <label asp-for="IsActive" class="form-label"></label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="ConsumerName" class="form-label"></label>
                <input asp-for="ConsumerName" class="form-control" />
                <span asp-validation-for="ConsumerName" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="FatherName" class="form-label"></label>
                <input asp-for="FatherName" class="form-control" />
                <span asp-validation-for="FatherName" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="MobileNo" class="form-label"></label>
                <input asp-for="MobileNo" class="form-control" />
                <span asp-validation-for="MobileNo" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="wb-form-field" style="grid-column: 1 / -1;">
                <label asp-for="Address" class="form-label"></label>
                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <div class="wb-form-section-head">
            <h2 class="wb-section-title mb-1">Property Details</h2>
        </div>

        <div class="wb-form-grid wb-form-grid-2">
            <div class="wb-form-field">
                <label asp-for="DevType" class="form-label"></label>
                <select asp-for="DevType" asp-items="Model.DivisionOptions" class="form-select">
                    <option value="">Select division</option>
                </select>
                <span asp-validation-for="DevType" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="Sector" class="form-label"></label>
                <input asp-for="Sector" class="form-control" />
                <span asp-validation-for="Sector" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="Block" class="form-label"></label>
                <input asp-for="Block" class="form-control" />
                <span asp-validation-for="Block" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="FlatNo" class="form-label"></label>
                <input asp-for="FlatNo" class="form-control" />
                <span asp-validation-for="FlatNo" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="PlotSize" class="form-label"></label>
                <input asp-for="PlotSize" class="form-control" type="number" min="0" />
                <span asp-validation-for="PlotSize" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="FlatType" class="form-label"></label>
                <select asp-for="FlatType" asp-items="Model.FlatTypeOptions" class="form-select">
                    <option value="">Select / leave blank</option>
                </select>
                <span asp-validation-for="FlatType" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="VillageName" class="form-label"></label>
                <input asp-for="VillageName" class="form-control" />
                <span asp-validation-for="VillageName" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="KhasraNo" class="form-label"></label>
                <input asp-for="KhasraNo" class="form-control" />
                <span asp-validation-for="KhasraNo" class="text-danger"></span>
            </div>
        </div>

        <div class="wb-form-section-head">
            <h2 class="wb-section-title mb-1">Connection & Billing Details</h2>
        </div>

        <div class="wb-form-grid wb-form-grid-2">
            <div class="wb-form-field">
                <label asp-for="ConnectionType" class="form-label"></label>
                <select asp-for="ConnectionType" asp-items="Model.ConnectionTypeOptions" class="form-select">
                    <option value="">Select connection type</option>
                </select>
                <span asp-validation-for="ConnectionType" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="Category" class="form-label"></label>
                <select asp-for="Category" asp-items="Model.CategoryOptions" class="form-select">
                    <option value="">Select category</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="PipeSize" class="form-label"></label>
                <select asp-for="PipeSize" asp-items="Model.PipeSizeOptions" class="form-select">
                    <option value="">Select pipe size</option>
                </select>
                <span asp-validation-for="PipeSize" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="Purpose" class="form-label"></label>
                <input asp-for="Purpose" class="form-control" />
                <span asp-validation-for="Purpose" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="ConnectionDate" class="form-label"></label>
                <input asp-for="ConnectionDate" class="form-control" type="date" />
                <span asp-validation-for="ConnectionDate" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="TypeChangeDate" class="form-label"></label>
                <input asp-for="TypeChangeDate" class="form-control" type="date" />
                <span asp-validation-for="TypeChangeDate" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="MonthlyRate" class="form-label"></label>
                <input asp-for="MonthlyRate" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="MonthlyRate" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="MonthlyCharges" class="form-label"></label>
                <input asp-for="MonthlyCharges" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="MonthlyCharges" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="CessAmount" class="form-label"></label>
                <input asp-for="CessAmount" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="CessAmount" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="OtherConnection" class="form-label"></label>
                <input asp-for="OtherConnection" class="form-control" />
                <span asp-validation-for="OtherConnection" class="text-danger"></span>
            </div>
        </div>

        <div class="wb-form-section-head">
            <h2 class="wb-section-title mb-1">Estimate & Admin Notes</h2>
        </div>

        <div class="wb-form-grid wb-form-grid-2">
            <div class="wb-form-field">
                <label asp-for="RegistrationNo" class="form-label"></label>
                <input asp-for="RegistrationNo" class="form-control" />
                <span asp-validation-for="RegistrationNo" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="EstimateNo" class="form-label"></label>
                <input asp-for="EstimateNo" class="form-control" />
                <span asp-validation-for="EstimateNo" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="EstimateAmount" class="form-label"></label>
                <input asp-for="EstimateAmount" class="form-control" type="number" min="0" />
                <span asp-validation-for="EstimateAmount" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="SecurityAmount" class="form-label"></label>
                <input asp-for="SecurityAmount" class="form-control" type="number" min="0" />
                <span asp-validation-for="SecurityAmount" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="EstimateDate" class="form-label"></label>
                <input asp-for="EstimateDate" class="form-control" type="date" />
                <span asp-validation-for="EstimateDate" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="IssueOfficer" class="form-label"></label>
                <input asp-for="IssueOfficer" class="form-control" />
                <span asp-validation-for="IssueOfficer" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="PlotMapId" class="form-label"></label>
                <input asp-for="PlotMapId" class="form-control" />
                <span asp-validation-for="PlotMapId" class="text-danger"></span>
            </div>
            <div class="wb-form-field">
                <label asp-for="KiloLiter" class="form-label"></label>
                <input asp-for="KiloLiter" class="form-control" />
                <span asp-validation-for="KiloLiter" class="text-danger"></span>
            </div>
            <div class="wb-form-field" style="grid-column: 1 / -1;">
                <label asp-for="Narration" class="form-label"></label>
                <textarea asp-for="Narration" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Narration" class="text-danger"></span>
            </div>
        </div>

        <div class="wb-form-actions">
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-consumerNo="@Model.ConsumerNo">Cancel</a>
            <button class="btn btn-primary" type="submit">Save Consumer</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
