@model IReadOnlyList<Water.Bill.Application.DTOs.Communication.CommunicationChannelSettingsDto>
@using Water.Bill.Application.DTOs.Communication
@{
    ViewData["Title"] = "Integration Hub";
}

<div class="wb-page-head">
    <div>
        <h1>Integration Hub</h1>
        <p>Manage Email, SMS/Text Message, and WhatsApp configuration from the portal. Database values override appsettings when available.</p>
    </div>
</div>

<section class="wb-page-card">
    <div class="table-responsive">
        <table class="table align-middle wb-table mb-0">
            <thead>
                <tr>
                    <th style="width: 18%;">Channel</th>
                    <th style="width: 12%;">Status</th>
                    <th>Configuration Source</th>
                    <th style="width: 18%;">Last Updated By</th>
                    <th style="width: 18%;">Last Updated Date</th>
                    <th class="text-end" style="width: 14%;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var statusClass = item.IsEnabled ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle";
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.DisplayName</div>
                            <div class="text-muted small">@item.ChannelName</div>
                        </td>
                        <td>
                            <span class="badge rounded-pill @statusClass">@((item.IsEnabled ? "Enabled" : "Disabled"))</span>
                        </td>
                        <td>
                            @if (item.IsConfiguredInDb)
                            {
                                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle">Database</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle">App Settings fallback</span>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.LastUpdatedByName) ? "-" : item.LastUpdatedByName)</td>
                        <td>@(item.LastUpdatedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "-")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-channel="@item.ChannelName">Configure</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
