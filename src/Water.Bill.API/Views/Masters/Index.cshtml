@model Water.Bill.API.ViewModels.MasterListViewModel

<div class="wb-page-head">
    <div>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </div>
    <div class="wb-actions">
        <form asp-action="ExportExcel" asp-route-key="@Model.Key" method="get">
            <input type="hidden" id="masterExportSearch" name="search" value="@Model.Search" />
            <button class="btn btn-outline-success" type="submit" require-permission="@($"{Model.Module}.view")" data-no-loader>Download</button>
        </form>
        <a class="btn btn-primary" asp-action="Create" asp-route-key="@Model.Key">Add @Model.Title.Replace(" Master", "")</a>
    </div>
</div>

<section class="wb-page-card wb-admin-card">
    <div class="wb-admin-toolbar">
        <div>
            <h2 class="wb-section-title">@Model.Title</h2>
            <span>@Model.Rows.Count record@(Model.Rows.Count == 1 ? "" : "s")</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-nowrap wb-master-searchbar">
            <input id="masterSearch" class="form-control wb-search flex-grow-1" type="search" value="@Model.Search" placeholder="Search code, name, status" />
            <button type="button" class="btn btn-primary flex-shrink-0" onclick="applyMasterSearch()">Search</button>
        </div>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="wb-empty">No records found. Add the first record to make it available for dropdowns.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle wb-table wb-admin-table">
                <thead>
                    <tr>
                        @foreach (var column in Model.Columns)
                        {
                            if (Model.Key == "sectors" && column.Key == "OrderBy")
                            {
                                continue;
                            }
                            <th>@column.Label</th>
                        }
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var searchText = string.Join(" ", row.Values.Values.Where(x => !string.IsNullOrWhiteSpace(x))).ToLowerInvariant();
                        <tr class="master-row" data-search="@searchText">
                            @foreach (var column in Model.Columns)
                            {
                                if (Model.Key == "sectors" && column.Key == "OrderBy")
                                {
                                    continue;
                                }

                                if (column.Key == "Status")
                                {
                                    <td><span class="badge @(row.IsActive ? "text-bg-success" : "text-bg-secondary")">@(row.IsActive ? "Active" : "Inactive")</span></td>
                                }
                                else
                                {
                                    <td>@(row.Values.TryGetValue(column.Key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : "-")</td>
                                }
                            }
                            <td>
                                <div class="wb-row-actions justify-content-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-key="@Model.Key" asp-route-rowKey="@row.Key">View</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-key="@Model.Key" asp-route-rowKey="@row.Key">Edit</a>
                                    <form asp-action="ToggleStatus" asp-route-key="@Model.Key" asp-route-rowKey="@row.Key" method="post" onsubmit="return confirm('@(row.IsActive ? "Delete" : "Activate") this record?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Status" value="@(row.IsActive ? "0" : "1")" />
                                        <button type="submit" class="btn btn-sm @(row.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(row.IsActive ? "Delete" : "Activate")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @await Html.PartialAsync("_Pagination", ViewBag.Pagination as Water.Bill.API.Models.PaginationViewModel)
</section>

<style>
    .wb-master-searchbar {
        width: min(100%, 420px);
        margin-left: auto;
    }

    .wb-master-searchbar .wb-search {
        min-width: 0;
    }
</style>

@section Scripts {
<script>
function filterMasters() {
    var q = (document.getElementById('masterSearch').value || '').toLowerCase();
    document.querySelectorAll('.master-row').forEach(function(row) {
        row.style.display = row.dataset.search.includes(q) ? '' : 'none';
    });
}

function applyMasterSearch() {
    syncMasterExportSearch();
    filterMasters();
}

function syncMasterExportSearch() {
    var source = document.getElementById('masterSearch');
    var target = document.getElementById('masterExportSearch');
    if (source && target) {
        target.value = source.value || '';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    syncMasterExportSearch();
    filterMasters();

    var searchInput = document.getElementById('masterSearch');
    if (searchInput) {
        searchInput.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                applyMasterSearch();
            }
        });
    }
});
</script>
}
