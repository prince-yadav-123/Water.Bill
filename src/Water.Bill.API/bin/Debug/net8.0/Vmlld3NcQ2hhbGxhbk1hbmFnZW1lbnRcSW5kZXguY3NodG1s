@model Water.Bill.API.Models.Challans.ChallanManagementIndexViewModel
@using Water.Bill.API.Models.Challans
@using Water.Bill.Core.Common
@{
    string DateText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy") : "-";
    string Amount(double value) => value.ToString("N2");
    string PurposeText(string? value) => value switch
    {
        "NDC" => ChallanPurposes.Display(ChallanPurposes.NdcNoDuesFee),
        "NEWCONN" => ChallanPurposes.Display(ChallanPurposes.NewConnectionFee),
        "OTHER" => ChallanPurposes.Display(ChallanPurposes.OtherServiceCharge),
        _ => ChallanPurposes.Display(ChallanPurposes.ExistingBillDue)
    };
    string Badge(string status) => status switch
    {
        "Paid" => "text-bg-success",
        "Cancelled" => "text-bg-danger",
        _ => "text-bg-warning"
    };
}

<div class="wb-page-head">
    <div>
        <h1>Challan Management</h1>
        <p>View, filter, print, cancel, and track generated old-compatible challan records.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Generate Challan</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success wb-alert">@success</div>
}

<section class="wb-page-card wb-admin-card">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <h2 class="wb-section-title mb-1">Generated Challans</h2>
            <p class="text-muted mb-0">Latest generated challans are shown first.</p>
        </div>
    </div>

    <form method="get" class="wb-filter-bar wb-bill-filter-bar">
        <div class="wb-filter-field">
            <label class="form-label">Search</label>
            <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Challan / Consumer / Name / Mobile" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Status</label>
            <select class="form-select" name="status">
                <option value="">All Status</option>
                @if (Model.Status == "PendingPayment")
                {
                    <option value="PendingPayment" selected>Pending Payment</option>
                }
                else
                {
                    <option value="PendingPayment">Pending Payment</option>
                }
                @if (Model.Status == "Paid")
                {
                    <option value="Paid" selected>Paid</option>
                }
                else
                {
                    <option value="Paid">Paid</option>
                }
                @if (Model.Status == "Cancelled")
                {
                    <option value="Cancelled" selected>Cancelled</option>
                }
                else
                {
                    <option value="Cancelled">Cancelled</option>
                }
            </select>
        </div>
        <div class="wb-filter-field">
            <label class="form-label">From Date</label>
            <input class="form-control" type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">To Date</label>
            <input class="form-control" type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="wb-filter-actions">
            <button class="btn btn-primary" type="submit">Filter</button>
        </div>
    </form>

    @if (Model.Challans.Count == 0)
    {
        <div class="wb-empty">No challans found.</div>
    }
    else
    {
        <div class="table-responsive wb-approval-table-wrap mt-3">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Challan No</th>
                        <th>Consumer</th>
                        <th>Property</th>
                        <th>Purpose</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Generated On</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Challans)
                {
                    <tr>
                        <td><strong>@(row.ChallanNo ?? "-")</strong></td>
                        <td>
                            <div class="fw-semibold">@row.ConsumerNo</div>
                            <small class="text-muted">@((row.ConsumerName ?? "-")) - @(row.MobileNo ?? "-")</small>
                        </td>
                        <td>@(row.PropertyNo ?? "-")</td>
                        <td>@PurposeText(row.Purpose)</td>
                        <td>@Amount(row.Amount)</td>
                        <td><span class="badge @Badge(row.Status)">@row.Status</span></td>
                        <td>@DateText(row.GeneratedOn)</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@row.Id">View</a>
                                @if (row.Status != "Cancelled")
                                {
                                    <a class="btn btn-outline-secondary" asp-action="Print" asp-route-id="@row.Id" target="_blank">Print</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    @await Html.PartialAsync("_Pagination", ViewBag.Pagination as Water.Bill.API.Models.PaginationViewModel)
</section>
