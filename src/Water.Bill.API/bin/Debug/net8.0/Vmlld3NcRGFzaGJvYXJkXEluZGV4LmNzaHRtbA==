    <script>
        (function () {
            function formatCompactCurrency(value) {
                var abs = Math.abs(value);
                if (abs >= 10000000) return '₹' + (value / 10000000).toFixed(2) + ' Cr';
                return '₹' + (value / 100000).toFixed(2) + ' Lakh';
            }

            function initChart(canvasId, data) {
                var el = document.getElementById(canvasId);
                if (!el || !data) return;
                new Chart(el, {
                    type: data.chartType || 'doughnut',
                    data: {
                        labels: data.labels,
                        datasets: [{
                            data: data.values,
                            backgroundColor: data.colors,
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        cutout: data.cutout || '70%',
                        rotation: data.rotation,
                        circumference: data.circumference,
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        var total = ctx.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                        var pct = total > 0 ? Math.round((ctx.parsed / total) * 1000) / 10 : 0;
                                        if (data.type === 'amount') {
                                            return ' ' + ctx.label + ': ' + formatCompactCurrency(ctx.parsed) + ' (' + pct + '%)';
                                        }
                                        return ' ' + ctx.label + ': ' + ctx.parsed + ' (' + pct + '%)';
                                    }
                                }
                            }
                        },
                        animation: { duration: 600, easing: 'easeInOutQuart' }
                    }
                });
            }
            document.addEventListener('DOMContentLoaded', function () {
                initChart('appStatusChart', window._appStatusData);
                initChart('challanStatusChart', window._challanStatusData);
                initChart('paymentCollectionChart', window._paymentCollectionData);
                initChart('defaulterChart', window._defaulterData);
            });
        })();
    </script>
