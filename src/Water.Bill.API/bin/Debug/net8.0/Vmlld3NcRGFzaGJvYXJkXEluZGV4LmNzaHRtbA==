@model Water.Bill.API.Models.Dashboard.DashboardIndexViewModel
@using Water.Bill.API.Models.Dashboard

@functions {
    private static string ToneClass(string tone) => tone switch
    {
        "success"   => "wb-badge-success",
        "warning"   => "wb-badge-warning",
        "danger"    => "wb-badge-danger",
        "info"      => "wb-badge-info",
        "secondary" => "wb-badge-secondary",
        _ => "wb-badge-primary"
    };

    private static string ToneIcon(string tone) => tone switch
    {
        "success" => "wb-icon-success",
        "warning" => "wb-icon-warning",
        "danger"  => "wb-icon-danger",
        "info"    => "wb-icon-info",
        _ => "wb-icon-primary"
    };

    private static string StatusTone(string? status) => status switch
    {
        "Approved" or "Resolved" or "Paid" or "FinalConsumerCreated" => "success",
        "Pending" or "PendingPayment" or "UnderReview" or "InProgress" => "warning",
        "Rejected" or "Failed" or "Closed" => "danger",
        _ => "secondary"
    };

    private static string AgeBadgeTone(int days) => days switch
    {
        > 7 => "danger",
        > 3 => "warning",
        _ => "secondary"
    };

    private static string AuditTone(bool? success) => success == false ? "danger" : success == true ? "success" : "secondary";
    private static string AuditLabel(bool? success) => success == false ? "Failed" : success == true ? "OK" : "Logged";

    private static string FormatDate(DateTime? value) => value?.ToString("dd MMM yy, hh:mm tt") ?? "-";
    private static string ShortDate(DateTime? value) => value?.ToString("dd MMM yy") ?? "-";
    private static string FormatCurrency(decimal value) => $"Rs. {value:N0}";
    private static string FormatCompactCurrency(decimal value)
    {
        var abs = Math.Abs(value);
        if (abs >= 10000000m)
            return $"₹{value / 10000000m:N2} Cr";
        return $"₹{value / 100000m:N2} Lakh";
    }
}

<div class="d-flex flex-column gap-4 wb-dashboard">

    @* â•â•â• HERO â•â•â• *@
    <section class="wb-page-card wb-admin-card wb-hero">
        <div class="d-flex flex-column flex-xl-row justify-content-between gap-3">
            <div>
                <span class="wb-hero-eyebrow">Authority Services</span>
                <h1 class="wb-hero-title mb-1">Welcome back, @Model.UserName</h1>
                <p class="wb-hero-sub mb-0">
                    @if (Model.IsAdminView)
                    {
                        <span>Live operating picture across consumers, workflow, payments and service desk.</span>
                    }
                    else
                    {
                        <span>Your current queue, recent actions and the work that needs your attention today.</span>
                    }
                </p>
            </div>
            <div class="wb-hero-meta">
                <span class="wb-hero-role">@Model.RoleName</span>
                <span class="wb-hero-date">@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
            </div>
        </div>
    </section>

    @* â•â•â• STAT CARDS â•â•â• *@
    <div class="row g-3">
        @foreach (var card in Model.SummaryCards)
        {
            <div class="col-6 col-lg-4 col-xxl-3">
                @if (!string.IsNullOrWhiteSpace(card.Url))
                {
                    <a class="text-decoration-none d-block h-100" href="@card.Url">
                        <div class="wb-kpi h-100">
                            @if (!string.IsNullOrWhiteSpace(card.Icon))
                            {
                                <span class="wb-kpi-icon @ToneIcon(card.Tone)"><i class="bi @card.Icon"></i></span>
                            }
                            <div class="wb-kpi-mid">
                                <span class="wb-kpi-label">@card.Label</span>
                                <strong class="wb-kpi-value">@card.Value</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(card.Icon))
                            {
                                <i class="bi @card.Icon wb-kpi-ghost"></i>
                            }
                        </div>
                    </a>
                }
                else
                {
                    <div class="wb-kpi h-100">
                        @if (!string.IsNullOrWhiteSpace(card.Icon))
                        {
                            <span class="wb-kpi-icon @ToneIcon(card.Tone)"><i class="bi @card.Icon"></i></span>
                        }
                        <div class="wb-kpi-mid">
                            <span class="wb-kpi-label">@card.Label</span>
                            <strong class="wb-kpi-value">@card.Value</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(card.Icon))
                        {
                            <i class="bi @card.Icon wb-kpi-ghost"></i>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
    @* ADMIN DASHBOARD                          *@
    @* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
    @if (Model.IsAdminView)
    {
        @* â”€â”€ Row 1: App Status | Challan Status | Service Desk â”€â”€ *@
        <div class="row g-3">
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100 d-flex flex-column">
                    <div class="wb-section-hdr">
                        <div><h2>@Model.PrimaryStatusChart?.Title</h2><p>@Model.PrimaryStatusChart?.Caption</p></div>
                    </div>
                    @if (Model.PrimaryStatusChart is { Items.Count: > 0 } pc)
                    {
                        var t = pc.Items.Sum(x => x.Count);
                        var pcLabels  = "[" + string.Join(",", pc.Items.Select(x => $"\"{x.Label}\"")) + "]";
                        var pcValues  = "[" + string.Join(",", pc.Items.Select(x => x.Count)) + "]";
                        var pcColors  = "[" + string.Join(",", pc.Items.Select(x => $"\"{x.Color}\"")) + "]";
                        <div class="wb-donut-wrap flex-grow-1">
                            <div class="wb-donut-inner">
                                <div class="wb-chart-wrap">
                                    <canvas id="appStatusChart"></canvas>
                                    <div class="wb-chart-center">
                                        <strong>@t</strong>
                                        <span>Applications</span>
                                    </div>
                                </div>
                                <div class="wb-donut-legend">
                                    @foreach (var s in pc.Items)
                                    {
                                        var pct = t == 0 ? 0 : Math.Round(s.Count * 100m / t, 1);
                                        <div class="wb-donut-row">
                                            <span class="wb-dot" style="background:@s.Color"></span>
                                            <div><div class="wb-donut-lbl">@s.Label</div><small class="text-muted">@s.Count &nbsp;(@pct%)</small></div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <script>window._appStatusData = { labels: @Html.Raw(pcLabels), values: @Html.Raw(pcValues), colors: @Html.Raw(pcColors), chartType: 'doughnut', cutout: '70%' };</script>
                    }
                    else { <div class="wb-empty">No application data yet.</div> }
                </section>
            </div>
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100 d-flex flex-column">
                    <div class="wb-section-hdr">
                        <div><h2>@Model.ChallanStatusChart?.Title</h2><p>@Model.ChallanStatusChart?.Caption</p></div>
                    </div>
                    @if (Model.ChallanStatusChart is { Items.Count: > 0 } cc)
                    {
                        var t = cc.Items.Sum(x => x.Count);
                        var ccLabels  = "[" + string.Join(",", cc.Items.Select(x => $"\"{x.Label}\"")) + "]";
                        var ccValues  = "[" + string.Join(",", cc.Items.Select(x => x.Count)) + "]";
                        var ccColors  = "[" + string.Join(",", cc.Items.Select(x => $"\"{x.Color}\"")) + "]";
                        <div class="wb-donut-wrap flex-grow-1">
                            <div class="wb-donut-inner">
                                <div class="wb-chart-wrap">
                                    <canvas id="challanStatusChart"></canvas>
                                    <div class="wb-chart-center">
                                        <strong>@t</strong>
                                    </div>
                                </div>
                                <div class="wb-donut-legend">
                                    @foreach (var s in cc.Items)
                                    {
                                        var pct = t == 0 ? 0 : Math.Round(s.Count * 100m / t, 1);
                                        <div class="wb-donut-row">
                                            <span class="wb-dot" style="background:@s.Color"></span>
                                            <div><div class="wb-donut-lbl">@s.Label</div><small class="text-muted">@s.Count &nbsp;(@pct%)</small></div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <script>window._challanStatusData = { labels: @Html.Raw(ccLabels), values: @Html.Raw(ccValues), colors: @Html.Raw(ccColors), chartType: 'doughnut', cutout: '70%' };</script>
                    }
                    else { <div class="wb-empty">No challan data yet.</div> }
                </section>
            </div>
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100" data-admin-widget="service-desk">
                    <div class="wb-section-hdr">
                        <div><h2>Query Status Snapshot</h2><p>Consumer support queue at a glance.</p></div>
                        <a class="btn btn-outline-primary btn-sm" href="/ConsumerQueryManagement">View All</a>
                    </div>
                    <div class="wb-dashboard-dynamic" data-admin-widget-target="service-desk" data-widget-state="idle"></div>
                </section>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100 d-flex flex-column" data-admin-widget="division">
                    <div class="wb-section-hdr">
                        <div><h2>Division-wise Consumers</h2><p>Consumer count and percentage share by division.</p></div>
                    </div>
                    <div class="wb-dashboard-dynamic" data-admin-widget-target="division" data-widget-state="idle"></div>
                </section>
            </div>
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100 d-flex flex-column" data-admin-widget="payment">
                    <div class="wb-section-hdr">
                        <div><h2>Payment Collection (Offline/Online)</h2><p>Online and offline collection share based on received amount.</p></div>
                    </div>
                    <div class="wb-dashboard-dynamic" data-admin-widget-target="payment" data-widget-state="idle"></div>
                </section>
            </div>
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100 d-flex flex-column" data-admin-widget="defaulter">
                    <div class="wb-section-hdr">
                        <div><h2>Defaulters</h2><p>Outstanding dues above the configured threshold.</p></div>
                    </div>
                    <div class="wb-dashboard-dynamic" data-admin-widget-target="defaulter" data-widget-state="idle"></div>
                </section>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-xl-6">
                <section class="wb-card h-100" data-admin-widget="workload">
                    <div class="wb-section-hdr">
                        <div><h2>Pending Workload by User Role</h2><p>Current active workflow queue grouped by role.</p></div>
                        <a class="btn btn-outline-primary btn-sm" href="/Approvals?tab=Pending">View Queue</a>
                    </div>
                    <div class="wb-dashboard-dynamic" data-admin-widget-target="workload" data-widget-state="idle"></div>
                </section>
            </div>
            <div class="col-12 col-xl-6">
                <section class="wb-card h-100" data-admin-widget="trend">
                    <div class="wb-section-hdr">
                        <div><h2>New Applications Received vs Approved</h2><p>Month-wise comparison for the last 6 months.</p></div>
                    </div>
                    <div class="wb-dashboard-dynamic" data-admin-widget-target="trend" data-widget-state="idle"></div>
                </section>
            </div>
        </div>

        <section class="wb-card">
            <div class="wb-section-hdr wb-section-hdr-stacked">
                <div>
                    <h2>Recent Operations</h2>
                    <p>Quickly switch between latest applications, activity, queries, challans, and approval queue items.</p>
                </div>
                <div class="wb-dashboard-tabs" role="tablist" aria-label="Recent dashboard sections">
                    <button class="wb-dashboard-tab is-active" type="button" role="tab" aria-selected="true" data-dashboard-tab="recent-applications">Recent Applications</button>
                    <button class="wb-dashboard-tab" type="button" role="tab" aria-selected="false" data-dashboard-tab="recent-activity">Recent Activity</button>
                    <button class="wb-dashboard-tab" type="button" role="tab" aria-selected="false" data-dashboard-tab="recent-queries">Recent Queries</button>
                    <button class="wb-dashboard-tab" type="button" role="tab" aria-selected="false" data-dashboard-tab="recent-challans">Recent Challans</button>
                    <button class="wb-dashboard-tab" type="button" role="tab" aria-selected="false" data-dashboard-tab="current-approval-queue">Current Approval Queue</button>
                </div>
            </div>

            <div class="wb-dashboard-tab-panels">
                <div class="wb-dashboard-tab-panel is-active" role="tabpanel" data-dashboard-panel="recent-applications" data-loaded="true" data-endpoint="/Dashboard/RecentApplications">
                    <div class="wb-section-hdr">
                        <div><h2>Recent Applications</h2><p>Latest incoming requests across core public and service workflows.</p></div>
                        <a class="btn btn-outline-primary btn-sm" href="/Approvals?tab=All">View All</a>
                    </div>
                    <div class="table-responsive" data-dashboard-content="recent-applications">
                        <table class="table wb-table align-middle mb-0">
                            <thead><tr><th>Type</th><th>Application No</th><th>Applicant</th><th>Status</th><th>Received</th></tr></thead>
                            <tbody>
                                @{ var apps = Model.RecentApplications.Take(8).ToList(); }
                                @if (!apps.Any())
                                {
                                    <tr><td colspan="5" class="wb-empty-row">No recent applications found.</td></tr>
                                }
                                else
                                {
                                    @foreach (var r in apps)
                                    {
                                        <tr>
                                            <td><span class="wb-type-badge">@r.Type</span></td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(r.Url))
                                                { <a class="wb-link" href="@r.Url">@r.ApplicationNo</a> }
                                                else
                                                { <span>@r.ApplicationNo</span> }
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@r.ApplicantName</div>
                                                <small class="text-muted">@r.Property</small>
                                            </td>
                                            <td><span class="badge @ToneClass(StatusTone(r.Status))">@r.Status</span></td>
                                            <td>@FormatDate(r.CreatedOn)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="wb-dashboard-tab-panel" role="tabpanel" data-dashboard-panel="recent-activity" data-loaded="false" data-endpoint="/Dashboard/RecentActivity" hidden>
                    <div class="wb-section-hdr">
                        <div><h2>Recent Activity</h2><p>Latest authority-side actions captured through the audit trail.</p></div>
                        <a class="btn btn-outline-primary btn-sm" asp-controller="OperatorAudit" asp-action="Index">View All</a>
                    </div>
                    <div class="wb-dashboard-dynamic" data-dashboard-content="recent-activity">
                        <div class="wb-dashboard-loading">Loading recent activity...</div>
                    </div>
                </div>

                <div class="wb-dashboard-tab-panel" role="tabpanel" data-dashboard-panel="recent-queries" data-loaded="false" data-endpoint="/Dashboard/RecentQueries" hidden>
                    <div class="wb-section-hdr">
                        <div><h2>Recent Queries</h2><p>Most recently raised consumer support queries.</p></div>
                        <a class="btn btn-outline-primary btn-sm" href="/ConsumerQueryManagement">View All</a>
                    </div>
                    <div class="wb-dashboard-dynamic" data-dashboard-content="recent-queries">
                        <div class="wb-dashboard-loading">Loading recent queries...</div>
                    </div>
                </div>

                <div class="wb-dashboard-tab-panel" role="tabpanel" data-dashboard-panel="recent-challans" data-loaded="false" data-endpoint="/Dashboard/RecentChallans" hidden>
                    <div class="wb-section-hdr">
                        <div><h2>Recent Challans</h2><p>Latest demand records and payment requests.</p></div>
                        <a class="btn btn-outline-primary btn-sm" href="/ChallanManagement">View All</a>
                    </div>
                    <div class="wb-dashboard-dynamic" data-dashboard-content="recent-challans">
                        <div class="wb-dashboard-loading">Loading recent challans...</div>
                    </div>
                </div>

                <div class="wb-dashboard-tab-panel" role="tabpanel" data-dashboard-panel="current-approval-queue" data-loaded="false" data-endpoint="/Dashboard/CurrentApprovalQueue" hidden>
                    <div class="wb-section-hdr">
                        <div><h2>Current Approval Queue</h2><p>Tasks waiting at the active workflow stage.</p></div>
                        <a class="btn btn-outline-primary btn-sm" href="/Approvals?tab=Pending">View All</a>
                    </div>
                    <div class="wb-dashboard-dynamic" data-dashboard-content="current-approval-queue">
                        <div class="wb-dashboard-loading">Loading current approval queue...</div>
                    </div>
                </div>
            </div>
        </section>
    }

    @* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
    @* STAFF DASHBOARD                          *@
    @* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
    else
    {
        @* â”€â”€ Row 1: My Pending Work by Type (50%) + My Challans (50%) â”€â”€ *@
        <div class="row g-3">
            <div class="col-12 col-xl-6">
                @if (Model.SecondaryBarChart is { Items.Count: > 0 } staffChart)
                {
                    <section class="wb-card h-100">
                        <div class="wb-section-hdr">
                            <div><h2>@staffChart.Title</h2><p>@staffChart.Caption</p></div>
                            <a class="btn btn-outline-primary btn-sm" href="/Approvals?tab=Pending">View Queue</a>
                        </div>
                        @{ var sMax = Math.Max(1, staffChart.Items.Max(x => x.Value)); }
                        <div class="wb-dept-grid">
                            @foreach (var item in staffChart.Items)
                            {
                                <a class="wb-bar-row text-decoration-none" href="@(item.Url ?? "#")">
                                    <div class="wb-bar-copy"><span>@item.Label</span><strong>@item.Value</strong></div>
                                    <div class="wb-bar-track"><div class="wb-bar-fill" style="width:@(item.Value * 100m / sMax)%;background:@item.Color"></div></div>
                                </a>
                            }
                        </div>
                    </section>
                }
                else
                {
                    <section class="wb-card h-100">
                        <div class="wb-section-hdr">
                            <div><h2>My Pending Work by Type</h2><p>Only items currently assigned to you.</p></div>
                            <a class="btn btn-outline-primary btn-sm" href="/Approvals?tab=Pending">View Queue</a>
                        </div>
                        <div class="wb-empty">No pending workflow items are assigned to you right now.</div>
                    </section>
                }
            </div>
            <div class="col-12 col-xl-6">
                <section class="wb-card h-100">
                    <div class="wb-section-hdr">
                        <div><h2>My Challans</h2><p>Recent challans created or posted under your account.</p></div>
                        <a class="btn btn-outline-primary btn-sm" href="/ChallanManagement">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table wb-table align-middle mb-0">
                            <thead><tr><th>Challan</th><th>Consumer</th><th>Amount</th><th>Status</th></tr></thead>
                            <tbody>
                                @{ var myChallans = Model.RecentChallans.Take(8).ToList(); }
                                @if (!myChallans.Any())
                                {
                                    <tr><td colspan="4" class="wb-empty-row">No challans posted by you yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var c in myChallans)
                                    {
                                        <tr>
                                            <td><a class="wb-link" href="@c.Url">@c.ChallanNo</a></td>
                                            <td>@c.ConsumerNo</td>
                                            <td>Rs.&nbsp;@c.Amount.ToString("N0")</td>
                                            <td><span class="badge @ToneClass(StatusTone(c.Status))">@c.Status</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>

        @* â”€â”€ Row 2: Assigned Review Queue (full width) â”€â”€ *@
        <section class="wb-card">
            <div class="wb-section-hdr">
                <div><h2>Assigned Review Queue</h2><p>Tasks matched to your user, role, or department assignment.</p></div>
                <a class="btn btn-outline-primary btn-sm" href="/Approvals?tab=Pending">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table wb-table align-middle mb-0">
                    <thead><tr><th>Type</th><th>Application</th><th>Stage</th><th>Waiting</th></tr></thead>
                    <tbody>
                        @{ var myQueue = Model.PendingApprovals.Take(8).ToList(); }
                        @if (!myQueue.Any())
                        {
                            <tr><td colspan="4" class="wb-empty-row">Nothing is assigned to you right now.</td></tr>
                        }
                        else
                        {
                            @foreach (var r in myQueue)
                            {
                                <tr>
                                    <td><span class="wb-type-badge">@r.ApplicationType</span></td>
                                    <td>
                                        <a class="wb-link" href="@r.Url">@r.ApplicationNo</a>
                                        <div><small class="text-muted">@r.ApplicantName</small></div>
                                    </td>
                                    <td>@r.StageName</td>
                                    <td>
                                        <span class="badge @ToneClass(AgeBadgeTone(r.DaysSinceAssigned))">
                                            @(r.DaysSinceAssigned == 0 ? "Today" : $"{r.DaysSinceAssigned}d")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @* â”€â”€ Row 3: Assigned Queries (50%) + Recent Activity (50%) â”€â”€ *@
        <div class="row g-3">
            <div class="col-12 col-xl-6">
                <section class="wb-card h-100">
                    <div class="wb-section-hdr">
                        <div><h2>Assigned Queries</h2><p>Support queries currently assigned to you.</p></div>
                        <a class="btn btn-outline-primary btn-sm" href="/ConsumerQueryManagement">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table wb-table align-middle mb-0">
                            <thead><tr><th>Query No</th><th>Consumer</th><th>Status</th></tr></thead>
                            <tbody>
                                @{ var myDesk = Model.RecentServiceDeskItems.Take(8).ToList(); }
                                @if (!myDesk.Any())
                                {
                                    <tr><td colspan="3" class="wb-empty-row">No queries assigned to you.</td></tr>
                                }
                                else
                                {
                                    @foreach (var q in myDesk)
                                    {
                                        <tr>
                                            <td><a class="wb-link" href="@q.Url">@q.ReferenceNo</a></td>
                                            <td>
                                                <div>@q.ConsumerName</div>
                                                <small class="text-muted">@q.Subject</small>
                                            </td>
                                            <td><span class="badge @ToneClass(StatusTone(q.Status))">@q.Status</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
            <div class="col-12 col-xl-6">
                <section class="wb-card h-100">
                    <div class="wb-section-hdr">
                        <div><h2>Recent Activity</h2><p>Your recent actions captured in the audit trail.</p></div>
                        <a class="btn btn-outline-primary btn-sm" asp-controller="OperatorAudit" asp-action="Index">Open Logs</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table wb-table align-middle mb-0">
                            <thead><tr><th>Action</th><th>Module</th><th>Status</th><th>Time</th></tr></thead>
                            <tbody>
                                @{ var myActs = Model.RecentActivities.Take(8).ToList(); }
                                @if (!myActs.Any())
                                {
                                    <tr><td colspan="4" class="wb-empty-row">No recent activity logged yet.</td></tr>
                                }
                                else
                                {
                                    @foreach (var a in myActs)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@a.Action</div>
                                                <small class="text-muted">@a.Details</small>
                                            </td>
                                            <td>@a.Module</td>
                                            <td>
                                                <span class=”badge @ToneClass(AuditTone(a.Success))”>
                                                    @AuditLabel(a.Success)
                                                </span>
                                            </td>
                                            <td>@ShortDate(a.OccurredOn)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    }

</div>

