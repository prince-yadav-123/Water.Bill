@model Water.Bill.API.Models.Dashboard.DashboardIndexViewModel
@using Water.Bill.API.Models.Dashboard

@functions {
    private static string ToneClass(string tone) => tone switch
    {
        "success"   => "wb-badge-success",
        "warning"   => "wb-badge-warning",
        "danger"    => "wb-badge-danger",
        "info"      => "wb-badge-info",
        "secondary" => "wb-badge-secondary",
        _ => "wb-badge-primary"
    };

    private static string ToneIcon(string tone) => tone switch
    {
        "success" => "wb-icon-success",
        "warning" => "wb-icon-warning",
        "danger"  => "wb-icon-danger",
        "info"    => "wb-icon-info",
        _ => "wb-icon-primary"
    };

    private static string StatusTone(string? status) => status switch
    {
        "Approved" or "Resolved" or "Paid" or "FinalConsumerCreated" => "success",
        "Pending" or "PendingPayment" or "UnderReview" or "InProgress" => "warning",
        "Rejected" or "Failed" or "Closed" => "danger",
        _ => "secondary"
    };

    private static string AgeBadgeTone(int days) => days switch
    {
        > 7 => "danger",
        > 3 => "warning",
        _ => "secondary"
    };

    private static string AuditTone(bool? success) => success == false ? "danger" : success == true ? "success" : "secondary";
    private static string AuditLabel(bool? success) => success == false ? "Failed" : success == true ? "OK" : "Logged";

    private static string FormatDate(DateTime? value) => value?.ToString("dd MMM yy, hh:mm tt") ?? "-";
    private static string ShortDate(DateTime? value) => value?.ToString("dd MMM yy") ?? "-";
    private static string FormatCurrency(decimal value) => $"Rs. {value:N0}";
    private static string FormatCompactCurrency(decimal value)
    {
        var abs = Math.Abs(value);
        if (abs >= 10000000m)
            return $"₹{value / 10000000m:N2} Cr";
        return $"₹{value / 100000m:N2} Lakh";
    }
}

<div class="d-flex flex-column gap-4 wb-dashboard">

    @* â•â•â• HERO â•â•â• *@
    <section class="wb-page-card wb-admin-card wb-hero">
        <div class="d-flex flex-column flex-xl-row justify-content-between gap-3">
            <div>
                <span class="wb-hero-eyebrow">Authority Services</span>
                <h1 class="wb-hero-title mb-1">Welcome back, @Model.UserName</h1>
                <p class="wb-hero-sub mb-0">
                    @if (Model.IsAdminView)
                    {
                        <span>Live operating picture across consumers, workflow, payments and service desk.</span>
                    }
                    else
                    {
                        <span>Your current queue, recent actions and the work that needs your attention today.</span>
                    }
                </p>
            </div>
            <div class="wb-hero-meta">
                <span class="wb-hero-role">@Model.RoleName</span>
                <span class="wb-hero-date">@DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
            </div>
        </div>
    </section>

    @* â•â•â• STAT CARDS â•â•â• *@
    <div class="row g-3">
        @foreach (var card in Model.SummaryCards)
        {
            <div class="col-6 col-lg-4 col-xxl-3">
                @if (!string.IsNullOrWhiteSpace(card.Url))
                {
                    <a class="text-decoration-none d-block h-100" href="@card.Url">
                        <div class="wb-kpi h-100">
                            @if (!string.IsNullOrWhiteSpace(card.Icon))
                            {
                                <span class="wb-kpi-icon @ToneIcon(card.Tone)"><i class="bi @card.Icon"></i></span>
                            }
                            <div class="wb-kpi-mid">
                                <span class="wb-kpi-label">@card.Label</span>
                                <strong class="wb-kpi-value">@card.Value</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(card.Icon))
                            {
                                <i class="bi @card.Icon wb-kpi-ghost"></i>
                            }
                        </div>
                    </a>
                }
                else
                {
                    <div class="wb-kpi h-100">
                        @if (!string.IsNullOrWhiteSpace(card.Icon))
                        {
                            <span class="wb-kpi-icon @ToneIcon(card.Tone)"><i class="bi @card.Icon"></i></span>
                        }
                        <div class="wb-kpi-mid">
                            <span class="wb-kpi-label">@card.Label</span>
                            <strong class="wb-kpi-value">@card.Value</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(card.Icon))
                        {
                            <i class="bi @card.Icon wb-kpi-ghost"></i>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
    @* ADMIN DASHBOARD                          *@
    @* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• *@
    @if (Model.IsAdminView)
    {
        @* â”€â”€ Row 1: App Status | Challan Status | Service Desk â”€â”€ *@
        <div class="row g-3">
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100 d-flex flex-column">
                    <div class="wb-section-hdr">
                        <div><h2>@Model.PrimaryStatusChart?.Title</h2><p>@Model.PrimaryStatusChart?.Caption</p></div>
                    </div>
                    @if (Model.PrimaryStatusChart is { Items.Count: > 0 } pc)
                    {
                        var t = pc.Items.Sum(x => x.Count);
                        var pcLabels  = "[" + string.Join(",", pc.Items.Select(x => $"\"{x.Label}\"")) + "]";
                        var pcValues  = "[" + string.Join(",", pc.Items.Select(x => x.Count)) + "]";
                        var pcColors  = "[" + string.Join(",", pc.Items.Select(x => $"\"{x.Color}\"")) + "]";
                        <div class="wb-donut-wrap flex-grow-1">
                            <div class="wb-donut-inner">
                                <div class="wb-chart-wrap">
                                    <canvas id="appStatusChart"></canvas>
                                    <div class="wb-chart-center">
                                        <strong>@t</strong>
                                        <span>Applications</span>
                                    </div>
                                </div>
                                <div class="wb-donut-legend">
                                    @foreach (var s in pc.Items)
                                    {
                                        var pct = t == 0 ? 0 : Math.Round(s.Count * 100m / t, 1);
                                        <div class="wb-donut-row">
                                            <span class="wb-dot" style="background:@s.Color"></span>
                                            <div><div class="wb-donut-lbl">@s.Label</div><small class="text-muted">@s.Count &nbsp;(@pct%)</small></div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <script>window._appStatusData = { labels: @Html.Raw(pcLabels), values: @Html.Raw(pcValues), colors: @Html.Raw(pcColors), chartType: 'doughnut', cutout: '70%' };</script>
                    }
                    else { <div class="wb-empty">No application data yet.</div> }
                </section>
            </div>
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100 d-flex flex-column">
                    <div class="wb-section-hdr">
                        <div><h2>@Model.ChallanStatusChart?.Title</h2><p>@Model.ChallanStatusChart?.Caption</p></div>
                    </div>
                    @if (Model.ChallanStatusChart is { Items.Count: > 0 } cc)
                    {
                        var t = cc.Items.Sum(x => x.Count);
                        var ccLabels  = "[" + string.Join(",", cc.Items.Select(x => $"\"{x.Label}\"")) + "]";
                        var ccValues  = "[" + string.Join(",", cc.Items.Select(x => x.Count)) + "]";
                        var ccColors  = "[" + string.Join(",", cc.Items.Select(x => $"\"{x.Color}\"")) + "]";
                        <div class="wb-donut-wrap flex-grow-1">
                            <div class="wb-donut-inner">
                                <div class="wb-chart-wrap">
                                    <canvas id="challanStatusChart"></canvas>
                                    <div class="wb-chart-center">
                                        <strong>@t</strong>
                                    </div>
                                </div>
                                <div class="wb-donut-legend">
                                    @foreach (var s in cc.Items)
                                    {
                                        var pct = t == 0 ? 0 : Math.Round(s.Count * 100m / t, 1);
                                        <div class="wb-donut-row">
                                            <span class="wb-dot" style="background:@s.Color"></span>
                                            <div><div class="wb-donut-lbl">@s.Label</div><small class="text-muted">@s.Count &nbsp;(@pct%)</small></div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <script>window._challanStatusData = { labels: @Html.Raw(ccLabels), values: @Html.Raw(ccValues), colors: @Html.Raw(ccColors), chartType: 'doughnut', cutout: '70%' };</script>
                    }
                    else { <div class="wb-empty">No challan data yet.</div> }
                </section>
            </div>
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100">
                    <div class="wb-section-hdr">
                        <div><h2>@Model.ServiceDeskPanel?.Title</h2><p>@Model.ServiceDeskPanel?.Caption</p></div>
                        <a class="btn btn-outline-primary btn-sm" href="/ConsumerQueryManagement">View All</a>
                    </div>
                    @if (Model.ServiceDeskPanel is { Groups.Count: > 0 } sdp)
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var grp in sdp.Groups)
                            {
                                @foreach (var item in grp.Items)
                                {
                                    <a class="wb-qrow wb-qrow-@item.Tone" href="@(item.Url ?? "#")">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="wb-qrow-accent"></span>
                                            <span class="wb-qrow-label">@item.Label</span>
                                        </div>
                                        <strong class="wb-qrow-count">@item.Value</strong>
                                    </a>
                                }
                            }
                        </div>
                    }
                    else { <div class="wb-empty">No query data yet.</div> }
                </section>
            </div>
        </div>

        @* â”€â”€ Row 1B: Division / Collection / Defaulters â”€â”€ *@
        <div class="row g-3">
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100 d-flex flex-column">
                    <div class="wb-section-hdr">
                        <div><h2>@Model.DivisionConsumerChart?.Title</h2><p>@Model.DivisionConsumerChart?.Caption</p></div>
                    </div>
                    @if (Model.DivisionConsumerChart is { Items.Count: > 0 } divisionChart)
                    {
                        var total = divisionChart.Items.Sum(x => x.Count);
                        var max = Math.Max(1, divisionChart.Items.Max(x => x.Count));
                        <div class="d-flex flex-column gap-3 flex-grow-1">
                            <div class="wb-mini-summary">
                                <strong>@total.ToString("N0")</strong>
                                <span>Total Consumers</span>
                            </div>
                            <div class="wb-dept-grid">
                                @foreach (var item in divisionChart.Items)
                                {
                                    <div class="wb-bar-row">
                                        <div class="wb-bar-copy">
                                            <span>@item.Label</span>
                                            <strong>@item.Percentage%</strong>
                                        </div>
                                        <div class="wb-bar-track">
                                            <div class="wb-bar-fill" style="width:@(item.Count * 100m / max)%;background:@item.Color"></div>
                                        </div>
                                        <div class="wb-bar-meta">@item.Count.ToString("N0") consumers</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else { <div class="wb-empty">No consumer division data available.</div> }
                </section>
            </div>
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100 d-flex flex-column">
                    <div class="wb-section-hdr">
                        <div><h2>@Model.PaymentCollectionChart?.Title</h2><p>@Model.PaymentCollectionChart?.Caption</p></div>
                    </div>
                    @if (Model.PaymentCollectionChart is { Items.Count: > 0 } paymentChart)
                    {
                        var total = paymentChart.Items.Sum(x => x.Amount);
                        var labels = "[" + string.Join(",", paymentChart.Items.Select(x => $"\"{x.Label}\"")) + "]";
                        var values = "[" + string.Join(",", paymentChart.Items.Select(x => x.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture))) + "]";
                        var colors = "[" + string.Join(",", paymentChart.Items.Select(x => $"\"{x.Color}\"")) + "]";
                        <div class="d-flex flex-column gap-3 flex-grow-1">
                            <div class="wb-donut-wrap">
                                <div class="wb-donut-inner">
                                    <div class="wb-chart-wrap wb-chart-wrap-no-center">
                                        <canvas id="paymentCollectionChart"></canvas>
                                    </div>
                                    <div class="wb-donut-legend w-100">
                                        @foreach (var item in paymentChart.Items)
                                        {
                                            <div class="wb-donut-row">
                                                <span class="wb-dot" style="background:@item.Color"></span>
                                                <div>
                                                    <div class="wb-donut-lbl">@item.Label</div>
                                                    <small class="text-muted">@FormatCompactCurrency(item.Amount) (@item.Percentage%)</small>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-12">
                                    <div class="wb-summary-tile">
                                        <span>Total Collection</span>
                                        <strong>@FormatCompactCurrency(total)</strong>
                                    </div>
                                </div>
                                @foreach (var item in paymentChart.Items)
                                {
                                    <div class="col-12 col-sm-6">
                                        <div class="wb-summary-tile">
                                            <span>@item.Label</span>
                                            <strong>@FormatCompactCurrency(item.Amount)</strong>
                                            <small>@item.Percentage%</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <script>window._paymentCollectionData = { labels: @Html.Raw(labels), values: @Html.Raw(values), colors: @Html.Raw(colors), type: 'amount', chartType: 'pie' };</script>
                    }
                    else { <div class="wb-empty">No collection data available.</div> }
                </section>
            </div>
            <div class="col-12 col-xl-4">
                <section class="wb-card h-100">
                    <div class="wb-section-hdr">
                        <div><h2>@Model.DefaulterWidget?.Title</h2><p>@Model.DefaulterWidget?.Caption</p></div>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="wb-inline-chip">Default: @FormatCompactCurrency(Model.DefaulterWidget?.ConfiguredThresholdAmount ?? 0)</span>
                            @if (!string.IsNullOrWhiteSpace(Model.DefaulterWidget?.Url))
                            {
                                <a class="btn btn-outline-primary btn-sm" href="@Model.DefaulterWidget.Url">View Dues</a>
                            }
                        </div>
                    </div>
                    @if (Model.DefaulterWidget is { } defaulter)
                    {
                        var defaulterLabels = "[\"Defaulters\",\"Non-Defaulters\"]";
                        var defaulterValues = $"[{defaulter.ConsumerCount},{defaulter.NonDefaulterCount}]";
                        var defaulterColors = "[\"#dc2626\",\"#16a34a\"]";
                        var defPct = defaulter.TotalConsumers == 0 ? 0 : Math.Round(defaulter.ConsumerCount * 100m / defaulter.TotalConsumers, 1);
                        var nonDefPct = defaulter.TotalConsumers == 0 ? 0 : Math.Round(defaulter.NonDefaulterCount * 100m / defaulter.TotalConsumers, 1);
                        <div class="d-flex flex-column gap-3">
                            <form method="get" class="wb-inline-filter">
                                <label for="defaulterThreshold" class="form-label mb-1">One-time threshold</label>
                                <div class="d-flex gap-2">
                                    <input type="number" step="0.01" min="0" class="form-control form-control-sm" id="defaulterThreshold" name="defaulterThreshold" value="@defaulter.ThresholdAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
                                </div>
                            </form>
                            <div class="wb-donut-wrap">
                                <div class="wb-donut-inner">
                                    <div class="wb-chart-wrap">
                                        <canvas id="defaulterChart"></canvas>
                                        <div class="wb-chart-center">
                                            <strong>@defPct%</strong>
                                            <span>Defaulter Share</span>
                                        </div>
                                    </div>
                                    <div class="wb-donut-legend w-100">
                                        <div class="wb-donut-row">
                                            <span class="wb-dot" style="background:#dc2626"></span>
                                            <div>
                                                <div class="wb-donut-lbl">Defaulters</div>
                                                <small class="text-muted">@defaulter.ConsumerCount.ToString("N0") (@defPct%)</small>
                                            </div>
                                        </div>
                                        <div class="wb-donut-row">
                                            <span class="wb-dot" style="background:#16a34a"></span>
                                            <div>
                                                <div class="wb-donut-lbl">Non-Defaulters</div>
                                                <small class="text-muted">@defaulter.NonDefaulterCount.ToString("N0") (@nonDefPct%)</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row g-2">
                                <div class="col-12 col-sm-6">
                                    <div class="wb-summary-tile">
                                        <span>Total Defaulters</span>
                                        <strong>@defaulter.ConsumerCount.ToString("N0")</strong>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <div class="wb-summary-tile">
                                        <span>Total Non-Defaulters</span>
                                        <strong>@defaulter.NonDefaulterCount.ToString("N0")</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-start border rounded-3 px-3 py-2">
                                <div>
                                    <div class="fw-semibold">Total Outstanding</div>
                                    <small class="text-muted">Across all consumers above threshold</small>
                                </div>
                                <strong>@FormatCompactCurrency(defaulter.TotalOutstandingAmount)</strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-start border rounded-3 px-3 py-2">
                                <div>
                                    <div class="fw-semibold">Threshold Used</div>
                                    <small class="text-muted">Temporary dashboard view value</small>
                                </div>
                                <strong>@FormatCompactCurrency(defaulter.ThresholdAmount)</strong>
                            </div>
                        </div>
                        <script>window._defaulterData = { labels: @Html.Raw(defaulterLabels), values: @Html.Raw(defaulterValues), colors: @Html.Raw(defaulterColors), chartType: 'doughnut', cutout: '72%', rotation: -90, circumference: 180 };</script>
                    }
                    else { <div class="wb-empty">No defaulter data available.</div> }
                </section>
            </div>
        </div>

        @* â”€â”€ Row 2: Department Workload (full width) â”€â”€ *@
        @if (Model.SecondaryBarChart is { Items.Count: > 0 } deptChart)
        {
            <section class="wb-card">
                <div class="wb-section-hdr">
                    <div><h2>@deptChart.Title</h2><p>@deptChart.Caption</p></div>
                    <a class="btn btn-outline-primary btn-sm" href="/Approvals?tab=Pending">View Queue</a>
                </div>
                @{ var dMax = Math.Max(1, deptChart.Items.Max(x => x.Value)); }
                <div class="wb-dept-grid">
                    @foreach (var b in deptChart.Items)
                    {
                        <a class="wb-bar-row text-decoration-none" href="@(b.Url ?? "#")">
                            <div class="wb-bar-copy"><span>@b.Label</span><strong>@b.Value</strong></div>
                            <div class="wb-bar-track"><div class="wb-bar-fill" style="width:@(b.Value * 100m / dMax)%;background:@b.Color"></div></div>
                        </a>
                    }
                </div>
            </section>
        }

        @* â”€â”€ Row 3: Trend (50%) + Recent Queries (50%) â”€â”€ *@
        <div class="row g-3">
            <div class="col-12 col-xl-6">
                @if (Model.TrendChart is { Points.Count: > 0 } tc)
                {
                    var mx = Math.Max(1m, tc.Points.Max(x => Math.Max(x.PrimaryValue, x.SecondaryValue)));
                    <section class="wb-card h-100">
                        <div class="wb-section-hdr">
                            <div><h2>@tc.Title</h2><p>@tc.Caption</p></div>
                            <div class="wb-trend-legend">
                                <span><i class="wb-swatch wb-p"></i>@tc.PrimaryLabel</span>
                                <span><i class="wb-swatch wb-s"></i>@tc.SecondaryLabel</span>
                            </div>
                        </div>
                        <div class="wb-trend-chart">
                            @foreach (var pt in tc.Points)
                            {
                                <div class="wb-trend-col">
                                    <div class="wb-trend-bars">
                                        <div class="wb-trend-bar wb-p" style="height:@(pt.PrimaryValue * 100m / mx)%"></div>
                                        <div class="wb-trend-bar wb-s" style="height:@(pt.SecondaryValue * 100m / mx)%"></div>
                                    </div>
                                    <div class="wb-trend-vals"><span>@pt.PrimaryValue</span><span>@pt.SecondaryValue</span></div>
                                    <div class="wb-trend-lbl">@pt.Label</div>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>
            <div class="col-12 col-xl-6">
                <section class="wb-card h-100">
                    <div class="wb-section-hdr">
                        <div><h2>Recent Queries</h2><p>Most recently raised consumer support queries.</p></div>
                        <a class="btn btn-outline-primary btn-sm" href="/ConsumerQueryManagement">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table wb-table align-middle mb-0">
                            <thead><tr><th>Query No</th><th>Consumer</th><th>Status</th><th>Raised</th></tr></thead>
                            <tbody>
                                @{ var queries = Model.RecentServiceDeskItems.Take(8).ToList(); }
                                @if (!queries.Any())
                                {
                                    <tr><td colspan="4" class="wb-empty-row">No recent queries found.</td></tr>
                                }
                                else
                                {
                                    @foreach (var q in queries)
                                    {
                                        <tr>
                                            <td><a class="wb-link" href="@q.Url">@q.ReferenceNo</a></td>
                                            <td>
                                                <div>@q.ConsumerName</div>
                                                <small class="text-muted">@q.Subject</small>
                                            </td>
                                            <td><span class="badge @ToneClass(StatusTone(q.Status))">@q.Status</span></td>
                                            <td>@ShortDate(q.CreatedOn)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>

        @* â”€â”€ Row 4: Recent Challans (50%) + Approval Queue (50%) â”€â”€ *@
        <div class="row g-3">
            <div class="col-12 col-xl-6">
                <section class="wb-card h-100">
                    <div class="wb-section-hdr">
                        <div><h2>Recent Challans</h2><p>Latest demand records and payment requests.</p></div>
                        <a class="btn btn-outline-primary btn-sm" href="/ChallanManagement">View All</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table wb-table align-middle mb-0">
                            <thead><tr><th>Challan</th><th>Consumer</th><th>Purpose</th><th>Amount</th><th>Status</th></tr></thead>
                            <tbody>
                                @{ var challans = Model.RecentChallans.Take(8).ToList(); }
                                @if (!challans.Any())
                                {
                                    <tr><td colspan="5" class="wb-empty-row">No challans found.</td></tr>
                                }
                                else
                                {
