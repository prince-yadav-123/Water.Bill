@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <style>
        /* â”€â”€â”€ Hero â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
        .wb-hero {
            background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 100%);
            color: #fff;
        }
        .wb-hero-eyebrow {
            display: inline-block;
            margin-bottom: 0.55rem;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.6);
        }
        .wb-hero-title {
            font-size: 1.85rem;
            font-weight: 700;
            line-height: 1.1;
        }
        .wb-hero-sub {
            color: rgba(255,255,255,0.78);
            max-width: 55rem;
        }
        .wb-hero-meta {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            justify-content: center;
            gap: 0.5rem;
            min-width: 13rem;
        }
        .wb-hero-role {
            display: inline-flex;
            align-items: center;
            padding: 0.45rem 0.85rem;
            border-radius: 999px;
            background: rgba(255,255,255,0.12);
            font-weight: 600;
            font-size: 0.9rem;
        }
        .wb-hero-date {
            font-size: 0.88rem;
            color: rgba(255,255,255,0.65);
        }
        @@media (max-width: 1199.98px) {
            .wb-hero-meta { align-items: flex-start; }
        }

        /* ─── KPI Cards ─────────────────────────────────────────── */
        .wb-kpi {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1.25rem 1.4rem;
            background: #fff;
            border: 1px solid #e8edf4;
            border-radius: 1rem;
            position: relative;
            overflow: hidden;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        a:hover .wb-kpi {
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(15,23,42,0.09);
            border-color: #bfdbfe;
        }
        .wb-kpi-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 3rem;
            height: 3rem;
            border-radius: 0.85rem;
            font-size: 1.35rem;
            flex-shrink: 0;
            z-index: 1;
        }
        .wb-icon-primary { background: #dbeafe; color: #2563eb; }
        .wb-icon-success { background: #dcfce7; color: #16a34a; }
        .wb-icon-warning { background: #fef3c7; color: #d97706; }
        .wb-icon-danger  { background: #fee2e2; color: #dc2626; }
        .wb-icon-info    { background: #e0f2fe; color: #0284c7; }
        .wb-kpi-mid {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
            flex: 1;
            min-width: 0;
            z-index: 1;
        }
        .wb-kpi-label {
            font-size: 0.75rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            line-height: 1.2;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .wb-kpi-value {
            font-size: 1.9rem;
            font-weight: 800;
            line-height: 1.05;
            color: #0f172a;
        }
        .wb-kpi-ghost {
            position: absolute;
            right: 0.6rem;
            bottom: -0.6rem;
            font-size: 4.2rem;
            opacity: 0.055;
            color: #334155;
            pointer-events: none;
            z-index: 0;
        }

        /* â”€â”€â”€ Generic card â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
        .wb-card {
            background: #fff;
            border: 1px solid #e8edf4;
            border-radius: 1rem;
            padding: 1.25rem 1.5rem;
        }
        .wb-section-hdr {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 1rem;
        }
        .wb-section-hdr h2 {
            margin: 0;
            font-size: 1rem;
            font-weight: 700;
            color: #0f172a;
        }
        .wb-section-hdr p {
            margin: 0.3rem 0 0;
            font-size: 0.87rem;
            color: #64748b;
        }

        /* ─── Donut chart ─────────────────────────────────────── */
        .wb-donut-wrap {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0.75rem 0;
        }
        .wb-donut-inner {
            display: grid;
            grid-template-columns: auto 1fr;
            align-items: center;
            gap: 1.75rem;
            width: 100%;
        }
        /* Chart.js canvas wrapper */
        .wb-chart-wrap {
            position: relative;
            width: 11rem;
            height: 11rem;
            flex-shrink: 0;
        }
        .wb-chart-wrap-no-center { width: 10.5rem; height: 10.5rem; }
        .wb-chart-wrap canvas {
            width: 100% !important;
            height: 100% !important;
        }
        .wb-chart-center {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            pointer-events: none;
        }
        .wb-chart-center strong { font-size: 1.55rem; line-height: 1; font-weight: 800; color: #0f172a; }
        .wb-chart-center span   { font-size: 0.72rem; color: #64748b; margin-top: 0.2rem; }
        .wb-donut-legend        { display: flex; flex-direction: column; gap: 0.75rem; }
        .wb-donut-row           { display: flex; align-items: flex-start; gap: 0.65rem; }
        .wb-donut-lbl           { font-size: 0.88rem; font-weight: 600; color: #1e293b; }
        .wb-mini-summary {
            display: flex;
            flex-direction: column;
            gap: 0.2rem;
            padding: 0.85rem 1rem;
            border: 1px solid #e8edf4;
            border-radius: 0.85rem;
            background: #f8fafc;
        }
        .wb-mini-summary strong { font-size: 1.35rem; font-weight: 800; color: #0f172a; }
        .wb-mini-summary span { font-size: 0.8rem; color: #64748b; }
        .wb-dot {
            width: 0.7rem;
            height: 0.7rem;
            border-radius: 50%;
            flex-shrink: 0;
            margin-top: 0.25rem;
        }

        /* ─── Query Status rows ──────────────────────────────── */
        .wb-qrow {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.85rem 1rem;
            border-radius: 0.75rem;
            border: 1px solid #e8edf4;
            background: #f8fafc;
            text-decoration: none;
            color: #0f172a;
            transition: background 0.15s, border-color 0.15s;
            gap: 1rem;
        }
        .wb-qrow:hover { background: #f1f5f9; border-color: #cbd5e1; }
        .wb-qrow-label {
            font-size: 0.92rem;
            font-weight: 500;
            color: #334155;
        }
        .wb-qrow-count {
            font-size: 1.55rem;
            font-weight: 800;
            line-height: 1;
            min-width: 2.5rem;
            text-align: right;
        }
        .wb-qrow-accent {
            width: 0.55rem;
            height: 1.5rem;
            border-radius: 999px;
            flex-shrink: 0;
        }
        .wb-qrow-danger  .wb-qrow-accent { background: #dc2626; }
        .wb-qrow-danger  .wb-qrow-count  { color: #dc2626; }
        .wb-qrow-warning .wb-qrow-accent { background: #d97706; }
        .wb-qrow-warning .wb-qrow-count  { color: #d97706; }
        .wb-qrow-success .wb-qrow-accent { background: #16a34a; }
        .wb-qrow-success .wb-qrow-count  { color: #16a34a; }
        .wb-qrow-secondary .wb-qrow-accent { background: #94a3b8; }
        .wb-qrow-secondary .wb-qrow-count  { color: #475569; }

        /* â”€â”€â”€ Department workload bars â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
        .wb-dept-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(26rem, 1fr));
            gap: 1.5rem 2.5rem;
        }
        @@media (max-width: 767.98px) {
            .wb-dept-grid { grid-template-columns: 1fr; gap: 1rem; }
        }
        .wb-bar-row    { display: grid; gap: 0.5rem; text-decoration: none; color: inherit; }
        .wb-bar-copy   { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; color: #0f172a; }
        .wb-bar-track  { height: 0.6rem; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
        .wb-bar-fill   { height: 100%; border-radius: 999px; }
        .wb-bar-meta   { font-size: 0.78rem; color: #64748b; }
        .wb-summary-tile {
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
