    <script>
        (function () {
            function escapeHtml(value) {
                return String(value == null ? '' : value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function formatNumber(value) {
                var num = Number(value || 0);
                return new Intl.NumberFormat('en-IN').format(num);
            }

            function formatCompactCurrency(value) {
                var num = Number(value || 0);
                var abs = Math.abs(num);
                if (abs >= 10000000) return '₹' + (num / 10000000).toFixed(2) + ' Cr';
                return '₹' + (num / 100000).toFixed(2) + ' Lakh';
            }

            function formatDate(value) {
                if (!value) return '-';
                var d = new Date(value);
                if (isNaN(d.getTime())) return '-';
                return d.toLocaleString('en-IN', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });
            }

            function shortDate(value) {
                if (!value) return '-';
                var d = new Date(value);
                if (isNaN(d.getTime())) return '-';
                return d.toLocaleDateString('en-IN', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                });
            }

            function getQueryValue(name) {
                return new URLSearchParams(window.location.search).get(name);
            }

            function initChart(canvasId, data) {
                var el = document.getElementById(canvasId);
                if (!el || !data) return null;

                if (el._wbChart) {
                    el._wbChart.destroy();
                }

                el._wbChart = new Chart(el, {
                    type: data.chartType || 'doughnut',
                    data: {
                        labels: data.labels || [],
                        datasets: [{
                            data: data.values || [],
                            backgroundColor: data.colors || [],
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        cutout: data.cutout || '70%',
                        rotation: data.rotation,
                        circumference: data.circumference,
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        var total = ctx.dataset.data.reduce(function (a, b) { return a + Number(b || 0); }, 0);
                                        var pct = total > 0 ? Math.round((Number(ctx.parsed || 0) / total) * 1000) / 10 : 0;
                                        if (data.type === 'amount') {
                                            return ' ' + ctx.label + ': ' + formatCompactCurrency(ctx.parsed) + ' (' + pct + '%)';
                                        }
                                        return ' ' + ctx.label + ': ' + formatNumber(ctx.parsed) + ' (' + pct + '%)';
                                    }
                                }
                            }
                        },
                        animation: { duration: 600, easing: 'easeInOutQuart' }
                    }
                });

                return el._wbChart;
            }

            function toneClass(tone) {
                switch ((tone || '').toLowerCase()) {
                    case 'success': return 'wb-badge-success';
                    case 'warning': return 'wb-badge-warning';
                    case 'danger': return 'wb-badge-danger';
                    case 'info': return 'wb-badge-info';
                    case 'secondary': return 'wb-badge-secondary';
                    default: return 'wb-badge-primary';
                }
            }

            function toneFromStatus(value) {
                var text = (value || '').toString().toLowerCase();
                if (!text) return 'secondary';
                if (text.indexOf('success') >= 0 || text.indexOf('paid') >= 0 || text.indexOf('approved') >= 0 || text.indexOf('resolved') >= 0 || text.indexOf('closed') >= 0 || text.indexOf('completed') >= 0 || text.indexOf('active') >= 0) return 'success';
                if (text.indexOf('fail') >= 0 || text.indexOf('reject') >= 0 || text.indexOf('cancel') >= 0) return 'danger';
                if (text.indexOf('pending') >= 0 || text.indexOf('due') >= 0 || text.indexOf('draft') >= 0 || text.indexOf('open') >= 0 || text.indexOf('hold') >= 0) return 'warning';
                if (text.indexOf('review') >= 0 || text.indexOf('process') >= 0 || text.indexOf('progress') >= 0) return 'info';
                return 'secondary';
            }

            function buildDonutLegend(items, total, getValue, valueFormatter) {
                return (items || []).map(function (item) {
                    var count = Number(getValue(item) || 0);
                    var pct = total > 0 ? Math.round((count * 1000) / total) / 10 : 0;
                    return '<div class="wb-donut-row">' +
                        '<span class="wb-dot" style="background:' + escapeHtml(item.color || '#2563eb') + '"></span>' +
                        '<div><div class="wb-donut-lbl">' + escapeHtml(item.label || '') + '</div>' +
                        '<small class="text-muted">' + escapeHtml(valueFormatter(item, count)) + ' &nbsp;(' + pct + '%)</small></div>' +
                        '</div>';
                }).join('');
            }

            function renderDivisionWidget(widget) {
                if (!widget || !widget.items || !widget.items.length) {
                    return '<div class="wb-widget-shell-empty">No division data available.</div>';
                }

                var total = widget.items.reduce(function (sum, item) { return sum + Number(item.count || 0); }, 0);
                var max = Math.max.apply(Math, widget.items.map(function (item) { return Number(item.count || 0); }).concat([1]));

                return '' +
                    '<div class="d-flex flex-column gap-3 flex-grow-1">' +
                        '<div class="wb-mini-summary">' +
                            '<strong>' + formatNumber(total) + '</strong>' +
                            '<span>Total Consumers</span>' +
                        '</div>' +
                        '<div class="wb-dept-grid wb-dept-grid-compact">' +
                            widget.items.map(function (item) {
                                var width = Math.max(4, Math.round((Number(item.count || 0) * 100) / max));
                                return '' +
                                    '<div class="wb-bar-row">' +
                                        '<div class="wb-bar-copy">' +
                                            '<span>' + escapeHtml(item.label || '') + '</span>' +
                                            '<strong>' + escapeHtml(String(Number(item.percentage || 0).toFixed(1)).replace('.0', '')) + '%</strong>' +
                                        '</div>' +
                                        '<div class="wb-bar-track">' +
                                            '<div class="wb-bar-fill" style="width:' + width + '%;background:' + escapeHtml(item.color || '#2563eb') + '"></div>' +
                                        '</div>' +
                                        '<div class="wb-bar-meta">' + formatNumber(item.count || 0) + ' consumers</div>' +
                                    '</div>';
                            }).join('') +
                        '</div>' +
                    '</div>';
            }

            function renderPaymentWidget(widget) {
                if (!widget || !widget.items || !widget.items.length) {
                    return '<div class="wb-widget-shell-empty">No collection data available.</div>';
                }

                var total = widget.items.reduce(function (sum, item) { return sum + Number(item.amount || 0); }, 0);
                var labels = widget.items.map(function (item) { return item.label; });
                var values = widget.items.map(function (item) { return Number(item.amount || 0); });
                var colors = widget.items.map(function (item) { return item.color; });
                var legend = buildDonutLegend(widget.items, total, function (item) { return item.amount; }, function (item, amount) {
                    return formatCompactCurrency(amount);
                });

                return '' +
                    '<div class="d-flex flex-column gap-3 flex-grow-1">' +
                        '<div class="wb-donut-wrap">' +
                            '<div class="wb-donut-inner">' +
                                '<div class="wb-chart-wrap wb-chart-wrap-no-center">' +
                                    '<canvas id="paymentCollectionChart"></canvas>' +
                                '</div>' +
                                '<div class="wb-donut-legend w-100">' + legend + '</div>' +
                            '</div>' +
                        '</div>' +
                        '<div class="row g-2">' +
                            '<div class="col-12">' +
                                '<div class="wb-summary-tile">' +
                                    '<span>Total Collection</span>' +
                                    '<strong>' + formatCompactCurrency(total) + '</strong>' +
                                '</div>' +
                            '</div>' +
                            widget.items.map(function (item) {
                                return '' +
                                    '<div class="col-12 col-sm-6">' +
                                        '<div class="wb-summary-tile">' +
                                            '<span>' + escapeHtml(item.label || '') + '</span>' +
                                            '<strong>' + formatCompactCurrency(item.amount || 0) + '</strong>' +
                                            '<small>' + escapeHtml(String(Number(item.percentage || 0).toFixed(1)).replace('.0', '')) + '%</small>' +
                                        '</div>' +
                                    '</div>';
                            }).join('') +
                        '</div>' +
                    '</div>';
            }

            function renderDefaulterWidget(widget) {
                if (!widget) {
                    return '<div class="wb-widget-shell-empty">No defaulter data available.</div>';
                }

                var labels = ['Defaulters', 'Non-Defaulters'];
                var values = [Number(widget.consumerCount || 0), Number(widget.nonDefaulterCount || 0)];
                var colors = ['#dc2626', '#16a34a'];
                var total = Number(widget.totalConsumers || 0);
                var defPct = total > 0 ? Math.round((values[0] * 1000) / total) / 10 : 0;
                var nonPct = total > 0 ? Math.round((values[1] * 1000) / total) / 10 : 0;

                return '' +
                    '<div class="d-flex flex-column gap-3">' +
                        '<form method="get" class="wb-inline-filter">' +
                            '<label for="defaulterThreshold" class="form-label mb-1">One-time threshold</label>' +
                            '<div class="d-flex gap-2">' +
                                '<input type="number" step="0.01" min="0" class="form-control form-control-sm" id="defaulterThreshold" name="defaulterThreshold" value="' + escapeHtml(Number(widget.thresholdAmount || 0).toString()) + '" />' +
                                '<button type="submit" class="btn btn-primary btn-sm">Apply</button>' +
                            '</div>' +
                        '</form>' +
                        '<div class="wb-donut-wrap">' +
                            '<div class="wb-donut-inner">' +
                                '<div class="wb-chart-wrap">' +
                                    '<canvas id="defaulterChart"></canvas>' +
                                    '<div class="wb-chart-center">' +
                                        '<strong>' + escapeHtml(String(defPct).replace('.0', '')) + '%</strong>' +
                                        '<span>Defaulter Share</span>' +
                                    '</div>' +
                                '</div>' +
                                '<div class="wb-donut-legend w-100">' +
                                    '<div class="wb-donut-row"><span class="wb-dot" style="background:#dc2626"></span><div><div class="wb-donut-lbl">Defaulters</div><small class="text-muted">' + formatNumber(values[0]) + ' (' + escapeHtml(String(defPct).replace('.0', '')) + '%)</small></div></div>' +
                                    '<div class="wb-donut-row"><span class="wb-dot" style="background:#16a34a"></span><div><div class="wb-donut-lbl">Non-Defaulters</div><small class="text-muted">' + formatNumber(values[1]) + ' (' + escapeHtml(String(nonPct).replace('.0', '')) + '%)</small></div></div>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                        '<div class="wb-widget-summary-grid two-up mt-3">' +
                            '<div class="wb-mini-summary"><span>Total Defaulters</span><strong>' + formatNumber(widget.consumerCount || 0) + '</strong></div>' +
                            '<div class="wb-mini-summary"><span>Total Non-Defaulters</span><strong>' + formatNumber(widget.nonDefaulterCount || 0) + '</strong></div>' +
                        '</div>' +
                        '<div class="d-flex justify-content-between align-items-start border rounded-3 px-3 py-2">' +
                            '<div>' +
                                '<div class="fw-semibold">Total Outstanding</div>' +
                                '<small class="text-muted">Across all consumers above threshold</small>' +
                            '</div>' +
                            '<strong>' + formatCompactCurrency(widget.totalOutstandingAmount || 0) + '</strong>' +
                        '</div>' +
                        '<div class="d-flex justify-content-between align-items-start border rounded-3 px-3 py-2">' +
                            '<div>' +
                                '<div class="fw-semibold">Threshold Used</div>' +
                                '<small class="text-muted">Temporary dashboard view value</small>' +
                            '</div>' +
                            '<strong>' + formatCompactCurrency(widget.thresholdAmount || 0) + '</strong>' +
                        '</div>' +
                    '</div>';
            }

            function renderWorkloadWidget(widget) {
                if (!widget || !widget.items || !widget.items.length) {
                    return '<div class="wb-widget-shell-empty">No workflow data available.</div>';
                }

                var max = Math.max.apply(Math, widget.items.map(function (x) { return Number(x.value || 0); }).concat([1]));
                return '<div class="wb-dept-grid wb-dept-grid-compact">' + widget.items.map(function (item) {
                    var width = Math.max(4, Math.round((Number(item.value || 0) * 100) / max));
                    return '' +
                        '<a class="wb-bar-row text-decoration-none" href="' + escapeHtml(item.url || '#') + '">' +
                            '<div class="wb-bar-copy"><span>' + escapeHtml(item.label || '') + '</span><strong>' + formatNumber(item.value || 0) + '</strong></div>' +
                            '<div class="wb-bar-track"><div class="wb-bar-fill" style="width:' + width + '%;background:' + escapeHtml(item.color || '#2563eb') + '"></div></div>' +
                        '</a>';
                }).join('') + '</div>';
            }

            function renderTrendWidget(widget) {
                if (!widget || !widget.points || !widget.points.length) {
                    return '<div class="wb-widget-shell-empty">No trend data available.</div>';
                }

                var max = Math.max.apply(Math, widget.points.map(function (x) {
                    return Math.max(Number(x.primaryValue || 0), Number(x.secondaryValue || 0));
                }).concat([1]));

                return '<div class="wb-trend-chart">' + widget.points.map(function (point) {
                    var pHeight = Math.max(4, Math.round((Number(point.primaryValue || 0) * 100) / max));
                    var sHeight = Math.max(4, Math.round((Number(point.secondaryValue || 0) * 100) / max));
                    return '' +
                        '<div class="wb-trend-col">' +
                            '<div class="wb-trend-bars">' +
                                '<div class="wb-trend-bar wb-p" style="height:' + pHeight + '%"></div>' +
                                '<div class="wb-trend-bar wb-s" style="height:' + sHeight + '%"></div>' +
                            '</div>' +
                            '<div class="wb-trend-vals"><span>' + formatNumber(point.primaryValue || 0) + '</span><span>' + formatNumber(point.secondaryValue || 0) + '</span></div>' +
                            '<div class="wb-trend-lbl">' + escapeHtml(point.label || '') + '</div>' +
                        '</div>';
                }).join('') + '</div>';
            }

            function renderServiceDeskWidget(widget) {
                if (!widget || !widget.groups || !widget.groups.length) {
                    return '<div class="wb-widget-shell-empty">No query data available.</div>';
                }

                var html = '<div class="d-flex flex-column gap-2">';
                widget.groups.forEach(function (grp) {
                    html += '<div class="wb-summary-tile">' +
                        '<strong>' + escapeHtml(grp.label || '') + '</strong>';
                    (grp.items || []).forEach(function (item) {
                        html += '<a class="wb-qrow wb-qrow-' + escapeHtml((item.tone || 'secondary').toLowerCase()) + '" href="' + escapeHtml(item.url || '#') + '">' +
                            '<div class="d-flex align-items-center gap-2"><span class="wb-qrow-accent"></span><span class="wb-qrow-label">' + escapeHtml(item.label || '') + '</span></div>' +
                            '<strong class="wb-qrow-count">' + formatNumber(item.value || 0) + '</strong>' +
                        '</a>';
                    });
                    html += '</div>';
                });
                html += '</div>';
                return html;
            }

            var adminWidgetBundlePromise = null;

            function getAdminWidgetBundle() {
                if (adminWidgetBundlePromise) {
                    return adminWidgetBundlePromise;
                }

                var url = new URL('/Dashboard/AdminWidgets', window.location.origin);
                var threshold = getQueryValue('defaulterThreshold');
                if (threshold) url.searchParams.set('defaulterThreshold', threshold);

                adminWidgetBundlePromise = fetch(url.toString(), { credentials: 'same-origin' })
                    .then(function (response) {
                        if (!response.ok) throw new Error('Dashboard widget request failed');
                        return response.json();
                    })
                    .catch(function (error) {
                        adminWidgetBundlePromise = null;
                        throw error;
                    });

                return adminWidgetBundlePromise;
            }

            function renderAdminWidget(section, bundle) {
                if (!section) return;

                var key = section.getAttribute('data-admin-widget');
                var shell = section.querySelector('[data-admin-widget-target]');
                if (!shell) return;

                if (key === 'division') {
                    shell.outerHTML = renderDivisionWidget(bundle.divisionConsumerChart);
                    return;
                }

                if (key === 'payment') {
                    shell.outerHTML = renderPaymentWidget(bundle.paymentCollectionChart);
                    if (bundle.paymentCollectionChart) {
                        initChart('paymentCollectionChart', {
                            labels: (bundle.paymentCollectionChart.items || []).map(function (item) { return item.label; }),
                            values: (bundle.paymentCollectionChart.items || []).map(function (item) { return Number(item.amount || 0); }),
                            colors: (bundle.paymentCollectionChart.items || []).map(function (item) { return item.color; }),
                            chartType: 'pie',
                            type: 'amount'
                        });
                    }
                    return;
                }

                if (key === 'defaulter') {
                    shell.outerHTML = renderDefaulterWidget(bundle.defaulterWidget);
                    if (bundle.defaulterWidget) {
                        initChart('defaulterChart', {
                            labels: ['Defaulters', 'Non-Defaulters'],
                            values: [
                                Number(bundle.defaulterWidget.consumerCount || 0),
                                Number(bundle.defaulterWidget.nonDefaulterCount || 0)
                            ],
                            colors: ['#dc2626', '#16a34a'],
                            chartType: 'doughnut',
                            cutout: '72%',
                            rotation: -90,
                            circumference: 180
                        });
                    }
                    return;
                }

                if (key === 'workload') {
                    shell.outerHTML = renderWorkloadWidget(bundle.secondaryBarChart);
                    return;
                }

                if (key === 'trend') {
                    shell.outerHTML = renderTrendWidget(bundle.trendChart);
                    return;
                }

                if (key === 'service-desk') {
                    shell.outerHTML = renderServiceDeskWidget(bundle.serviceDeskPanel);
                }
            }

            function showAdminWidgetError(section) {
                var shell = section.querySelector('[data-admin-widget-target]');
                if (shell) {
                    shell.classList.add('wb-widget-loading-shell');
                    shell.setAttribute('data-widget-state', 'error');
                    shell.innerHTML = '<div class="wb-widget-shell-empty">Unable to load widget.</div>';
                }
            }

            function showAdminWidgetLoading(section) {
                var shell = section.querySelector('[data-admin-widget-target]');
                if (!shell) return;

                shell.classList.add('wb-widget-loading-shell');
                shell.setAttribute('data-widget-state', 'loading');
                shell.innerHTML = '<div class="wb-widget-loading">Loading...</div>';
            }

            function loadAdminWidget(section) {
                if (!section || section.getAttribute('data-widget-loaded') === 'true') {
                    return;
                }

                showAdminWidgetLoading(section);

                getAdminWidgetBundle()
                    .then(function (data) {
                        renderAdminWidget(section, data || {});
                        section.setAttribute('data-widget-loaded', 'true');
                    })
                    .catch(function () {
                        showAdminWidgetError(section);
                    });
            }

            function loadAdminWidgets() {
                var sections = Array.prototype.slice.call(document.querySelectorAll('[data-admin-widget]'));
                if (!sections.length) return;

                sections.forEach(function (section) {
                    section.setAttribute('data-widget-loaded', 'false');
                });

                if (typeof window.IntersectionObserver !== 'function') {
                    sections.forEach(loadAdminWidget);
                    return;
                }

                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (!entry.isIntersecting) return;
                        observer.unobserve(entry.target);
                        loadAdminWidget(entry.target);
                    });
                }, {
                    rootMargin: '140px 0px'
                });

                sections.forEach(function (section) {
                    observer.observe(section);
                });
            }

            function scheduleLazyLoad(action) {
                if (typeof window.requestIdleCallback === 'function') {
                    window.requestIdleCallback(action, { timeout: 900 });
                    return;
                }

                window.setTimeout(action, 180);
            }

            function renderRecentApplications(rows) {
                rows = rows || [];
                if (!rows.length) {
                    return '<div class="wb-empty">No recent applications found.</div>';
                }

                var html = '<div class="table-responsive"><table class="table wb-table align-middle mb-0"><thead><tr><th>Type</th><th>Application No</th><th>Applicant</th><th>Status</th><th>Received</th></tr></thead><tbody>';
                rows.forEach(function (r) {
                    html += '<tr>' +
                        '<td><span class="wb-type-badge">' + escapeHtml(r.type || '') + '</span></td>' +
                        '<td>' + (r.url ? '<a class="wb-link" href="' + escapeHtml(r.url) + '">' + escapeHtml(r.applicationNo || '') + '</a>' : '<span>' + escapeHtml(r.applicationNo || '') + '</span>') + '</td>' +
                        '<td><div class="fw-semibold">' + escapeHtml(r.applicantName || '') + '</div><small class="text-muted">' + escapeHtml(r.property || '') + '</small></td>' +
                        '<td><span class="badge ' + toneClass(r.statusTone || toneFromStatus(r.status)) + '">' + escapeHtml(r.status || '') + '</span></td>' +
                        '<td>' + escapeHtml(shortDate(r.createdOn)) + '</td>' +
                    '</tr>';
                });
                html += '</tbody></table></div>';
                return html;
            }

            function renderRecentActivity(rows) {
                rows = rows || [];
                if (!rows.length) {
                    return '<div class="wb-empty">No recent activity found.</div>';
                }

                var html = '<div class="table-responsive"><table class="table wb-table align-middle mb-0"><thead><tr><th>Action</th><th>Module</th><th>User</th><th>Result</th><th>Time</th></tr></thead><tbody>';
                rows.forEach(function (r) {
                    html += '<tr>' +
                        '<td>' + escapeHtml(r.action || '') + '</td>' +
                        '<td>' + escapeHtml(r.module || '') + '</td>' +
                        '<td>' + escapeHtml(r.username || '-') + '</td>' +
                        '<td><span class="badge ' + (r.success ? 'wb-badge-success' : 'wb-badge-danger') + '">' + (r.success ? 'Success' : 'Failed') + '</span></td>' +
                        '<td>' + escapeHtml(formatDate(r.occurredOn)) + '</td>' +
                    '</tr>';
                });
                html += '</tbody></table></div>';
                return html;
            }

            function renderRecentQueries(rows) {
                rows = rows || [];
                if (!rows.length) {
                    return '<div class="wb-empty">No recent queries found.</div>';
                }

                var html = '<div class="table-responsive"><table class="table wb-table align-middle mb-0"><thead><tr><th>Reference</th><th>Consumer</th><th>Subject</th><th>Status</th><th>Created</th></tr></thead><tbody>';
                rows.forEach(function (r) {
                    html += '<tr>' +
                        '<td>' + (r.url ? '<a class="wb-link" href="' + escapeHtml(r.url) + '">' + escapeHtml(r.referenceNo || '') + '</a>' : escapeHtml(r.referenceNo || '')) + '</td>' +
                        '<td>' + escapeHtml(r.consumerName || '-') + '</td>' +
                        '<td>' + escapeHtml(r.subject || '') + '</td>' +
                        '<td><span class="badge ' + toneClass(r.statusTone || toneFromStatus(r.status)) + '">' + escapeHtml(r.status || '') + '</span></td>' +
                        '<td>' + escapeHtml(shortDate(r.createdOn)) + '</td>' +
                    '</tr>';
                });
                html += '</tbody></table></div>';
                return html;
            }

            function renderRecentChallans(rows) {
                rows = rows || [];
                if (!rows.length) {
                    return '<div class="wb-empty">No recent challans found.</div>';
                }

                var html = '<div class="table-responsive"><table class="table wb-table align-middle mb-0"><thead><tr><th>Challan No</th><th>Consumer</th><th>Purpose</th><th>Amount</th><th>Status</th></tr></thead><tbody>';
                rows.forEach(function (r) {
                    html += '<tr>' +
                        '<td>' + (r.url ? '<a class="wb-link" href="' + escapeHtml(r.url) + '">' + escapeHtml(r.challanNo || '') + '</a>' : escapeHtml(r.challanNo || '')) + '</td>' +
                        '<td>' + escapeHtml(r.consumerNo || '-') + '</td>' +
                        '<td>' + escapeHtml(r.purpose || '') + '</td>' +
                        '<td>' + escapeHtml(formatCompactCurrency(r.amount || 0)) + '</td>' +
                        '<td><span class="badge ' + toneClass(r.statusTone || toneFromStatus(r.status)) + '">' + escapeHtml(r.status || '') + '</span></td>' +
                    '</tr>';
                });
                html += '</tbody></table></div>';
                return html;
            }

            function renderApprovalQueue(rows) {
                rows = rows || [];
                if (!rows.length) {
                    return '<div class="wb-empty">No pending approvals found.</div>';
                }

                var html = '<div class="table-responsive"><table class="table wb-table align-middle mb-0"><thead><tr><th>Application No</th><th>Applicant</th><th>Stage</th><th>Assigned To</th><th>Age</th></tr></thead><tbody>';
                rows.forEach(function (r) {
                    html += '<tr>' +
                        '<td>' + (r.url ? '<a class="wb-link" href="' + escapeHtml(r.url) + '">' + escapeHtml(r.applicationNo || '') + '</a>' : escapeHtml(r.applicationNo || '')) + '</td>' +
                        '<td>' + escapeHtml(r.applicantName || '-') + '</td>' +
                        '<td>' + escapeHtml(r.stageName || '') + '</td>' +
                        '<td>' + escapeHtml(r.assignedTo || '-') + '</td>' +
                        '<td><span class="badge wb-badge-warning">' + escapeHtml(String(r.daysSinceAssigned || 0)) + ' day(s)</span></td>' +
                    '</tr>';
                });
                html += '</tbody></table></div>';
                return html;
            }

            function loadDashboardPanel(panel) {
                if (!panel || panel.getAttribute('data-loaded') === 'true') return Promise.resolve();

                var endpoint = panel.getAttribute('data-endpoint');
                var container = panel.querySelector('[data-dashboard-content]');
                if (!endpoint || !container) return Promise.resolve();

                container.innerHTML = '<div class="wb-dashboard-loading">Loading...</div>';

                return fetch(endpoint, { credentials: 'same-origin' })
                    .then(function (response) {
                        if (!response.ok) throw new Error('Dashboard tab request failed');
                        return response.json();
                    })
                    .then(function (data) {
                        var html = '';
                        var key = panel.getAttribute('data-dashboard-panel');
                        if (key === 'recent-activity') html = renderRecentActivity(data || []);
                        else if (key === 'recent-queries') html = renderRecentQueries(data || []);
                        else if (key === 'recent-challans') html = renderRecentChallans(data || []);
                        else if (key === 'current-approval-queue') html = renderApprovalQueue(data || []);
                        else if (key === 'recent-applications') html = renderRecentApplications(data || []);
                        container.innerHTML = html;
                        panel.setAttribute('data-loaded', 'true');
                    })
                    .catch(function () {
                        container.innerHTML = '<div class="wb-widget-shell-empty">Unable to load dashboard section.</div>';
                    });
            }

            function initDashboardTabs() {
                var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-dashboard-tab]'));
                var panels = Array.prototype.slice.call(document.querySelectorAll('[data-dashboard-panel]'));
                if (!tabs.length || !panels.length) return;

                tabs.forEach(function (tab) {
                    tab.addEventListener('click', function () {
                        var key = tab.getAttribute('data-dashboard-tab');

                        tabs.forEach(function (item) {
                            var active = item === tab;
                            item.classList.toggle('is-active', active);
                            item.setAttribute('aria-selected', active ? 'true' : 'false');
                        });

                        panels.forEach(function (panel) {
                            var active = panel.getAttribute('data-dashboard-panel') === key;
                            panel.classList.toggle('is-active', active);
                            panel.hidden = !active;
                        });

                        var activePanel = panels.find(function (panel) {
                            return panel.getAttribute('data-dashboard-panel') === key;
                        });
                        if (activePanel) {
                            loadDashboardPanel(activePanel);
                        }
                    });
                });
            }

            document.addEventListener('DOMContentLoaded', function () {
                initChart('appStatusChart', window._appStatusData);
                initChart('challanStatusChart', window._challanStatusData);
                initDashboardTabs();
                scheduleLazyLoad(loadAdminWidgets);
            });
        })();
    </script>
}

