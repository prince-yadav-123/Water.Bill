@model Water.Bill.API.Models.Approvals.ApprovalDetailsViewModel
@using System.Globalization
@{
    var app = Model.NewConnectionApplication;
    var ndc = Model.NdcApplication;
    var legacy = Model.LegacyApplication;
    var legacyDetail = Model.LegacyDetailValues;
    var task = Model.Task;
    var fee = Model.Fee;
    var inr = CultureInfo.GetCultureInfo("en-IN");
    var isAdmin = ViewData["IsAdmin"] as bool? == true;
    // Pending check — admin bypasses IsActive (assignment) constraint but still needs status = Pending
    var isCurrentPendingTask = task.Status == "Pending"
        && task.WorkflowInstance.CurrentStageId == task.StageId
        && task.WorkflowInstance.IsActive
        && !task.WorkflowInstance.IsDeleted
        && (isAdmin || task.IsActive);   // ← admin can act on any pending task
    var canAcceptMoveNext = task.Stage.CanApprove && Model.CanMoveToNextStage;
    var canFinalApproval = task.Stage.IsFinalStage && task.Stage.CanApprove;
    var canReject = task.Stage.CanReject;
    var canSendBackToApplicant = task.Stage.CanSendBackToApplicant;
    var canSendBackToPrevious = task.Stage.CanSendBackToPrevious && !Model.IsFirstStage;
    var approveText = task.Stage.IsFinalStage ? "Final Approve" : "Approve & Move Next";
    var submittedOn = app?.SubmittedOn ?? app?.CreatedOn ?? ndc?.CreatedOn ?? legacy?.EnterDate?.ToDateTime(TimeOnly.MinValue);
    var applicantName = app?.ApplicantName ?? ndc?.ConsName ?? legacy?.ConName;
    var mobileNo = app?.MobileNumber ?? ndc?.MobileNo ?? legacy?.ConPhoneMobile;
    var currentStatus = app?.ApplicationStatus ?? ndc?.CurrentStatus ?? ndc?.FinalStatus ?? ndc?.Status ?? legacy?.ApplicationStatus ?? task.WorkflowInstance.CurrentStatus;
    var approvalTitle = task.WorkflowInstance.ApplicationType switch
    {
        Water.Bill.Infrastructure.Services.WorkflowService.ApplicationTypeNdc => "NDC Application Approval",
        Water.Bill.Infrastructure.Services.WorkflowService.ApplicationTypeNameTransfer => "Name Transfer / Mutation Approval",
        Water.Bill.Infrastructure.Services.WorkflowService.ApplicationTypeConnectionChange => "Connection Type / Category Change Approval",
        _ => "New Connection Approval"
    };

    string TextOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string? DetailValue(string key) => legacyDetail.TryGetValue(key, out var value) ? value : null;
    string DateTimeOrDash(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy hh:mm tt") : "-";
    string Money(decimal? value) => value.HasValue ? value.Value.ToString("C", inr) : "-";
    string DocumentInitials(string value) => string.IsNullOrWhiteSpace(value)
        ? "DC"
        : value.Trim()[..Math.Min(2, value.Trim().Length)].ToUpperInvariant();
    string StageStateClass(string state) => state switch
    {
        "Current" => "is-current",
        "Approved" => "is-done",
        "Rejected" => "is-rejected",
        _ => "is-waiting"
    };
    string StageStateLabel(string state) => state switch
    {
        "Current" => "Current",
        "Approved" => "Completed",
        "Rejected" => "Rejected",
        _ => "Waiting"
    };
    string StatusBadgeClass(string? status) => status switch
    {
        "Pending" or "UnderReview" or "Submitted"               => "text-bg-primary",
        "Approved" or "FinalConsumerCreated"                    => "text-bg-success",
        "Rejected"                                              => "text-bg-danger",
        "SentBackToApplicant" or "CorrectionRequired"           => "text-bg-warning text-dark",
        "Forwarded" or "SentBackToPrevious"                     => "text-bg-info text-dark",
        _                                                       => "text-bg-secondary"
    };

    string FriendlyAction(string? action) => action switch
    {
        "WorkflowStarted"      => "Workflow Started",
        "AcceptMoveNext"       => "Accept & Move Next",
        "FinalApproval"        => "Final Approval",
        "Approved"             => "Approved",
        "MoveNext"             => "Moved to Next Stage",
        "Rejected"             => "Rejected",
        "ForwardToUser"        => "Forwarded to Specific User",
        "SendBackToApplicant"  => "Sent Back to Applicant",
        "CorrectionRequired"   => "Sent Back for Correction",
        "SendBackToPrevious"   => "Sent Back to Previous Stage",
        "StageAssigned"        => "Stage Assigned",
        "FinalConsumerCreated" => "Final Consumer Created",
        null or "" => "-",
        _ => action!
    };

    string FriendlyRole(string? role) => role switch
    {
        "PublicApplicant" => "Applicant",
        null or "" => "",
        _ => role!
    };

    string TimelineActorLabel(Water.Bill.Infrastructure.Data.Entities.ApplicationWorkflowHistory item)
    {
        if (string.Equals(item.ActionByRole, "PublicApplicant", StringComparison.OrdinalIgnoreCase))
        {
            var applicantBits = new[] { applicantName, mobileNo }
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToArray();
            return applicantBits.Length == 0
                ? "System (Applicant)"
                : $"{string.Join(" / ", applicantBits)} (Applicant)";
        }

        if (!string.IsNullOrWhiteSpace(item.ActionByName))
        {
            return string.IsNullOrWhiteSpace(FriendlyRole(item.ActionByRole))
                ? item.ActionByName
                : $"{item.ActionByName} ({FriendlyRole(item.ActionByRole)})";
        }

        return "System";
    }

    string ActionBadgeClass(string? action) => action switch
    {
        "WorkflowStarted" or "StageAssigned"             => "text-bg-primary",
        "AcceptMoveNext" or "MoveNext" or "Approved"     => "text-bg-success",
        "FinalApproval" or "FinalConsumerCreated"        => "text-bg-success",
        "Rejected"                                        => "text-bg-danger",
        "ForwardToUser"                                   => "text-bg-info",
        "SendBackToApplicant" or "CorrectionRequired"    => "text-bg-warning text-dark",
        "SendBackToPrevious"                              => "text-bg-secondary",
        _                                                 => "text-bg-light text-dark"
    };

    var stageNamesById = Model.StageProgress
        .Where(x => x.Stage is not null)
        .GroupBy(x => x.Stage.Id)
        .ToDictionary(x => x.Key, x => x.First().Stage.StageName);
}

<div class="wb-page-head">
    <div>
        <h1>@approvalTitle</h1>
        <p>@task.ApplicationNo - @task.Stage.StageName</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Pending">Back to Applications</a>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        <strong>@successMessage</strong>
        @if (TempData["FinalConsumerNo"] is string consumerNo)
        {
            <div>Final Consumer No: <span class="fw-bold">@consumerNo</span></div>
        }
    </div>
}

<section class="wb-approval-summary-card">
    <div class="wb-approval-summary-head">
        <div>
            <p class="wb-kicker">Authority Review Copy</p>
            @* <h2>Noida Jal New Connection Application</h2> *@
            <span>Submitted application details for authority approval.</span>
        </div>
        <span class="badge @StatusBadgeClass(currentStatus)">
            @currentStatus
        </span>
    </div>
    <div class="wb-approval-summary-grid">
        <div><span>Application No</span><strong>@task.ApplicationNo</strong></div>
        <div><span>Applicant Name</span><strong>@TextOrDash(applicantName)</strong></div>
        <div><span>Submitted Date</span><strong>@DateTimeOrDash(submittedOn)</strong></div>
        <div><span>Fee / Payment</span><strong>@(fee is null ? "-" : $"{fee.PaymentStatus} - {fee.TotalAmount.ToString("C", inr)}")</strong></div>
        <div><span>Current Status</span><strong>@currentStatus</strong></div>
        <div><span>Current Stage</span><strong>@task.Stage.StageName</strong></div>
    </div>
    @if (app is not null
        && string.Equals(app.ApplicationStatus, "FinalConsumerCreated", StringComparison.OrdinalIgnoreCase)
        && !string.IsNullOrWhiteSpace(app.FinalConsumerNo))
    {
        <div class="wb-final-consumer-banner">
            Application approved successfully. Final Consumer No: <strong>@app.FinalConsumerNo</strong>
        </div>
    }
</section>

<section class="wb-page-card wb-admin-card wb-approval-section">
    <div class="wb-section-head-compact">
        <div>
            <p class="wb-kicker">Workflow Progress</p>
            <h2>Approval Path</h2>
        </div>
    </div>
    <div class="wb-approval-stage-grid">
        @foreach (var stage in Model.StageProgress)
        {
            <div class="wb-approval-stage @StageStateClass(stage.State)">
                <div class="wb-approval-stage-top">
                    <span>@stage.Stage.StageOrder</span>
                    <strong>@StageStateLabel(stage.State)</strong>
                </div>
                <h3>@stage.Stage.StageName</h3>
                <p>Role-based assignment</p>
                <small>Role/User: @stage.RoleName / @stage.UserName</small>
                @if (stage.Task?.ActionOn is not null)
                {
                    <small>Action: @stage.Task.ActionOn.Value.ToString("dd MMM yyyy hh:mm tt")</small>
                }
            </div>
        }
    </div>
</section>

@if (app is not null)
{
    <section class="wb-application-paper">
        <div class="wb-application-paper-title">
            <h2>Review Application Form</h2>
            <p>Submitted form data organized for authority review.</p>
        </div>

        <div class="wb-paper-section">
            <h3>Application & Payment Details</h3>
            <table class="wb-review-table">
                <tbody>
                    <tr><th>Application No</th><td>@app.ApplicationNo</td><th>Application Date</th><td>@DateTimeOrDash(submittedOn)</td></tr>
                    <tr><th>Payment Ref No</th><td>-</td><th>Paid Amount</th><td>@Money(fee?.TotalAmount)</td></tr>
                    <tr><th>Applied From</th><td>@(app.IsPublicApplication ? "Public Portal" : "Consumer Portal")</td><th>Payment Status</th><td>@TextOrDash(fee?.PaymentStatus)</td></tr>
                    <tr><th>Final Consumer No</th><td>@TextOrDash(app.FinalConsumerNo)</td><th>Current Status</th><td>@app.ApplicationStatus</td></tr>
                </tbody>
            </table>
        </div>

        <div class="wb-paper-section">
            <h3>Applicant Details</h3>
            <table class="wb-review-table">
                <tbody>
                    <tr><th>Applicant Name</th><td>@app.ApplicantName</td><th>Father Name</th><td>@TextOrDash(app.FatherName)</td></tr>
                    <tr><th>Mobile No</th><td>@app.MobileNumber</td><th>Email</th><td>@TextOrDash(app.EmailId)</td></tr>
                    <tr><th>Applicant Address</th><td colspan="3">@app.Address</td></tr>
                </tbody>
            </table>
        </div>

        <div class="wb-paper-section">
            <h3>Property Details</h3>
            <table class="wb-review-table">
                <tbody>
                    <tr><th>Sector</th><td>@app.Sector</td><th>Block</th><td>@app.Block</td></tr>
                    <tr><th>Plot / Flat No</th><td>@app.FlatNo</td><th>Plot Size</th><td>@app.PlotSize</td></tr>
                    <tr><th>Khasra No</th><td>@TextOrDash(app.KhasraNo)</td><th>Village</th><td>@TextOrDash(app.VillageName)</td></tr>
                    <tr><th>Installation Address</th><td colspan="3">@app.Address</td></tr>
                </tbody>
            </table>
        </div>

        <div class="wb-paper-section">
            <h3>Connection Details</h3>
            <table class="wb-review-table">
                <tbody>
                    <tr><th>Connection Category</th><td>@app.ConnectionCategory</td><th>Connection Type</th><td>@app.ConnectionType</td></tr>
                    <tr><th>Flat Type</th><td>@app.FlatType</td><th>Pipe Size</th><td>@(app.PipeSize?.ToString() ?? "-")</td></tr>
                    <tr><th>Purpose</th><td>@TextOrDash(app.PurposeOfConnection)</td><th>Division</th><td>@TextOrDash(Water.Bill.Core.Common.AppConstants.Divisions.FormatDisplay(app.DevType))</td></tr>
                    <tr><th>Previous Connection</th><td>@TextOrDash(app.PreviousConnectionYesNo)</td><th>Other Connection</th><td>@TextOrDash(app.OtherConnection)</td></tr>
                </tbody>
            </table>
        </div>

        <div class="wb-paper-section">
            <h3>Uploaded Documents</h3>
            @if (app.Documents.Where(x => !x.IsDeleted).Any())
            {
                <div class="wb-document-rows">
                    @foreach (var document in app.Documents.Where(x => !x.IsDeleted).OrderBy(x => x.DocumentType))
                    {
                        <div class="wb-document-mini-row">
                            <span>@DocumentInitials(document.DocumentType)</span>
                            <div>
                                <strong>@document.DocumentType</strong>
                                <small>@(document.FileName ?? document.FilePath ?? "Uploaded")</small>
                            </div>
                            <em>@document.UploadedOn.ToString("dd MMM yyyy")</em>
                            @if (!string.IsNullOrWhiteSpace(document.FilePath))
                            {
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@Url.Action("Document", "Approvals", new { taskId = Model.Task.Id, documentId = document.Id })"
                                   target="_blank"
                                   rel="noopener">View</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" type="button" disabled>View</button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="wb-empty">No documents uploaded.</div>
            }
        </div>

        <div class="wb-paper-section">
            <h3>Declaration</h3>
            <table class="wb-review-table">
                <tbody>
                    <tr><th>Declaration</th><td colspan="3">@(app.DeclarationAccepted ? "Applicant accepted the declaration while submitting this application." : "Declaration not accepted.")</td></tr>
                    <tr><th>Submitted By</th><td>@app.ApplicantName</td><th>Submitted Date</th><td>@DateTimeOrDash(submittedOn)</td></tr>
                    <tr><th>Applicant Remarks</th><td colspan="3">@TextOrDash(app.Remarks)</td></tr>
                </tbody>
            </table>
        </div>
    </section>
}
else if (ndc is not null)
{
    <section class="wb-application-paper">
        <div class="wb-application-paper-title">
            <h2>NDC Review Application</h2>
            <p>No dues application details organized for authority review.</p>
        </div>

        <div class="wb-paper-section">
            <h3>Application & Payment Details</h3>
            <table class="wb-review-table">
                <tbody>
                    <tr><th>Application No</th><td>@ndc.ApplicationNo</td><th>Application Date</th><td>@DateTimeOrDash(ndc.CreatedOn)</td></tr>
                    <tr><th>Consumer No</th><td>@TextOrDash(ndc.ConsumerNo)</td><th>RID</th><td>@TextOrDash(ndc.Rid)</td></tr>
                    <tr><th>Challan No</th><td>@TextOrDash(ndc.ChallanNo)</td><th>Amount</th><td>@(ndc.Amount?.ToString("N2") ?? "-")</td></tr>
                    <tr><th>Payment Status</th><td>@TextOrDash(ndc.SuccessStatus)</td><th>Payment Date</th><td>@DateTimeOrDash(ndc.PaymentSuccessDate)</td></tr>
                </tbody>
            </table>
        </div>

        <div class="wb-paper-section">
            <h3>Consumer Details</h3>
            <table class="wb-review-table">
                <tbody>
                    <tr><th>Consumer Name</th><td>@TextOrDash(ndc.ConsName)</td><th>Mobile No</th><td>@TextOrDash(ndc.MobileNo)</td></tr>
                    <tr><th>Email</th><td>@TextOrDash(ndc.Email)</td><th>Division</th><td>@TextOrDash(ndc.DivisionTypeName)</td></tr>
                    <tr><th>Sector</th><td>@TextOrDash(ndc.Sector)</td><th>Block / Plot</th><td>@TextOrDash($"{ndc.Block}-{ndc.PlotNo}".Trim('-'))</td></tr>
                    <tr><th>Plot Area</th><td>@TextOrDash(ndc.PlotArea)</td><th>Pipe Size</th><td>@TextOrDash(ndc.PipeSize)</td></tr>
                </tbody>
            </table>
        </div>

        <div class="wb-paper-section">
            <h3>Uploaded Documents</h3>
            @if (Model.NdcDocuments.Count == 0)
            {
                <div class="wb-empty">No documents uploaded.</div>
            }
            else
            {
                <div class="wb-document-rows">
                    @foreach (var document in Model.NdcDocuments)
                    {
                        <div class="wb-document-mini-row">
                            <span>ND</span>
                            <div>
                                <strong>@TextOrDash(document.AttachmentName)</strong>
                                <small>@TextOrDash(document.AttachmentPath)</small>
                            </div>
                            <em>@DateTimeOrDash(document.CreatedOn)</em>
                            @if (!string.IsNullOrWhiteSpace(document.AttachmentPath))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="@document.AttachmentPath" target="_blank" rel="noopener">View</a>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}
else if (legacy is not null)
{
    <section class="wb-application-paper">
        <div class="wb-application-paper-title">
            <h2>@(task.WorkflowInstance.ApplicationType == Water.Bill.Infrastructure.Services.WorkflowService.ApplicationTypeNameTransfer ? "Name Transfer / Mutation Request" : "Connection Type / Category Change Request")</h2>
            <p>Submitted consumer service request details organized for authority review.</p>
        </div>

        <div class="wb-paper-section">
            <h3>Application Details</h3>
            <table class="wb-review-table">
                <tbody>
                    <tr><th>Application No</th><td>@legacy.ApplicationId</td><th>Application Date</th><td>@(legacy.EnterDate?.ToString("dd MMM yyyy") ?? "-")</td></tr>
                    <tr><th>Consumer No</th><td>@TextOrDash(legacy.ConsNo)</td><th>Mobile No</th><td>@TextOrDash(legacy.ConPhoneMobile)</td></tr>
                    <tr><th>Applicant / New Name</th><td>@TextOrDash(legacy.ConName)</td><th>Current Status</th><td>@TextOrDash(legacy.ApplicationStatus)</td></tr>
                    <tr><th>Division</th><td>@TextOrDash(legacy.DivName)</td><th>Application Type</th><td>@TextOrDash(legacy.AppType)</td></tr>
                </tbody>
            </table>
        </div>

        <div class="wb-paper-section">
            <h3>Property Details</h3>
            <table class="wb-review-table">
                <tbody>
                    <tr><th>Sector</th><td>@TextOrDash(legacy.SectorVill)</td><th>Block</th><td>@TextOrDash(legacy.Block)</td></tr>
                    <tr><th>Plot / Flat No</th><td>@TextOrDash(legacy.PlotNo)</td><th>Plot Area</th><td>@TextOrDash(legacy.PlotArea)</td></tr>
                    <tr><th>Pipe Size</th><td>@TextOrDash(legacy.PipeSize)</td><th>Previous Detail</th><td>@TextOrDash(legacy.PrevConDetail)</td></tr>
                    <tr><th>Address</th><td colspan="3">@TextOrDash(legacy.ConAddress)</td></tr>
                </tbody>
            </table>
        </div>

        <div class="wb-paper-section">
            <h3>Requested Change</h3>
            <table class="wb-review-table">
                <tbody>
                    @if (task.WorkflowInstance.ApplicationType == Water.Bill.Infrastructure.Services.WorkflowService.ApplicationTypeNameTransfer)
                    {
                        <tr><th>Old Name</th><td>@TextOrDash(DetailValue("OldName"))</td><th>New Name</th><td>@TextOrDash(DetailValue("NewName") ?? legacy.ConName)</td></tr>
                        <tr><th>Old Father / Name2</th><td>@TextOrDash(DetailValue("OldFather"))</td><th>New Father / Name2</th><td>@TextOrDash(DetailValue("NewFather"))</td></tr>
                        <tr><th>Transfer Fee</th><td>@TextOrDash(DetailValue("TransferFee"))</td><th>Security Amount</th><td>@TextOrDash(DetailValue("SecurityAmount"))</td></tr>
                        <tr><th>Challan No</th><td>@TextOrDash(DetailValue("ChallanNo"))</td><th>Challan Date</th><td>@TextOrDash(DetailValue("ChallanDate"))</td></tr>
                    }
                    else
                    {
                        <tr><th>Old Connection Type</th><td>@TextOrDash(DetailValue("OldConnectionType"))</td><th>New Connection Type</th><td>@TextOrDash(DetailValue("NewConnectionType") ?? legacy.ConnType)</td></tr>
                        <tr><th>Old Category</th><td>@TextOrDash(DetailValue("OldCategory"))</td><th>New Category</th><td>@TextOrDash(DetailValue("NewCategory") ?? legacy.PropertyType)</td></tr>
                        <tr><th>Estimation No</th><td>@TextOrDash(DetailValue("EstimationNo"))</td><th>Estimation Amount</th><td>@TextOrDash(DetailValue("EstimationAmount"))</td></tr>
                        <tr><th>Security Amount</th><td>@TextOrDash(DetailValue("SecurityAmount"))</td><th>Monthly Rate</th><td>@TextOrDash(DetailValue("MonthlyRate"))</td></tr>
                    }
                    <tr><th>Remarks</th><td colspan="3">@TextOrDash(DetailValue("Remarks"))</td></tr>
                </tbody>
            </table>
        </div>
    </section>
}

<section class="wb-page-card wb-admin-card wb-approval-section">
    <div class="wb-section-head-compact">
        <div>
            <p class="wb-kicker">Fee / Payment Summary</p>
            <h2>Payment Details</h2>
        </div>
        @if (fee is not null)
        {
            <span class="badge @StatusBadgeClass(fee.PaymentStatus)">@fee.PaymentStatus</span>
        }
    </div>
    @if (fee is not null)
    {
        <div class="wb-fee-summary-list">
            <div><span>Application Fee</span><strong>@fee.ApplicationFee.ToString("C", inr)</strong></div>
            <div><span>Processing Fee</span><strong>@fee.ProcessingFee.ToString("C", inr)</strong></div>
            <div><span>Security Amount</span><strong>@fee.SecurityAmount.ToString("C", inr)</strong></div>
            <div><span>Meter Installation</span><strong>@fee.MeterInstallationFee.ToString("C", inr)</strong></div>
            <div><span>Other Charges</span><strong>@fee.OtherCharges.ToString("C", inr)</strong></div>
            <div class="is-total"><span>Total Paid / Payable</span><strong>@fee.TotalAmount.ToString("C", inr)</strong></div>
        </div>
    }
    else
    {
        <div class="wb-empty">No fee record found.</div>
    }
</section>

<section class="wb-page-card wb-admin-card wb-approval-section">
    <div class="wb-section-head-compact">
        <div>
            <p class="wb-kicker">Remarks & Workflow History</p>
            <h2>Approval Timeline</h2>
        </div>
    </div>
    @if (Model.WorkflowTimeline.Count == 0)
    {
        <div class="wb-empty">No workflow history found.</div>
    }
    else
    {
        <div class="wb-approval-history">
            @foreach (var item in Model.WorkflowTimeline)
            {
                <div class="wb-approval-history-item">
                    <span class="wb-history-dot @ActionBadgeClass(item.Action)"></span>
                    <div class="wb-history-content">
                        <div class="wb-history-head">
                            <div class="wb-history-title-wrap">
                                <strong>@FriendlyAction(item.Action)</strong>
                                <span class="badge @ActionBadgeClass(item.Action) wb-history-code">@item.Action</span>
                            </div>
                            <small class="wb-history-time">@item.ActionOn.ToString("dd MMM yyyy hh:mm tt")</small>
                        </div>
                        <small class="text-muted">@(item.FromStatus ?? "-") → @item.ToStatus</small>
                        <div class="wb-history-meta">
                            <small class="text-muted"><strong>By:</strong> @TimelineActorLabel(item)</small>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Remarks))
                        {
                            <div class="wb-history-remarks"><strong>Remarks:</strong> @item.Remarks</div>
                        }
                        @if (string.Equals(item.Action, "FinalConsumerCreated", StringComparison.OrdinalIgnoreCase)
                            && !string.IsNullOrWhiteSpace(app?.FinalConsumerNo))
                        {
                            <div class="wb-history-extra">
                                <span>Consumer No:</span>
                                <strong>@app.FinalConsumerNo</strong>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@if (isCurrentPendingTask)
{
    <section class="wb-page-card wb-admin-card wb-approval-section wb-current-action-card">
        <div class="wb-section-head-compact">
            <div>
                <p class="wb-kicker">Current Stage Action</p>
                <h2>@task.Stage.StageName</h2>
                @if (isAdmin)
                {
                    <small class="text-muted">Admin override — you can act on any pending task.</small>
                }
            </div>
            <div class="d-flex gap-2 flex-wrap">
                @if (canAcceptMoveNext) { <span class="badge text-bg-success-subtle text-success-emphasis" style="font-size:.72rem">Accept &amp; Move Next</span> }
                @if (canFinalApproval) { <span class="badge text-bg-success-subtle text-success-emphasis" style="font-size:.72rem">Final Approval</span> }
                @if (canReject) { <span class="badge text-bg-danger-subtle text-danger-emphasis" style="font-size:.72rem">Reject</span> }
                @if (canSendBackToApplicant) { <span class="badge text-bg-warning-subtle text-warning-emphasis" style="font-size:.72rem">Send Back to Applicant</span> }
                @if (canSendBackToPrevious) { <span class="badge text-bg-secondary-subtle text-secondary-emphasis" style="font-size:.72rem">Send Back to Previous</span> }
            </div>
        </div>

        <form asp-action="Action" method="post" id="wfActionForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="taskId" value="@task.Id" />
            <input type="hidden" name="actionType" id="wfActionTypeInput" value="" />

            @* Remarks *@
            <div class="mb-3">
                <label class="form-label fw-semibold">
                    Remarks / Comments <span class="text-danger">*</span>
                </label>
                <textarea name="remarks" id="wfRemarks" class="form-control" rows="3" maxlength="500"
                          placeholder="Remarks are required for every action. Describe your review decision clearly."></textarea>
                <div class="invalid-feedback" id="remarksError">
                    Please enter remarks before taking this action.
                </div>
            </div>

            @* Forward to Specific User: removed for this phase — forwardToUserId always empty *@
            <input type="hidden" name="forwardToUserId" value="" />

            @* ── Action buttons (5 allowed actions for current phase) ── *@
            <div class="wb-action-btn-grid">

                @* 1. Accept & Move Next
                   Condition: CanApprove=true AND there are higher-order stages (CanMoveToNextStage).
                   BUG FIX: was using !IsFinalStage which hid this button when both CanApprove
                   and IsFinalStage were checked simultaneously. Now uses CanMoveToNextStage. *@
                @if (canAcceptMoveNext)
                {
                    <button type="button" class="btn btn-success wf-action-btn"
                            data-action="AcceptMoveNext"
                            data-label="Accept &amp; Move Next"
                            data-msg="The application will be accepted and moved to the next workflow stage. The next stage authority will be notified via In-App notification."
                            data-icon="✓"
                            data-btn-class="btn-success">
                        ✓ Accept &amp; Move Next
                    </button>
                }

                @* 2. Final Approval — shown when stage is marked as IsFinalStage *@
                @if (canFinalApproval)
                {
                    <button type="button" class="btn btn-success wf-action-btn"
                            data-action="FinalApproval"
                            data-label="Final Approval"
                            data-msg="This is the final stage. The application will be finally approved, the workflow will be completed, and the consumer number will be generated if applicable."
                            data-icon="★"
                            data-btn-class="btn-success">
                        ★ Final Approval
                    </button>
                }

                @* 3. Reject *@
                @if (canReject)
                {
                    <button type="button" class="btn btn-danger wf-action-btn"
                            data-action="Reject"
                            data-label="Reject Application"
                            data-msg="The application will be rejected and the workflow will stop. Remarks are mandatory and will be visible to the applicant."
                            data-icon="✕"
                            data-btn-class="btn-danger">
                        ✕ Reject
                    </button>
                }

                @* 4. Send Back to Applicant *@
                @if (canSendBackToApplicant)
                {
                    <button type="button" class="btn btn-warning wf-action-btn"
                            data-action="SendBackToApplicant"
                            data-label="Send Back to Applicant"
                            data-msg="The application will be returned to the consumer/applicant for correction. They will be notified and can resubmit without paying the fee again."
                            data-icon="↩"
                            data-btn-class="btn-warning">
                        ↩ Send Back to Applicant
                    </button>
                }

                @* 5. Send Back to Previous Stage — hidden on first stage (no previous stage exists) *@
                @if (canSendBackToPrevious)
                {
                    <button type="button" class="btn btn-secondary wf-action-btn"
                            data-action="SendBackToPrevious"
                            data-label="Send Back to Previous Stage"
                            data-msg="The application will be sent back to the previous workflow stage for re-review. The previous stage authority will be notified via In-App notification."
                            data-icon="←"
                            data-btn-class="btn-secondary">
                        ← Send Back to Previous Stage
                    </button>
                }

                @* Debug info for admin when expected buttons are hidden *@
                @if (isAdmin && !canAcceptMoveNext && !canFinalApproval && !canReject && !canSendBackToApplicant && !canSendBackToPrevious)
                {
                    <div class="alert alert-warning mb-0 mt-1 w-100" style="font-size:.85rem">
                        <strong>Admin Note:</strong> No allowed actions are configured for stage "<strong>@task.Stage.StageName</strong>".
                        Please edit the workflow stage and enable at least one action.
                    </div>
                }
            </div>
        </form>
    </section>
}
else if (task.Status == "Pending" && task.WorkflowInstance.IsActive)
{
    @* Task is pending but not assigned to current user (non-admin cannot act) *@
    <section class="wb-page-card wb-admin-card wb-approval-section">
        <div class="alert alert-info mb-0">
            <strong>Awaiting your stage:</strong>
            This application is currently pending at <strong>@task.Stage.StageName</strong>.
            Action buttons are available only to the assigned user or role.
        </div>
    </section>
}

@* ── Custom Workflow Confirmation Modal ── *@
<div class="modal fade" id="wfConfirmModal" tabindex="-1" aria-labelledby="wfConfirmModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:460px">
        <div class="modal-content border-0 shadow-lg" style="border-radius:1.1rem;overflow:hidden">
            <div class="modal-header border-0 pb-2" id="wfModalHeader" style="padding:1.25rem 1.5rem .75rem">
                <div class="d-flex align-items-center gap-2">
                    <span id="wfModalIcon" class="wf-modal-icon"></span>
                    <h5 class="modal-title fw-bold mb-0" id="wfConfirmModalTitle" style="font-size:1.05rem"></h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding:1rem 1.5rem 1.25rem">
                <p id="wfModalMsg" class="mb-0" style="color:#475569;font-size:.92rem;line-height:1.55"></p>
                <div id="wfModalRemarksPreview" class="mt-3 p-3 rounded-2" style="display:none;background:#f8fafc;border-left:3px solid #e2e8f0">
                    <div class="fw-semibold mb-1" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8">Your Remarks</div>
                    <p id="wfModalRemarksText" class="mb-0" style="font-size:.88rem;color:#334155"></p>
                </div>
                @* Forward preview removed — Forward to Specific User disabled for current phase *@
            </div>
            <div class="modal-footer border-0 pt-0" style="padding:.75rem 1.5rem 1.25rem;gap:.5rem">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="font-size:.88rem">
                    Cancel
                </button>
                <button type="button" id="wfModalConfirmBtn" class="btn" style="font-size:.88rem;min-width:130px">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .wb-action-btn-grid { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1rem; }
    .wb-action-btn-grid .btn { font-size: .88rem; padding: .5rem 1.1rem; font-weight: 600; }
    .wb-history-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; margin-top: 4px; display: inline-block; }
    .wb-approval-history { display: grid; gap: 10px; }
    .wb-approval-history-item {
        display: grid;
        grid-template-columns: 16px minmax(0, 1fr);
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid #e2e8f0;
    }
    .wb-approval-history-item:last-child { border-bottom: 0; padding-bottom: 0; }
    .wb-history-content { min-width: 0; }
    .wb-history-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }
    .wb-history-title-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        min-width: 0;
    }
    .wb-history-title-wrap strong { font-size: .94rem; color: #0f172a; }
    .wb-history-code { font-size: .69rem !important; }
    .wb-history-time {
        color: #64748b !important;
        font-size: .76rem !important;
        white-space: nowrap;
        flex-shrink: 0;
        margin-top: 1px;
    }
    .wb-history-content > small.text-muted.d-block { display: none; }
    .wb-history-meta small,
    .wb-history-content > small.text-muted {
        display: block;
        margin-top: 3px;
        color: #64748b;
        font-size: .79rem;
        line-height: 1.45;
    }
    .wb-history-remarks {
        margin-top: 6px;
        padding: 7px 10px;
        background: #f8fafc;
        border-left: 3px solid #e2e8f0;
        border-radius: 0 8px 8px 0;
        font-size: .84rem;
        color: #475569;
        line-height: 1.45;
    }
    .wb-history-extra {
        margin-top: 6px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        background: #ecfdf5;
        color: #166534;
        font-size: .8rem;
    }
    .wf-modal-icon { font-size: 1.3rem; line-height: 1; }
    #wfConfirmModal.is-open {
        display: block;
        background: rgba(15, 23, 42, .54);
        backdrop-filter: blur(2px);
    }
    #wfConfirmModal .modal-dialog {
        margin: 1.75rem auto;
        min-height: calc(100% - 3.5rem);
        display: flex;
        align-items: center;
    }
    #wfConfirmModal .btn-close {
        filter: invert(1);
        opacity: .92;
    }
    #wfConfirmModal .modal-header.action-accept  { background: linear-gradient(135deg, #15803d, #16a34a); color:#fff; }
    #wfConfirmModal .modal-header.action-final   { background: linear-gradient(135deg, #065f46, #059669); color:#fff; }
    #wfConfirmModal .modal-header.action-reject  { background: linear-gradient(135deg, #991b1b, #dc2626); color:#fff; }
    #wfConfirmModal .modal-header.action-sendback { background: linear-gradient(135deg, #92400e, #d97706); color:#fff; }
    #wfConfirmModal .modal-header.action-previous { background: linear-gradient(135deg, #1e293b, #475569); color:#fff; }
    @@media (max-width: 575.98px) {
        .wb-history-head { flex-direction: column; gap: 2px; }
        .wb-history-time { white-space: normal; }
    }
</style>

<script>
(function () {
    var remarksEl    = document.getElementById('wfRemarks');
    var errorEl      = document.getElementById('remarksError');
    var actionInput  = document.getElementById('wfActionTypeInput');
    var form         = document.getElementById('wfActionForm');

    var modalEl      = document.getElementById('wfConfirmModal');
    var modalHeader  = document.getElementById('wfModalHeader');
    var modalIcon    = document.getElementById('wfModalIcon');
    var modalTitle   = document.getElementById('wfConfirmModalTitle');
    var modalMsg     = document.getElementById('wfModalMsg');
    var modalRemark  = document.getElementById('wfModalRemarksPreview');
    var modalRemText = document.getElementById('wfModalRemarksText');
    var confirmBtn   = document.getElementById('wfModalConfirmBtn');
    var closeEls     = modalEl ? modalEl.querySelectorAll('[data-bs-dismiss="modal"], .btn-close') : [];
    var activeAction = null;

    // Action config for 5 allowed actions (Forward to Specific User removed for this phase)
    var actionConfig = {
        'AcceptMoveNext':     { icon:'✓', cls:'action-accept',   btnCls:'btn-success',   title:'Confirm: Accept & Move Next' },
        'FinalApproval':      { icon:'★', cls:'action-final',    btnCls:'btn-success',   title:'Confirm: Final Approval' },
        'Reject':             { icon:'✕', cls:'action-reject',   btnCls:'btn-danger',    title:'Confirm: Reject Application' },
        'SendBackToApplicant':{ icon:'↩', cls:'action-sendback', btnCls:'btn-warning',   title:'Confirm: Send Back to Applicant' },
        'SendBackToPrevious': { icon:'←', cls:'action-previous', btnCls:'btn-secondary', title:'Confirm: Send Back to Previous Stage' }
    };

    function validateRemarks() {
        var rem = remarksEl ? remarksEl.value.trim() : '';
        if (!rem) {
            if (remarksEl) { remarksEl.classList.add('is-invalid'); remarksEl.focus(); }
            if (errorEl)   { errorEl.style.display = 'block'; }
            return false;
        }
        if (remarksEl) remarksEl.classList.remove('is-invalid');
        if (errorEl)   errorEl.style.display = 'none';
        return true;
    }

    function closeModal() {
        if (!modalEl) return;
        modalEl.classList.remove('show', 'is-open');
        modalEl.style.display = 'none';
        modalEl.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
        activeAction = null;
    }

    function openModal() {
        if (!modalEl) return;
        modalEl.style.display = 'block';
        modalEl.classList.add('show', 'is-open');
        modalEl.removeAttribute('aria-hidden');
        document.body.classList.add('modal-open');
    }

    function showModal(actionValue, message) {
        var rem = remarksEl ? remarksEl.value.trim() : '';
        var cfg = actionConfig[actionValue] || { icon:'?', cls:'', btnCls:'btn-primary', title:'Confirm Action' };
        activeAction = actionValue;

        modalIcon.textContent = cfg.icon;
        modalTitle.textContent = cfg.title;
        modalMsg.textContent = message;
        modalHeader.className = 'modal-header border-0 pb-2 ' + cfg.cls;

        // Show remarks preview
        if (rem) {
            modalRemText.textContent = rem;
            modalRemark.style.display = 'block';
        } else {
            modalRemark.style.display = 'none';
        }

        // Confirm button
        confirmBtn.className = 'btn ' + cfg.btnCls;
        confirmBtn.textContent = cfg.title.replace('Confirm: ', '');
        openModal();
    }

    // Wire all action buttons via data-attributes
    document.querySelectorAll('.wf-action-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            if (!validateRemarks()) return;
            showModal(btn.dataset.action, btn.dataset.msg || 'Are you sure?');
        });
    });

    closeEls.forEach(function (el) {
        el.addEventListener('click', closeModal);
    });

    if (modalEl) {
        modalEl.addEventListener('click', function (event) {
            if (event.target === modalEl) {
                closeModal();
            }
        });
    }

    if (confirmBtn) {
        confirmBtn.addEventListener('click', function () {
            if (!activeAction || !validateRemarks() || !form || !actionInput) return;
            actionInput.value = activeAction;
            confirmBtn.disabled = true;
            closeModal();
            form.submit();
        });
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && modalEl && modalEl.classList.contains('is-open')) {
            closeModal();
        }
    });

    // Live remarks validation clear
    if (remarksEl) {
        remarksEl.addEventListener('input', function () {
            if (this.value.trim()) {
                this.classList.remove('is-invalid');
                if (errorEl) errorEl.style.display = 'none';
            }
        });
    }

    if (form) {
        form.addEventListener('submit', function () {
            if (confirmBtn) confirmBtn.disabled = true;
        });
    }
})();
</script>
