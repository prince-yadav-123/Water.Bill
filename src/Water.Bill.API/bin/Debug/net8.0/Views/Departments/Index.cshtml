@model IReadOnlyList<Water.Bill.Infrastructure.Data.Entities.MasterDeptDetail>

<div class="wb-page-head">
    <div>
        <h1>Department Master</h1>
        <p>Configure departments used by approval workflow stages.</p>
    </div>
    <div class="wb-actions">
        <form asp-action="ExportExcel" method="get">
            <button class="btn btn-outline-success" type="submit" require-permission="Department Master.view" data-no-loader>Download</button>
        </form>
        <a class="btn btn-primary" asp-action="Create">Add Department</a>
    </div>
</div>

<section class="wb-page-card wb-admin-card">
    <div class="wb-admin-toolbar">
        <div>
            <h2 class="wb-section-title">Departments</h2>
            <span>@Model.Count record@(Model.Count == 1 ? "" : "s")</span>
        </div>
        <div class="d-flex align-items-center gap-2 flex-nowrap wb-master-searchbar">
            <input id="departmentSearch" class="form-control wb-search flex-grow-1" type="search" placeholder="Search code, department, status" />
            <button type="button" class="btn btn-primary flex-shrink-0" onclick="applyDepartmentSearch()">Search</button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table align-middle wb-table wb-admin-table">
            <thead><tr><th>Code</th><th>Department</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                var searchText = $"{item.DeptId} {item.DeptName} {(item.Status == "1" ? "Active" : "Inactive")}".ToLowerInvariant();
                <tr class="department-row" data-search="@searchText">
                    <td><strong>@item.DeptId</strong></td>
                    <td>@item.DeptName</td>
                    <td><span class="badge @(item.Status == "1" ? "text-bg-success" : "text-bg-secondary")">@(item.Status == "1" ? "Active" : "Inactive")</span></td>
                    <td>
                        <div class="wb-row-actions justify-content-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm @(item.Status == "1" ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(item.Status == "1" ? "Delete" : "Activate")</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<style>
    .wb-master-searchbar {
        width: min(100%, 420px);
        margin-left: auto;
    }

    .wb-master-searchbar .wb-search {
        min-width: 0;
    }
</style>

@section Scripts {
<script>
function filterDepartments() {
    var q = (document.getElementById('departmentSearch').value || '').toLowerCase();
    document.querySelectorAll('.department-row').forEach(function(row) {
        row.style.display = row.dataset.search.includes(q) ? '' : 'none';
    });
}

function applyDepartmentSearch() {
    filterDepartments();
}

document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('departmentSearch');
    if (searchInput) {
        searchInput.addEventListener('keydown', function(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                applyDepartmentSearch();
            }
        });
    }
});
</script>
}
