@model Water.Bill.API.Models.ConsumerWorkflows.ConsumerSearchViewModel
@using Water.Bill.Core.Common
@{
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}

<div class="wb-page-head">
    <div>
        <h1>Select Consumer</h1>
        <p>Search an existing live consumer before creating a connection type/category change request.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<section class="wb-page-card wb-admin-card">
    <form method="get" class="wb-filter-bar wb-bill-filter-bar">
        <div class="wb-filter-field wb-filter-search">
            <label class="form-label">Search Consumer</label>
            <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Consumer no / name / mobile / plot" autofocus />
        </div>
        <div class="wb-filter-actions">
            <button class="btn btn-primary" type="submit">Search</button>
            <a class="btn btn-outline-secondary" asp-action="SearchConsumer">Reset</a>
        </div>
    </form>

    @if (string.IsNullOrWhiteSpace(Model.Search))
    {
        <div class="wb-empty mt-3">Enter consumer number, name, mobile, or plot number to search.</div>
    }
    else if (Model.Consumers.Count == 0)
    {
        <div class="wb-empty mt-3">No consumer found.</div>
    }
    else
    {
        <div class="table-responsive wb-approval-table-wrap mt-3">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Consumer No</th>
                        <th>Name</th>
                        <th>Mobile</th>
                        <th>Property</th>
                        <th>Connection</th>
                        <th>Division</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Consumers)
                {
                    <tr>
                        <td><strong>@row.ConsNo</strong></td>
                        <td>
                            <div>@Text(row.ConsNm1)</div>
                            <small class="text-muted">@Text(row.ConsNm2)</small>
                        </td>
                        <td>@Text(row.MobNo)</td>
                        <td>@Text($"{row.Sector}/{row.BlkNo}-{row.FlatNo}".Trim('/', '-'))</td>
                        <td>
                            <div>@Text(row.ConTp)</div>
                            <small class="text-muted">@Text(row.ConsCtg)</small>
                        </td>
                        <td><span class="badge text-bg-info">@AppConstants.Divisions.FormatDisplay(row.DevType)</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-primary" asp-action="Create" asp-route-consumerNo="@row.ConsNo">Create Request</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
