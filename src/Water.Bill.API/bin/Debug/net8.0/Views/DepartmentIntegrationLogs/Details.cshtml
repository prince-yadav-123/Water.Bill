@model Water.Bill.API.Models.DepartmentIntegration.DepartmentIntegrationLogDetailsViewModel
@{
    ViewData["Title"] = "Integration Log Details";
    string Badge(string s) => s switch
    {
        "Sent" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Failed" => "bg-danger",
        "Skipped" => "bg-secondary",
        _ => "bg-primary"
    };
}

<div class="wb-page-head">
    <div>
        <p class="wb-kicker">Integration</p>
        <h1>Integration Log Details</h1>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back to Logs</a>
        <form asp-action="Retry" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Retry this integration request now?')">
            @Html.AntiForgeryToken()
            <button class="btn btn-primary" type="submit">Retry</button>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-4">
        <section class="wb-page-card mb-3">
            <h2 class="wb-section-title mb-3">Summary</h2>
            <div class="wb-stat-row"><span>Application No</span><strong>@Model.ApplicationNo</strong></div>
            <div class="wb-stat-row"><span>Consumer No</span><strong>@(Model.ConsumerNo ?? "-")</strong></div>
            <div class="wb-stat-row"><span>Type</span><strong>@Model.ApplicationType</strong></div>
            <div class="wb-stat-row"><span>Status</span><span class="badge @Badge(Model.Status)">@Model.Status</span></div>
            <div class="wb-stat-row"><span>Attempts</span><strong>@Model.AttemptCount</strong></div>
            <div class="wb-stat-row"><span>Created</span><strong>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</strong></div>
            <div class="wb-stat-row"><span>Updated</span><strong>@(Model.UpdatedAt.HasValue ? Model.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm") : "-")</strong></div>
            <div class="wb-stat-row"><span>Sent</span><strong>@(Model.SentAt.HasValue ? Model.SentAt.Value.ToString("dd MMM yyyy HH:mm") : "-")</strong></div>
        </section>
    </div>

    <div class="col-12 col-xl-8">
        <section class="wb-page-card mb-3">
            <h2 class="wb-section-title mb-3">Endpoint / Error</h2>
            <div class="wb-stat-row"><span>Endpoint</span><strong class="text-break text-end">@(string.IsNullOrWhiteSpace(Model.EndpointUrl) ? "-" : Model.EndpointUrl)</strong></div>
            <div class="wb-stat-row"><span>Error</span><strong class="text-danger text-end">@(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "-" : Model.ErrorMessage)</strong></div>
        </section>

        <section class="wb-page-card mb-3">
            <h2 class="wb-section-title mb-2">Saved Payload</h2>
            <pre class="wb-json-box">@(Model.PayloadJson ?? "-")</pre>
        </section>

        <section class="wb-page-card">
            <h2 class="wb-section-title mb-2">Saved Response</h2>
            <pre class="wb-json-box">@(Model.ResponseJson ?? "-")</pre>
        </section>
    </div>
</div>

<style>
    .wb-section-title { font-size: 1rem; font-weight: 700; color: #0f172a; }
    .wb-stat-row { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid #f1f5f9; font-size: 0.9rem; }
    .wb-stat-row:last-child { border-bottom: none; }
    .wb-json-box { margin: 0; padding: 1rem; background: #0f172a; color: #e2e8f0; border-radius: .5rem; min-height: 220px; white-space: pre-wrap; word-break: break-word; }
</style>
