@model Water.Bill.API.Models.DepartmentIntegration.DepartmentIntegrationLogListViewModel
@{
    ViewData["Title"] = "Department Integration Logs";
    string Badge(string s) => s switch
    {
        "Sent" => "bg-success",
        "Pending" => "bg-warning text-dark",
        "Failed" => "bg-danger",
        "Skipped" => "bg-secondary",
        _ => "bg-primary"
    };
}

<div class="wb-page-head">
    <div>
        <p class="wb-kicker">Integration</p>
        <h1>Department Integration Logs</h1>
    </div>
</div>

<section class="wb-page-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label small text-muted mb-1">Search</label>
            <input name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Application no, consumer no, type, error" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">Status</label>
            <select name="status" class="form-select form-select-sm">
                <option value="">All</option>
                <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                <option value="Sent" selected="@(Model.Status == "Sent")">Sent</option>
                <option value="Failed" selected="@(Model.Status == "Failed")">Failed</option>
                <option value="Skipped" selected="@(Model.Status == "Skipped")">Skipped</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">From</label>
            <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">To</label>
            <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary btn-sm" type="submit">Filter</button>
        </div>
        <div class="col-auto">
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Clear</a>
        </div>
    </form>
</section>

<section class="wb-page-card">
    <div class="table-responsive">
        <table class="table wb-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Application No</th>
                    <th>Consumer No</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Attempts</th>
                    <th>Created</th>
                    <th>Sent</th>
                    <th>Endpoint</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No integration logs found.</td></tr>
                }
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@row.ApplicationNo</td>
                        <td>@(row.ConsumerNo ?? "-")</td>
                        <td><small>@row.ApplicationType</small></td>
                        <td><span class="badge @Badge(row.Status)">@row.Status</span></td>
                        <td>@row.AttemptCount</td>
                        <td><small>@row.CreatedAt.ToString("dd MMM yyyy HH:mm")</small></td>
                        <td><small>@(row.SentAt.HasValue ? row.SentAt.Value.ToString("dd MMM yyyy HH:mm") : "-")</small></td>
                        <td class="text-truncate" style="max-width:260px">@(string.IsNullOrWhiteSpace(row.EndpointUrl) ? "-" : row.EndpointUrl)</td>
                        <td><a asp-action="Details" asp-route-id="@row.Id" class="btn btn-outline-primary btn-sm">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
