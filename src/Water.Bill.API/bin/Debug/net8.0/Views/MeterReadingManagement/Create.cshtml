@model Water.Bill.API.Models.MeterReadings.MeterReadingCreateViewModel
@using Water.Bill.API.Models.MeterReadings
@using Water.Bill.Core.Common
@{
    ViewData["Title"] = "Record Meter Reading";
    string Amount(decimal? value) => value.HasValue ? value.Value.ToString("N2") : "-";
}

<div class="wb-page-head">
    <div>
        <h1>Record Meter Reading</h1>
        <p>Capture current reading and meter condition for billing preparation.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<section class="wb-page-card wb-admin-card">
    @if (Model.Consumer is not null)
    {
        <div class="wb-approval-summary-card">
            <div class="wb-approval-summary-head">
                <div>
                    <span class="wb-kicker">Consumer</span>
                    <h2>@Model.Consumer.ConsumerNo - @(Model.Consumer.ConsumerName ?? "-")</h2>
                    <span>@(Model.Consumer.PropertyNo ?? "-") · @(Model.Consumer.MobileNo ?? "-")</span>
                </div>
                <span class="badge text-bg-info">@AppConstants.Divisions.FormatDisplay(Model.Consumer.DevType)</span>
            </div>
            <div class="wb-approval-summary-grid">
                <div><span>Connection Type</span><strong>@(Model.Consumer.ConnectionType ?? "-")</strong></div>
                <div><span>Category</span><strong>@(Model.Consumer.Category ?? "-")</strong></div>
                <div><span>Pipe Size</span><strong>@(Model.Consumer.PipeSize?.ToString() ?? "-")</strong></div>
            </div>
        </div>
    }

    <form asp-action="Create" method="post" class="wb-form-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ConsumerNo" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="wb-form-field">
            <label asp-for="ReadingDate" class="form-label required"></label>
            <input asp-for="ReadingDate" type="date" class="form-control" />
            <span asp-validation-for="ReadingDate" class="text-danger"></span>
        </div>
        <div class="wb-form-field">
            <label asp-for="MeterStatus" class="form-label required"></label>
            <select asp-for="MeterStatus" class="form-select" asp-items="Model.StatusOptions"></select>
            <span asp-validation-for="MeterStatus" class="text-danger"></span>
        </div>
        <div class="wb-form-field">
            <label asp-for="PeriodFrom" class="form-label required"></label>
            <input asp-for="PeriodFrom" type="date" class="form-control" />
            <span asp-validation-for="PeriodFrom" class="text-danger"></span>
        </div>
        <div class="wb-form-field">
            <label asp-for="PeriodTo" class="form-label required"></label>
            <input asp-for="PeriodTo" type="date" class="form-control" />
            <span asp-validation-for="PeriodTo" class="text-danger"></span>
        </div>
        <div class="wb-form-field">
            <label asp-for="PreviousReading" class="form-label"></label>
            <input asp-for="PreviousReading" class="form-control" readonly />
            <div class="form-text">Auto-filled from latest saved reading where available.</div>
        </div>
        <div class="wb-form-field">
            <label asp-for="CurrentReading" class="form-label required"></label>
            <input asp-for="CurrentReading" class="form-control" />
            <span asp-validation-for="CurrentReading" class="text-danger"></span>
        </div>
        <div class="wb-form-field">
            <label asp-for="Consumption" class="form-label"></label>
            <input asp-for="Consumption" class="form-control" readonly value="@Amount(Model.Consumption)" />
            <div class="form-text">Calculated as current minus previous reading.</div>
        </div>
        <div class="wb-form-field">
            <label asp-for="MeterNo" class="form-label required"></label>
            <input asp-for="MeterNo" class="form-control" placeholder="Optional meter number" />
            <span asp-validation-for="MeterNo" class="text-danger"></span>
        </div>
        <div class="wb-form-field" style="grid-column: 1 / -1;">
            <label asp-for="Remarks" class="form-label required"></label>
            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Remarks are required for locked/faulty/no meter cases."></textarea>
            <span asp-validation-for="Remarks" class="text-danger"></span>
        </div>

        <div class="wb-form-actions" style="grid-column: 1 / -1;">
            <button type="submit" class="btn btn-primary">Save Reading</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const previous = document.querySelector('[name="PreviousReading"]');
            const current = document.querySelector('[name="CurrentReading"]');
            const consumption = document.querySelector('[name="Consumption"]');
            const status = document.querySelector('[name="MeterStatus"]');

            function calculate() {
                const prev = Number.parseFloat(previous?.value || '0') || 0;
                const curr = Number.parseFloat(current?.value || '0') || 0;
                const canCalculate = status?.value === '@MeterReadingStatuses.Normal' || status?.value === '@MeterReadingStatuses.Average';
                consumption.value = canCalculate ? Math.max(0, curr - prev).toFixed(2) : '0.00';
            }

            current?.addEventListener('input', calculate);
            status?.addEventListener('change', calculate);
            calculate();
        })();
    </script>
}
