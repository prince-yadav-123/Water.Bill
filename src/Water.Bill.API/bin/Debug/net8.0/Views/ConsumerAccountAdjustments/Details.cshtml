@model Water.Bill.API.Models.Adjustments.ConsumerAccountAdjustmentDetailsViewModel
@using Water.Bill.API.Models.Adjustments
@{
    ViewData["Title"] = "Adjustment Details";
    string DateText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy") : "-";
    string DateTimeText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy hh:mm tt") : "-";
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string Amount(decimal value) => value.ToString("N2");
    string Badge(string status) => status switch
    {
        ConsumerAdjustmentStatuses.Applied => "text-bg-success",
        ConsumerAdjustmentStatuses.Cancelled => "text-bg-danger",
        ConsumerAdjustmentStatuses.Reversed => "text-bg-secondary",
        _ => "text-bg-warning"
    };
}

<div class="wb-page-head">
    <div>
        <h1>Adjustment Details</h1>
        <p>Review adjustment impact, status, and audit trail.</p>
    </div>
    <div class="wb-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-outline-primary" asp-action="Create" asp-route-consumerNo="@Model.ConsumerNo">New for Consumer</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success wb-alert">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger wb-alert">@error</div>
}

<section class="wb-page-card wb-admin-card">
    <div class="row g-3 align-items-stretch">
        <div class="col-md-3">
            <div class="border rounded-3 p-3 h-100">
                <span class="wb-kicker">Adjustment No</span>
                <h2 class="h6 mb-0">@Model.AdjustmentNo</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded-3 p-3 h-100">
                <span class="wb-kicker">Consumer</span>
                <h2 class="h6 mb-0">@Model.ConsumerNo</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded-3 p-3 h-100">
                <span class="wb-kicker">Impact</span>
                <h2 class="h6 mb-0 @(Model.SignedAmount < 0 ? "text-success" : "text-danger")">@(Model.SignedAmount < 0 ? "-" : "+")@Amount(Math.Abs(Model.SignedAmount))</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded-3 p-3 h-100">
                <span class="wb-kicker">Status</span>
                <span class="badge @Badge(Model.Status)">@Model.Status</span>
            </div>
        </div>
    </div>
</section>

<section class="wb-page-card wb-admin-card mt-4">
    <h2 class="wb-section-title">Adjustment Information</h2>
    <dl class="wb-detail-grid">
        <div><dt>Consumer Name</dt><dd>@Text(Model.ConsumerName)</dd></div>
        <div><dt>Mobile</dt><dd>@Text(Model.MobileNo)</dd></div>
        <div><dt>Property</dt><dd>@Text(Model.PropertyNo)</dd></div>
        <div><dt>Type</dt><dd>@ConsumerAdjustmentTypes.Display(Model.AdjustmentType)</dd></div>
        <div><dt>Amount</dt><dd>@Amount(Model.Amount)</dd></div>
        <div><dt>Effective Date</dt><dd>@DateText(Model.EffectiveDate)</dd></div>
        <div><dt>Source Bill No</dt><dd>@Text(Model.SourceBillNo)</dd></div>
        <div><dt>Source Challan No</dt><dd>@Text(Model.SourceChallanNo)</dd></div>
        <div><dt>Applied Bill No</dt><dd>@Text(Model.AppliedBillNo)</dd></div>
        <div><dt>Applied On</dt><dd>@DateTimeText(Model.AppliedOn)</dd></div>
        <div><dt>Created By</dt><dd>@Text(Model.CreatedByName)</dd></div>
        <div><dt>Created At</dt><dd>@DateTimeText(Model.CreatedAt)</dd></div>
        <div style="grid-column: 1 / -1;"><dt>Remarks</dt><dd>@Text(Model.Remarks)</dd></div>
    </dl>
</section>

@if (Model.Status == ConsumerAdjustmentStatuses.Pending)
{
    <section class="wb-page-card wb-admin-card mt-4">
        <h2 class="wb-section-title">Cancel Pending Adjustment</h2>
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-9">
                <label class="form-label">Cancellation Remarks</label>
                <input class="form-control" name="remarks" maxlength="500" required />
            </div>
            <div class="col-md-3 text-end">
                <button class="btn btn-outline-danger" type="submit" onclick="return confirm('Cancel this pending adjustment?');">Cancel Adjustment</button>
            </div>
        </form>
    </section>
}
else if (Model.Status == ConsumerAdjustmentStatuses.Applied)
{
    <section class="wb-page-card wb-admin-card mt-4">
        <h2 class="wb-section-title">Reverse Applied Adjustment</h2>
        <p class="text-muted">This will not edit old bills. It creates an opposite pending adjustment for a future bill.</p>
        <form asp-action="Reverse" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-9">
                <label class="form-label">Reversal Remarks</label>
                <input class="form-control" name="remarks" maxlength="500" required />
            </div>
            <div class="col-md-3 text-end">
                <button class="btn btn-outline-warning" type="submit" onclick="return confirm('Reverse this applied adjustment by creating an opposite pending entry?');">Create Reversal</button>
            </div>
        </form>
    </section>
}

<section class="wb-page-card wb-admin-card mt-4">
    <h2 class="wb-section-title">History</h2>
    @if (Model.Histories.Count == 0)
    {
        <div class="wb-empty wb-empty-sm">No history found.</div>
    }
    else
    {
        <div class="table-responsive wb-approval-table-wrap">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Status</th>
                        <th>Remarks</th>
                        <th>By</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Histories)
                {
                    <tr>
                        <td><strong>@item.Action</strong></td>
                        <td>@Text(item.FromStatus) -> <span class="badge @Badge(item.ToStatus)">@item.ToStatus</span></td>
                        <td>@Text(item.Remarks)</td>
                        <td>@Text(item.ActionByName)</td>
                        <td>@DateTimeText(item.ActionAt)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
