@model Water.Bill.API.Models.Notices.NoticeCreateViewModel
@using Water.Bill.Core.Common
@{
    ViewData["Title"] = "Create Notice";
    string Amount(decimal value) => value.ToString("N2");
}

<div class="wb-page-head">
    <div>
        <h1>Create Notice</h1>
        <p>Prepare a consumer notice using template text or custom content.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<section class="wb-page-card wb-admin-card">
    @if (Model.Consumer is not null)
    {
        <div class="wb-approval-summary-card">
            <div class="wb-approval-summary-head">
                <div>
                    <span class="wb-kicker">Consumer</span>
                    <h2>@Model.Consumer.ConsumerNo - @(Model.Consumer.ConsumerName ?? "-")</h2>
                    <span>@(Model.Consumer.PropertyNo ?? "-") - @(Model.Consumer.MobileNo ?? "-")</span>
                </div>
                <span class="badge text-bg-info">@AppConstants.Divisions.FormatDisplay(Model.Consumer.DevType)</span>
            </div>
            <div class="wb-approval-summary-grid">
                <div><span>Connection</span><strong>@(Model.Consumer.ConnectionType ?? "-")</strong></div>
                <div><span>Category</span><strong>@(Model.Consumer.Category ?? "-")</strong></div>
                <div><span>Amount Due</span><strong>Rs. @Amount(Model.AmountDue)</strong></div>
            </div>
        </div>
    }

    <form asp-action="Create" method="post" class="wb-form-grid">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ConsumerNo" />
        <div asp-validation-summary="ModelOnly" class="text-danger" style="grid-column: 1 / -1;"></div>

        <div class="wb-form-field">
            <label asp-for="TemplateId" class="form-label"></label>
            <select asp-for="TemplateId" class="form-select" asp-items="Model.TemplateOptions">
                <option value="">Custom notice</option>
            </select>
            <div class="form-text">Changing template after opening will require selecting Create Notice again from list.</div>
        </div>
        <div class="wb-form-field">
            <label asp-for="NoticeType" class="form-label"></label>
            <select asp-for="NoticeType" class="form-select" asp-items="Model.TypeOptions"></select>
            <span asp-validation-for="NoticeType" class="text-danger"></span>
        </div>
        <div class="wb-form-field">
            <label asp-for="NoticeDate" class="form-label"></label>
            <input asp-for="NoticeDate" type="date" class="form-control" />
            <span asp-validation-for="NoticeDate" class="text-danger"></span>
        </div>
        <div class="wb-form-field">
            <label asp-for="DueDate" class="form-label"></label>
            <input asp-for="DueDate" type="date" class="form-control" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
        </div>
        <div class="wb-form-field" style="grid-column: 1 / -1;">
            <label asp-for="Subject" class="form-label"></label>
            <input asp-for="Subject" class="form-control" />
            <span asp-validation-for="Subject" class="text-danger"></span>
        </div>
        <div class="wb-form-field" style="grid-column: 1 / -1;">
            <label asp-for="Body" class="form-label"></label>
            <textarea asp-for="Body" class="form-control" rows="8"></textarea>
            <div class="form-text">Supported tokens: {ConsumerNo}, {ConsumerName}, {MobileNo}, {PropertyNo}, {AmountDue}, {DueDate}, {BillNo}, {ChallanNo}</div>
            <span asp-validation-for="Body" class="text-danger"></span>
        </div>
        <div class="wb-form-field">
            <label asp-for="AmountDue" class="form-label"></label>
            <input asp-for="AmountDue" class="form-control" />
            <span asp-validation-for="AmountDue" class="text-danger"></span>
        </div>
        <div class="wb-form-field">
            <label asp-for="RelatedBillNo" class="form-label"></label>
            <input asp-for="RelatedBillNo" class="form-control" />
            <span asp-validation-for="RelatedBillNo" class="text-danger"></span>
        </div>
        <div class="wb-form-field">
            <label asp-for="RelatedChallanNo" class="form-label"></label>
            <input asp-for="RelatedChallanNo" class="form-control" />
            <span asp-validation-for="RelatedChallanNo" class="text-danger"></span>
        </div>
        <div class="wb-form-field">
            <label asp-for="RelatedDisconnectionCaseId" class="form-label"></label>
            <select asp-for="RelatedDisconnectionCaseId" class="form-select" asp-items="Model.CaseOptions">
                <option value="">No linked case</option>
            </select>
        </div>
        <div class="wb-form-field" style="grid-column: 1 / -1;">
            <label asp-for="Remarks" class="form-label"></label>
            <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Remarks" class="text-danger"></span>
        </div>
        <div class="wb-form-actions" style="grid-column: 1 / -1;">
            <button class="btn btn-primary" type="submit">Save Draft Notice</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
