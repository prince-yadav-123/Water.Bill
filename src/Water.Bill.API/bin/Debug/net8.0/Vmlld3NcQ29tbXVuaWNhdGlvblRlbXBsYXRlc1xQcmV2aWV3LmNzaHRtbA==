@model Water.Bill.API.Models.Communication.CommunicationTemplatePreviewViewModel

<div class="wb-page-head">
    <div>
        <h1>Template Preview</h1>
        <p>@Model.TemplateName - @Model.PurposeKey - @Model.Channel</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Back</a>
</div>

<section class="wb-page-card wb-admin-card">
    <div class="wb-form-grid">
        <div class="wb-field wb-field-wide">
            <label class="form-label">Sample Values</label>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var item in Model.SampleValues)
                {
                    <span class="badge text-bg-light">@item.Key: @item.Value</span>
                }
            </div>
        </div>
        <div class="wb-field wb-field-wide">
            <label class="form-label">Rendered Subject</label>
            <input class="form-control" value="@Model.PreviewSubject" readonly />
        </div>
        <div class="wb-field wb-field-wide">
            <label class="form-label">Rendered Body</label>
            <div class="border rounded p-3 bg-white">@Html.Raw(Model.PreviewBody.Replace("\n", "<br />"))</div>
        </div>
    </div>
</section>

