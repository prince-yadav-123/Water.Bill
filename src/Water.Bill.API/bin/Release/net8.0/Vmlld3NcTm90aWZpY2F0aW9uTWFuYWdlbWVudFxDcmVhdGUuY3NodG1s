@model Water.Bill.API.Models.NotificationManagement.NotificationCreateViewModel
@{
    ViewData["Title"] = "Create Notification";
}

<div class="wb-page-head">
    <div><p class="wb-kicker">Notification Management</p><h1>Create Notification</h1></div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="TestEmail">Test Email</a>
        <a class="btn btn-outline-primary" asp-action="Index">Back to List</a>
    </div>
</div>

<form asp-action="Create" method="post" id="notifForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-3">

        @* ── Left: Main Content ── *@
        <div class="col-12 col-xl-8">
            <section class="wb-page-card mb-3">
                <h2 class="wb-section-title mb-3">Notification Content</h2>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label required">Title</label>
                    <input asp-for="Title" class="form-control" maxlength="200" placeholder="Enter notification title" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Message" class="form-label required">Message</label>
                    <textarea asp-for="Message" class="form-control" rows="4" placeholder="Enter the notification message body…"></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label asp-for="NotificationType" class="form-label required">Type</label>
                        <select asp-for="NotificationType" class="form-select">
                            @foreach (var t in new[]{"General","Billing","Payment","New Connection","Service Request","Query Support","System","Other"})
                            { <option value="@t">@t</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Priority" class="form-label required">Priority</label>
                        <select asp-for="Priority" class="form-select">
                            <option value="Low">Low</option>
                            <option value="Normal" selected>Normal</option>
                            <option value="High">High</option>
                            <option value="Urgent">Urgent</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label required">Channels</label>
                        <div class="d-flex flex-column gap-1 mt-1">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Channels" value="InApp" id="chInApp"
                                       @(Model.Channels.Contains("InApp") ? "checked" : "") />
                                <label class="form-check-label" for="chInApp">In-App Notification</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Channels" value="Email" id="chEmail"
                                       @(Model.Channels.Contains("Email") ? "checked" : "") />
                                <label class="form-check-label" for="chEmail">Email</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-2 mt-2">
                    <div class="col-md-4">
                        <label asp-for="ValidFrom" class="form-label">Valid From <small class="text-muted">(optional)</small></label>
                        <input asp-for="ValidFrom" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ValidTo" class="form-label">Valid To <small class="text-muted">(optional)</small></label>
                        <input asp-for="ValidTo" type="date" class="form-control" />
                    </div>
                </div>
                <div class="mt-3">
                    <label asp-for="RedirectUrl" class="form-label">Notification Link <small class="text-muted">(optional)</small></label>
                    <input asp-for="RedirectUrl" class="form-control" maxlength="1000" placeholder="/Consumer/NewConnection/Details/1 or https://example.com" />
                    <span asp-validation-for="RedirectUrl" class="text-danger"></span>
                    <small class="text-muted">
                        Use a relative portal path for internal navigation. External links must start with <code>http://</code> or <code>https://</code>.
                    </small>
                </div>
            </section>

            @* ── Targeting ── *@
            <section class="wb-page-card">
                <h2 class="wb-section-title mb-3">Target Audience</h2>

                <div class="mb-3">
                    <label class="form-label required fw-semibold">Send To</label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="TargetAudience" value="Consumer" id="audConsumer" data-toggle-audience="consumer" />
                            <label class="form-check-label" for="audConsumer">Consumers</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="TargetAudience" value="Internal" id="audInternal" data-toggle-audience="internal" />
                            <label class="form-check-label" for="audInternal">Internal Authority Users</label>
                        </div>
                    </div>
                </div>

                @* Consumer targeting *@
                <div id="consumerTargeting" class="@(Model.TargetAudience == "Internal" ? "d-none" : "")">
                    <div class="form-check mb-2">
                        <input asp-for="AllConsumers" class="form-check-input" id="allCons" />
                        <label class="form-check-label" for="allCons"><strong>All active consumers</strong></label>
                    </div>
                    <div id="specificConsumerFields" class="@(Model.AllConsumers ? "d-none" : "")">
                        <div class="mb-2">
                            <label class="form-label">Consumer No(s) <small class="text-muted">comma-separated</small></label>
                            <input asp-for="ConsumerNo" class="form-control" placeholder="e.g. C0001001, C0001002" />
                        </div>
                    </div>
                </div>

                @* Internal targeting *@
                <div id="internalTargeting" class="@(Model.TargetAudience == "Consumer" ? "d-none" : "")">
                    <div class="form-check mb-2">
                        <input asp-for="AllInternalUsers" class="form-check-input" id="allInt" />
                        <label class="form-check-label" for="allInt"><strong>All active internal users</strong></label>
                    </div>
                    <div id="specificInternalFields" class="@(Model.AllInternalUsers ? "d-none" : "")">
                        <div class="mb-2">
                            <label class="form-label">Roles</label>
                            <div class="wb-checkbox-list">
                                @foreach (var r in Model.RoleOptions)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedRoleIds" value="@r.Value"
                                               id="role_@r.Value"
                                               @(Model.SelectedRoleIds.Contains(r.Value) ? "checked" : "") />
                                        <label class="form-check-label" for="role_@r.Value">@r.Text</label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Departments</label>
                            <div class="wb-checkbox-list">
                                @foreach (var d in Model.DepartmentOptions)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedDepartmentIds" value="@d.Value"
                                               id="dept_@d.Value"
                                               @(Model.SelectedDepartmentIds.Contains(d.Value) ? "checked" : "") />
                                        <label class="form-check-label" for="dept_@d.Value">@d.Text</label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Specific Users</label>
                            <select name="SelectedUserIds" class="form-select" multiple size="5">
                                @foreach (var u in Model.UserOptions)
                                {
                                    if (Model.SelectedUserIds.Contains(u.Value))
                                    {
                                        <option value="@u.Value" selected>@u.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@u.Value">@u.Text</option>
                                    }
                                }
                            </select>
                            <small class="text-muted">Hold Ctrl/Cmd to select multiple.</small>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        @* ── Right: Send Options ── *@
        <div class="col-12 col-xl-4">
            <section class="wb-page-card position-sticky" style="top:90px;">
                <h2 class="wb-section-title mb-3">Send Options</h2>
                <div class="d-grid gap-2">
                    <button type="submit" name="Action" value="Send" class="btn btn-primary">
                        Send Now
                    </button>
                    <button type="submit" name="Action" value="Draft" class="btn btn-outline-secondary">
                        Save as Draft
                    </button>
                </div>
                <hr />
                <div class="wb-info-list">
                    <div><span class="wb-il-label">Type</span><strong id="previewType">@Model.NotificationType</strong></div>
                    <div><span class="wb-il-label">Priority</span><strong id="previewPriority">@Model.Priority</strong></div>
                    <div><span class="wb-il-label">Audience</span><strong id="previewAud">@Model.TargetAudience</strong></div>
                </div>
            </section>
        </div>
    </div>
</form>

<style>
    .wb-section-title { font-size: 1rem; font-weight: 700; color: #0f172a; }
    .wb-checkbox-list { max-height: 160px; overflow-y: auto; padding: 0.5rem; border: 1px solid #e8edf4; border-radius: 0.5rem; display: flex; flex-direction: column; gap: 0.25rem; }
    .wb-info-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .wb-info-list > div { display: flex; justify-content: space-between; font-size: 0.88rem; }
    .wb-il-label { color: #64748b; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        const audience = document.querySelectorAll('[data-toggle-audience]');
        const consumerDiv = document.getElementById('consumerTargeting');
        const internalDiv = document.getElementById('internalTargeting');
        const allCons = document.getElementById('allCons');
        const specCons = document.getElementById('specificConsumerFields');
        const allInt = document.getElementById('allInt');
        const specInt = document.getElementById('specificInternalFields');

        audience.forEach(r => r.addEventListener('change', () => {
            const isConsumer = r.value === 'Consumer';
            consumerDiv.classList.toggle('d-none', !isConsumer);
            internalDiv.classList.toggle('d-none', isConsumer);
            document.getElementById('previewAud').textContent = r.value;
        }));

        if (allCons) allCons.addEventListener('change', () => specCons.classList.toggle('d-none', allCons.checked));
        if (allInt) allInt.addEventListener('change', () => specInt.classList.toggle('d-none', allInt.checked));

        document.querySelector('[asp-for="NotificationType"]')?.addEventListener('change', e => document.getElementById('previewType').textContent = e.target.value);
        document.querySelector('[asp-for="Priority"]')?.addEventListener('change', e => document.getElementById('previewPriority').textContent = e.target.value);
    })();
    </script>
}
