@model Water.Bill.API.Models.NotificationManagement.NotificationDetailsViewModel
@{
    ViewData["Title"] = "Notification Details";
    string StatusBadge(string s) => s switch { "Sent"=>"bg-success","Draft"=>"bg-secondary","Cancelled"=>"bg-danger",_=>"bg-primary" };
    string PriBadge(string p) => p switch { "Urgent"=>"bg-danger","High"=>"bg-warning text-dark","Low"=>"bg-secondary",_=>"bg-primary" };
}

<div class="wb-page-head">
    <div><p class="wb-kicker">Notification Management</p><h1>Notification Details</h1></div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Index">Back to List</a>
        @if (Model.Status == "Draft")
        {
            <form asp-action="Send" asp-route-id="@Model.Id" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-primary" type="submit"
                        onclick="return confirm('Send this notification now to all target users?')">
                    Send Now
                </button>
            </form>
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" style="display:inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-danger" type="submit"
                        onclick="return confirm('Cancel this draft?')">Cancel Draft</button>
            </form>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-8">
        <section class="wb-page-card mb-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h2 class="mb-0">@Model.Title</h2>
                <span class="badge @StatusBadge(Model.Status)">@Model.Status</span>
            </div>
            <p class="text-muted mb-3">@Model.Message</p>
            <div class="row g-2">
                <div class="col-6 col-md-3"><small class="text-muted d-block">Type</small><strong>@Model.NotificationType</strong></div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Audience</small><strong>@Model.TargetAudience</strong></div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Priority</small><span class="badge @PriBadge(Model.Priority)">@Model.Priority</span></div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Channels</small><strong>@Model.Channels</strong></div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Valid From</small><strong>@(Model.ValidFrom.HasValue ? Model.ValidFrom.Value.ToString("dd MMM yyyy") : "-")</strong></div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Valid To</small><strong>@(Model.ValidTo.HasValue ? Model.ValidTo.Value.ToString("dd MMM yyyy") : "-")</strong></div>
                <div class="col-12 col-md-6"><small class="text-muted d-block">Notification Link</small><strong>@(string.IsNullOrWhiteSpace(Model.RedirectUrl) ? "-" : Model.RedirectUrl)</strong></div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Created By</small><strong>@(Model.CreatedByName ?? "-")</strong></div>
                <div class="col-6 col-md-3"><small class="text-muted d-block">Created At</small><strong>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</strong></div>
                @if (Model.SentAt.HasValue)
                {
                    <div class="col-6 col-md-3"><small class="text-muted d-block">Sent At</small><strong>@Model.SentAt.Value.ToString("dd MMM yyyy HH:mm")</strong></div>
                }
            </div>
        </section>

        <section class="wb-page-card mb-3">
            <h2 class="wb-section-title mb-3">Targets</h2>
            @if (!Model.Targets.Any())
            {
                <p class="text-muted">No targets configured.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table wb-table mb-0">
                        <thead><tr><th>Type</th><th>ID / Value</th><th>Name</th></tr></thead>
                        <tbody>
                            @foreach (var t in Model.Targets)
                            {
                                <tr>
                                    <td><span class="badge bg-primary-subtle text-primary-emphasis">@t.TargetType</span></td>
                                    <td><small>@(t.TargetId ?? "-")</small></td>
                                    <td>@(t.TargetName ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <div class="col-12 col-xl-4">
        <section class="wb-page-card">
            <h2 class="wb-section-title mb-3">Delivery Summary</h2>
            @if (Model.Status == "Sent")
            {
                <div class="wb-stat-row"><span>Total In-App Sent</span><strong>@Model.InAppTotalSent</strong></div>
                <div class="wb-stat-row"><span>Read</span><strong class="text-success">@Model.InAppRead</strong></div>
                <div class="wb-stat-row"><span>Unread</span><strong class="text-warning">@Model.InAppUnread</strong></div>
            }
            else
            {
                <p class="text-muted">Delivery stats will appear after the notification is sent.</p>
            }
        </section>
    </div>
</div>

<style>
    .wb-section-title { font-size: 1rem; font-weight: 700; color: #0f172a; }
    .wb-stat-row { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid #f1f5f9; font-size: 0.9rem; }
    .wb-stat-row:last-child { border-bottom: none; }
</style>
