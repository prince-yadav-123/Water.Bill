@model Water.Bill.API.Models.Disconnections.DisconnectionDetailsViewModel
@using Water.Bill.API.Models.Disconnections
@using Water.Bill.Core.Common
@{
    ViewData["Title"] = "Disconnection Case Details";
    string DateText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy") : "-";
    string DateTimeText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy hh:mm tt") : "-";
    string Amount(decimal value) => value.ToString("N2");
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string Badge(string status) => status switch
    {
        DisconnectionCaseStatuses.NoticeGenerated => "text-bg-warning",
        DisconnectionCaseStatuses.Disconnected => "text-bg-danger",
        DisconnectionCaseStatuses.ReconnectionRequested => "text-bg-info",
        DisconnectionCaseStatuses.Reconnected => "text-bg-success",
        DisconnectionCaseStatuses.Cancelled => "text-bg-secondary",
        _ => "text-bg-secondary"
    };
}

<div class="wb-page-head">
    <div>
        <h1>Disconnection Case Details</h1>
        <p>@Model.CaseNo · @Model.ConsumerNo</p>
    </div>
    <div class="wb-actions">
        <a class="btn btn-outline-primary" asp-action="Print" asp-route-id="@Model.Id" target="_blank">Print Notice</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success wb-alert">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger wb-alert">@error</div>
}

<section class="wb-page-card wb-admin-card">
    <div class="wb-approval-summary-card">
        <div class="wb-approval-summary-head">
            <div>
                <span class="wb-kicker">Case</span>
                <h2>@Model.CaseNo</h2>
                <span>@DisconnectionReasons.Display(Model.Reason) · Notice @DateText(Model.NoticeDate)</span>
            </div>
            <span class="badge @Badge(Model.Status)">@DisconnectionCaseStatuses.Display(Model.Status)</span>
        </div>
        <div class="wb-approval-summary-grid">
            <div><span>Consumer</span><strong>@Model.ConsumerNo - @Text(Model.ConsumerName)</strong></div>
            <div><span>Property</span><strong>@Text(Model.PropertyNo)</strong></div>
            <div><span>Outstanding</span><strong>Rs. @Amount(Model.OutstandingAmount)</strong></div>
            <div><span>Due Date</span><strong>@DateText(Model.DueDate)</strong></div>
            <div><span>Disconnected On</span><strong>@DateTimeText(Model.DisconnectedOn)</strong></div>
            <div><span>Reconnected On</span><strong>@DateTimeText(Model.ReconnectedOn)</strong></div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="wb-detail-section h-100">
                <h2 class="wb-section-title">Consumer Details</h2>
                <dl class="wb-detail-grid">
                    <div><dt>Mobile</dt><dd>@Text(Model.Consumer?.MobileNo)</dd></div>
                    <div><dt>Email</dt><dd>@Text(Model.Consumer?.Email)</dd></div>
                    <div><dt>Connection</dt><dd>@Text(Model.Consumer?.ConnectionType)</dd></div>
                    <div><dt>Division</dt><dd>@AppConstants.Divisions.FormatDisplay(Model.Consumer?.DevType)</dd></div>
                    <div style="grid-column: 1 / -1;"><dt>Address</dt><dd>@Text(Model.Consumer?.Address)</dd></div>
                </dl>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="wb-detail-section h-100">
                <h2 class="wb-section-title">Case Information</h2>
                <dl class="wb-detail-grid">
                    <div><dt>Disconnection Fee</dt><dd>Rs. @Amount(Model.DisconnectionFee)</dd></div>
                    <div><dt>Reconnection Fee</dt><dd>Rs. @Amount(Model.ReconnectionFee)</dd></div>
                    <div><dt>Field Officer</dt><dd>@Text(Model.FieldOfficerName)</dd></div>
                    <div><dt>Challan No</dt><dd>@Text(Model.ChallanNo)</dd></div>
                    <div style="grid-column: 1 / -1;"><dt>Remarks</dt><dd>@Text(Model.Remarks)</dd></div>
                </dl>
            </div>
        </div>
    </div>
</section>

@if (Model.CanDisconnect || Model.CanRequestReconnect || Model.CanReconnect || Model.CanCancel)
{
    <section class="wb-page-card wb-admin-card">
        <h2 class="wb-section-title">Current Action</h2>
        <div class="row g-3">
            @if (Model.CanDisconnect)
            {
                <div class="col-12 col-lg-6">
                    <form asp-action="Disconnect" asp-route-id="@Model.Id" method="post" class="border rounded-3 p-3 h-100">
                        @Html.AntiForgeryToken()
                        <label class="form-label">Disconnection Remarks</label>
                        <textarea name="remarks" class="form-control mb-3" rows="3" required></textarea>
                        <button class="btn btn-danger" type="submit" onclick="return confirm('Mark this consumer as disconnected?');">Mark Disconnected</button>
                    </form>
                </div>
            }
            @if (Model.CanRequestReconnect)
            {
                <div class="col-12 col-lg-6">
                    <form asp-action="RequestReconnect" asp-route-id="@Model.Id" method="post" class="border rounded-3 p-3 h-100">
                        @Html.AntiForgeryToken()
                        <label class="form-label">Reconnection Request Remarks</label>
                        <textarea name="remarks" class="form-control mb-3" rows="3" required></textarea>
                        <button class="btn btn-primary" type="submit">Record Reconnection Request</button>
                    </form>
                </div>
            }
            @if (Model.CanReconnect)
            {
                <div class="col-12 col-lg-6">
                    <form asp-action="Reconnect" asp-route-id="@Model.Id" method="post" class="border rounded-3 p-3 h-100">
                        @Html.AntiForgeryToken()
                        <label class="form-label">Reconnection Remarks</label>
                        <textarea name="remarks" class="form-control mb-3" rows="3" required></textarea>
                        <button class="btn btn-success" type="submit" onclick="return confirm('Mark this consumer as reconnected?');">Mark Reconnected</button>
                    </form>
                </div>
            }
            @if (Model.CanCancel)
            {
                <div class="col-12 col-lg-6">
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="border rounded-3 p-3 h-100">
                        @Html.AntiForgeryToken()
                        <label class="form-label">Cancellation Remarks</label>
                        <textarea name="remarks" class="form-control mb-3" rows="3" required></textarea>
                        <button class="btn btn-outline-danger" type="submit" onclick="return confirm('Cancel this case?');">Cancel Case</button>
                    </form>
                </div>
            }
        </div>
    </section>
}

<section class="wb-page-card wb-admin-card">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <h2 class="wb-section-title mb-1">Case History</h2>
            <p class="text-muted mb-0">Every status movement is recorded for audit.</p>
        </div>
        <span class="badge text-bg-secondary">@Model.Histories.Count record@(Model.Histories.Count == 1 ? "" : "s")</span>
    </div>
    @if (Model.Histories.Count == 0)
    {
        <div class="wb-empty">No history found.</div>
    }
    else
    {
        <div class="wb-timeline">
            @foreach (var item in Model.Histories)
            {
                <div class="wb-timeline-item">
                    <span></span>
                    <div>
                        <strong>@item.Action</strong>
                        <small>@Text(item.FromStatus) → @DisconnectionCaseStatuses.Display(item.ToStatus) · @DateTimeText(item.ActionAt)</small>
                        <small>By @Text(item.ActionByName)</small>
                        <p>@Text(item.Remarks)</p>
                    </div>
                </div>
            }
        </div>
    }
</section>
