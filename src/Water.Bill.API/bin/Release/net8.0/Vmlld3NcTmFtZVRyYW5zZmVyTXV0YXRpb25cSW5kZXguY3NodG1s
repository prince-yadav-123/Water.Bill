@model Water.Bill.API.Models.ConsumerWorkflows.ConsumerChangeListViewModel
@{
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string DateText(DateOnly? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy") : "-";
    string Badge(string? status) => status switch
    {
        "Approved" => "text-bg-success",
        "Rejected" => "text-bg-danger",
        _ => "text-bg-warning"
    };
}

<div class="wb-page-head">
    <div>
        <h1>@Model.ModuleTitle</h1>
        <p>@Model.ModuleDescription</p>
    </div>
    <a class="btn btn-primary" asp-action="SearchConsumer">Create Request</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success wb-alert">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger wb-alert">@error</div>
}

<section class="wb-page-card wb-admin-card">
    <form method="get" class="wb-filter-bar wb-bill-filter-bar">
        <div class="wb-filter-field wb-filter-search">
            <label class="form-label">Search</label>
            <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Application / consumer / name" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Status</label>
            <select class="form-select" name="status">
                <option value="">All Status</option>
                <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                <option value="Approved" selected="@(Model.Status == "Approved")">Approved</option>
                <option value="Rejected" selected="@(Model.Status == "Rejected")">Rejected</option>
            </select>
        </div>
        <div class="wb-filter-actions">
            <button class="btn btn-primary" type="submit">Filter</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </form>

    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mt-3 mb-3">
        <div>
            <h2 class="wb-section-title mb-1">Requests</h2>
            <p class="text-muted mb-0">Latest requests from old-compatible application table.</p>
        </div>
        <span class="badge text-bg-secondary">@Model.Applications.Count record@(Model.Applications.Count == 1 ? "" : "s")</span>
    </div>

    @if (Model.Applications.Count == 0)
    {
        <div class="wb-empty">No requests found.</div>
    }
    else
    {
        <div class="table-responsive wb-approval-table-wrap">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Application No</th>
                        <th>Consumer</th>
                        <th>Property</th>
                        <th>Mobile</th>
                        <th>Status</th>
                        <th>Created On</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Applications)
                {
                    <tr>
                        <td><strong>@row.ApplicationId</strong></td>
                        <td>
                            <div class="fw-semibold">@Text(row.ConsNo)</div>
                            <small class="text-muted">@Text(row.ConName)</small>
                        </td>
                        <td>@Text($"{row.SectorVill}/{row.Block}-{row.PlotNo}".Trim('/', '-'))</td>
                        <td>@Text(row.ConPhoneMobile)</td>
                        <td><span class="badge @Badge(row.ApplicationStatus)">@Text(row.ApplicationStatus)</span></td>
                        <td>@DateText(row.EnterDate)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@row.ApplicationId">View</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
