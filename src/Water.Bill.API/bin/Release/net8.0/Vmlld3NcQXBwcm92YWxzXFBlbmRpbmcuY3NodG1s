@model Water.Bill.API.Models.Approvals.ApprovalListViewModel
@{
    var isAdmin = ViewData["IsAdmin"] as bool? == true;

    string TabClass(string t) => Model.ActiveTab == t
        ? "btn btn-primary wb-approval-tab active"
        : "btn btn-outline-primary wb-approval-tab";

    string StatusClass(string s) => s switch
    {
        "Pending"                         => "text-bg-warning text-dark",
        "Approved" or "FinalConsumerCreated" => "text-bg-success",
        "Rejected"                        => "text-bg-danger",
        "UnderReview" or "Submitted"      => "text-bg-primary",
        "SentBackToApplicant" or "CorrectionRequired" => "text-bg-warning text-dark",
        "Forwarded"                       => "text-bg-info text-dark",
        "SentBackToPrevious"              => "text-bg-secondary",
        _                                 => "text-bg-secondary"
    };

    string FriendlyStatus(string s) => s switch
    {
        "SentBackToApplicant"    => "Sent Back to Applicant",
        "SentBackToPrevious"     => "Sent Back to Previous",
        "CorrectionRequired"     => "Correction Required",
        "FinalConsumerCreated"   => "Final Consumer Created",
        "UnderReview"            => "Under Review",
        _ => s
    };

    string FriendlyType(string t) => t switch
    {
        "NewConnection"    => "New Connection",
        "NDC"              => "NDC / No Dues",
        "NameTransfer"     => "Name Transfer",
        "ConnectionChange" => "Connection Change",
        _ => t
    };
}

<div class="wb-page-head">
    <div>
        <h1>Approval Applications</h1>
        <p>
            @if (isAdmin)
            {
                <span class="badge text-bg-primary me-2">Admin View</span>
                <span>All workflow applications across all stages are visible to you.</span>
            }
            else
            {
                <span>Applications assigned to your stage, role, or department.</span>
            }
        </p>
    </div>
</div>

<section class="wb-page-card wb-admin-card">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="wb-approval-tabs">
        @if (!isAdmin)
        {
            <a class="@TabClass("Pending")" asp-action="Pending" asp-route-tab="Pending">My Pending</a>
            <a class="@TabClass("Approved")" asp-action="Pending" asp-route-tab="Approved">Approved</a>
            <a class="@TabClass("Rejected")" asp-action="Pending" asp-route-tab="Rejected">Rejected</a>
        }
        <a class="@TabClass("All")" asp-action="Pending" asp-route-tab="All">All</a>
    </div>

    <form method="get" class="wb-filter-bar">
        <input type="hidden" name="tab" value="@Model.ActiveTab" />
        <div class="wb-filter-field wb-filter-search">
            <label class="form-label">Search</label>
            <input class="form-control" type="search" name="search" value="@Model.Search"
                   placeholder="Application no, applicant, mobile" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Status</label>
            <select class="form-select" name="status">
                <option value="">All Statuses</option>
                <option value="Pending"              selected="@(Model.Status == "Pending")">Pending</option>
                <option value="Approved"             selected="@(Model.Status == "Approved")">Approved</option>
                <option value="Rejected"             selected="@(Model.Status == "Rejected")">Rejected</option>
                <option value="Submitted"            selected="@(Model.Status == "Submitted")">Submitted</option>
                <option value="UnderReview"          selected="@(Model.Status == "UnderReview")">Under Review</option>
                <option value="Forwarded"            selected="@(Model.Status == "Forwarded")">Forwarded</option>
                <option value="SentBackToApplicant"  selected="@(Model.Status == "SentBackToApplicant")">Sent Back to Applicant</option>
                <option value="SentBackToPrevious"   selected="@(Model.Status == "SentBackToPrevious")">Sent Back to Previous Stage</option>
                <option value="FinalConsumerCreated" selected="@(Model.Status == "FinalConsumerCreated")">Final Consumer Created</option>
            </select>
        </div>
        <div class="wb-filter-field">
            <label class="form-label">From</label>
            <input class="form-control" type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">To</label>
            <input class="form-control" type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Department</label>
            <select class="form-select" name="departmentId">
                <option value="">All Departments</option>
                @foreach (var d in Model.Departments)
                {
                    <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.DeptName</option>
                }
            </select>
        </div>
        <div class="wb-filter-actions">
            <button class="btn btn-primary" type="submit">Filter</button>
            <a class="btn btn-outline-secondary" asp-action="Pending" asp-route-tab="@Model.ActiveTab">Reset</a>
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="wb-empty">No applications found for this filter.</div>
    }
    else
    {
        <p class="text-muted mb-2" style="font-size:.88rem">
            Showing @Model.Items.Count application(s).
            @if (!isAdmin) { <span>Only applications assigned to you are shown.</span> }
        </p>
        <div class="table-responsive wb-approval-table-wrap">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Application No</th>
                        <th>Type</th>
                        <th>Applicant</th>
                        <th>Mobile</th>
                        <th>Current Stage</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th>Submitted</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><strong>@item.ApplicationNo</strong></td>
                            <td><small class="text-muted">@FriendlyType(item.ApplicationType)</small></td>
                            <td>@(item.ApplicantName ?? "-")</td>
                            <td>@(item.MobileNumber ?? "-")</td>
                            <td>
                                <small>@item.CurrentStage</small>
                            </td>
                            <td>
                                <span class="badge @StatusClass(item.CurrentStatus)">
                                    @FriendlyStatus(item.CurrentStatus)
                                </span>
                            </td>
                            <td><small>@item.AssignedTo</small></td>
                            <td>
                                <small>@(item.SubmittedOn?.ToString("dd MMM yyyy") ?? item.AssignedOn.ToString("dd MMM yyyy"))</small>
                            </td>
                            <td class="text-center">
                                @* Only "View & Action" — all actions require remarks + confirmation on the Details page *@
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Details" asp-route-id="@item.TaskId">
                                    @(item.CanAct ? "Review & Action" : "View")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted mt-2" style="font-size:.8rem">
            * All workflow actions (Accept, Reject, Forward, Send Back) must be taken from the application's detail page. Mandatory remarks and confirmation are required for every action.
        </p>
    }
    @await Html.PartialAsync("_Pagination", ViewBag.Pagination as Water.Bill.API.Models.PaginationViewModel)
</section>
