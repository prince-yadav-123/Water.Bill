@model Water.Bill.Application.DTOs.Communication.CommunicationChannelSettingsDto
@{
    ViewData["Title"] = "Edit Integration Hub";
}

<div class="wb-page-head">
    <div>
        <h1>@Model.DisplayName</h1>
        <p>Update the JSON settings for this channel and toggle whether it is enabled. Saved DB values take priority over appsettings.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Back</a>
</div>

<section class="wb-page-card wb-form-card">
    <form asp-action="Edit" asp-route-channel="@Model.ChannelName" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ChannelName" />
        <input type="hidden" asp-for="DisplayName" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label">Channel Name</label>
                <input class="form-control" value="@Model.DisplayName" readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label">Source</label>
                <input class="form-control" value="@(Model.IsConfiguredInDb ? "Database" : "App Settings fallback")" readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label">Enabled</label>
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" asp-for="IsEnabled" />
                    <label class="form-check-label" asp-for="IsEnabled">Channel enabled</label>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Last Updated By</label>
                <input class="form-control" value="@(string.IsNullOrWhiteSpace(Model.LastUpdatedByName) ? "-" : Model.LastUpdatedByName)" readonly />
            </div>
            <div class="col-md-6">
                <label class="form-label">Last Updated Date</label>
                <input class="form-control" value="@(Model.LastUpdatedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "-")" readonly />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label required" asp-for="ConfigurationJson">Configuration JSON</label>
            <textarea class="form-control font-monospace" asp-for="ConfigurationJson" rows="20" spellcheck="false"></textarea>
            <span class="text-muted small d-block mt-2">
                Keep a valid JSON object here. You can store provider credentials, endpoints, keys, templates, and other channel-specific settings. Channel enable/disable is controlled by the toggle above, so do not add <code>IsEnabled</code> inside the JSON.
            </span>
            <span asp-validation-for="ConfigurationJson" class="text-danger"></span>
        </div>

        <div class="wb-actions">
            <button type="submit" class="btn btn-primary">Save Settings</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
