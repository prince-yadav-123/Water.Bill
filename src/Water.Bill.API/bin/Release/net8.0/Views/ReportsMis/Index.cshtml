@model Water.Bill.API.Models.Reports.MisReportIndexViewModel
@using Water.Bill.API.Helpers
@{
    string DateText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy") : "-";
    string Amount(double value) => $"Rs. {value:N2}";
    string CompactAmount(double value)
    {
        var abs = Math.Abs(value);
        if (abs >= 10000000d)
            return $"Rs. {(value / 10000000d):0.##} Cr";
        if (abs >= 100000d)
            return $"Rs. {(value / 100000d):0.##} Lakh";
        return $"Rs. {value:N2}";
    }

    string Short(string? value, int max = 42)
    {
        if (string.IsNullOrWhiteSpace(value)) return "-";
        var text = value.Trim();
        return text.Length <= max ? text : $"{text[..max]}...";
    }
}

<div class="wb-page-head">
    <div>
        <h1>Reports / MIS</h1>
        <p>Operational reports from old-compatible bill, challan, payment, and consumer tables.</p>
    </div>
</div>

<section class="wb-page-card wb-admin-card">
    <form method="get" class="wb-filter-bar wb-bill-filter-bar wb-reportsmis-filterbar">
        <input type="hidden" name="PageSize" value="@Model.PageSize" />
        <div class="wb-filter-field wb-reportsmis-filter-search">
            <label class="form-label">Common Search</label>
            <input class="form-control" name="Search" value="@Model.Search" placeholder="Search consumer, reference, bill, challan, division, status..." />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Report Type</label>
            <select class="form-select" name="ReportType">
                <option value="Collection" selected="@(Model.ReportType == "Collection")">Collection</option>
                <option value="Dues" selected="@(Model.ReportType == "Dues")">Pending Dues</option>
                <option value="Bill" selected="@(Model.ReportType == "Bill")">Bill Register</option>
                <option value="Challan" selected="@(Model.ReportType == "Challan")">Challan Register</option>
            </select>
        </div>
        <div class="wb-filter-field">
            <label class="form-label">From Date</label>
            <input class="form-control" type="date" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">To Date</label>
            <input class="form-control" type="date" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="wb-filter-actions">
            <button class="btn btn-primary" type="submit">Run Report</button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-reportType="@Model.ReportType">Reset</a>
        </div>
    </form>
</section>

<section class="wb-reportsmis-summary-grid">
    <article class="wb-page-card wb-admin-card wb-reportsmis-summary-card">
        <span>Total Records</span>
        <strong>@Model.Summary.TotalCount</strong>
        <small>Filtered rows for the selected report range.</small>
    </article>
    <article class="wb-page-card wb-admin-card wb-reportsmis-summary-card">
        <span>Total Amount</span>
        <strong title="@Amount(Model.Summary.TotalAmount)">@CompactAmount(Model.Summary.TotalAmount)</strong>
        <small>Overall report amount across the current filtered result set.</small>
    </article>
    <article class="wb-page-card wb-admin-card wb-reportsmis-summary-card">
        <span>Paid Amount</span>
        <strong title="@Amount(Model.Summary.PaidAmount)">@CompactAmount(Model.Summary.PaidAmount)</strong>
        <small>Collected or paid amount reflected by the report.</small>
    </article>
    <article class="wb-page-card wb-admin-card wb-reportsmis-summary-card">
        <span>Pending Amount</span>
        <strong title="@Amount(Model.Summary.PendingAmount)">@CompactAmount(Model.Summary.PendingAmount)</strong>
        <small>Balance amount still pending after paid values are applied.</small>
    </article>
 </section>

<section class="wb-page-card wb-admin-card">
    @if (Model.Rows.Count == 0)
    {
        <div class="wb-empty">No data found for selected filters.</div>
    }
    else
    {
        <div class="table-responsive wb-approval-table-wrap">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Consumer</th>
                        <th>Property / Division</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Paid</th>
                        <th>Pending</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="wb-reportsmis-ref" title="@row.ReferenceNo"><strong>@Short(row.ReferenceNo, 28)</strong></td>
                        <td class="wb-reportsmis-consumer">
                            <strong>@(row.ConsumerNo ?? "-")</strong>
                            @if (!string.IsNullOrWhiteSpace(row.ConsumerName))
                            {
                                <small class="d-block text-muted" title="@row.ConsumerName">@Short(row.ConsumerName, 26)</small>
                            }
                        </td>
                        <td class="wb-reportsmis-property">
                            <strong title="@row.PropertyNo">@Short(row.PropertyNo, 24)</strong>
                            <small class="d-block text-muted" title="@row.Division">@(string.IsNullOrWhiteSpace(row.Division) ? "-" : Short(row.Division, 24))</small>
                        </td>
                        <td><span class="badge @AdminStatusBadgeHelper.CssClass(row.Status)">@AdminStatusBadgeHelper.Label(row.Status)</span></td>
                        <td class="wb-reportsmis-date">@DateText(row.Date)</td>
                        <td class="wb-reportsmis-amount">@Amount(row.Amount)</td>
                        <td class="wb-reportsmis-amount">@Amount(row.PaidAmount)</td>
                        <td class="wb-reportsmis-amount">@Amount(Math.Max(0, row.Amount - row.PaidAmount))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", ViewBag.Pagination as Water.Bill.API.Models.PaginationViewModel)
    }
</section>

<style>
    .wb-reportsmis-filterbar {
        display: grid;
        grid-template-columns: minmax(280px, 2.1fr) minmax(160px, 1fr) repeat(2, minmax(150px, .9fr)) auto;
        gap: 1rem;
        align-items: end;
    }

    .wb-reportsmis-filter-search {
        min-width: 0;
    }

    .wb-reportsmis-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin: 1rem 0;
    }

    .wb-reportsmis-summary-card {
        min-height: 132px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: .45rem;
    }

    .wb-reportsmis-summary-card span {
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #5f769a;
    }

    .wb-reportsmis-summary-card strong {
        font-size: 1.6rem;
        line-height: 1.1;
        color: #102748;
    }

    .wb-reportsmis-summary-card small {
        color: #6d7f98;
        font-size: .85rem;
    }

    .wb-reportsmis-ref,
    .wb-reportsmis-consumer,
    .wb-reportsmis-property {
        min-width: 0;
    }

    .wb-reportsmis-date,
    .wb-reportsmis-amount {
        white-space: nowrap;
    }

    .wb-approval-table td {
        vertical-align: middle;
    }

    .wb-approval-table td small {
        margin-top: .15rem;
    }

    @@media (max-width: 1199.98px) {
        .wb-reportsmis-filterbar {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .wb-reportsmis-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .wb-reportsmis-filterbar,
        .wb-reportsmis-summary-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
