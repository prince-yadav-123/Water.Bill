@model Water.Bill.API.Models.Disconnections.DisconnectionManagementIndexViewModel
@using Water.Bill.API.Models.Disconnections
@using Water.Bill.Core.Common
@{
    ViewData["Title"] = "Disconnection / Reconnection Management";
    string DateText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy") : "-";
    string Amount(decimal value) => value.ToString("N2");
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string Badge(string status) => status switch
    {
        DisconnectionCaseStatuses.NoticeGenerated => "text-bg-warning",
        DisconnectionCaseStatuses.Disconnected => "text-bg-danger",
        DisconnectionCaseStatuses.ReconnectionRequested => "text-bg-info",
        DisconnectionCaseStatuses.Reconnected => "text-bg-success",
        DisconnectionCaseStatuses.Cancelled => "text-bg-secondary",
        _ => "text-bg-secondary"
    };
}

<div class="wb-page-head">
    <div>
        <h1>Disconnection / Reconnection Management</h1>
        <p>Generate notices, mark disconnections, process reconnections, and track full case history.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success wb-alert">@success</div>
}

<section class="wb-page-card wb-admin-card">
    <form method="get" class="wb-filter-bar wb-bill-filter-bar">
        <div class="wb-filter-field wb-filter-search">
            <label class="form-label">Search</label>
            <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Case / consumer / name / mobile" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Consumer No</label>
            <input class="form-control" type="search" name="consumerNo" value="@Model.ConsumerNo" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Name</label>
            <input class="form-control" type="search" name="consumerName" value="@Model.ConsumerName" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Mobile</label>
            <input class="form-control" type="search" name="mobileNo" value="@Model.MobileNo" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Sector</label>
            <input class="form-control" type="search" name="sector" value="@Model.Sector" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Block</label>
            <input class="form-control" type="search" name="block" value="@Model.Block" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Plot</label>
            <input class="form-control" type="search" name="plotNo" value="@Model.PlotNo" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Status</label>
            <select class="form-select" name="status" asp-items="Model.StatusOptions">
                <option value="">All Status</option>
            </select>
        </div>
        <div class="wb-filter-field">
            <label class="form-label">From Date</label>
            <input class="form-control" type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">To Date</label>
            <input class="form-control" type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="wb-filter-actions">
            <button class="btn btn-primary" type="submit">Filter</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </form>
</section>

@if (Model.HasConsumerSearch)
{
    <section class="wb-page-card wb-admin-card">
        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
            <div>
                <h2 class="wb-section-title mb-1">Consumer Search</h2>
                <p class="text-muted mb-0">Select a consumer to generate disconnection notice.</p>
            </div>
            <span class="badge text-bg-secondary">@Model.Consumers.Count result@(Model.Consumers.Count == 1 ? "" : "s")</span>
        </div>
        @if (Model.Consumers.Count == 0)
        {
            <div class="wb-empty">No matching consumers found.</div>
        }
        else
        {
            <div class="table-responsive wb-approval-table-wrap">
                <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                    <thead>
                        <tr>
                            <th>Consumer</th>
                            <th>Mobile</th>
                            <th>Property</th>
                            <th>Connection</th>
                            <th>Outstanding</th>
                            <th>Active Case</th>
                            <th>Division</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Consumers)
                    {
                        <tr>
                            <td><strong>@row.ConsumerNo</strong><small class="d-block text-muted">@Text(row.ConsumerName)</small></td>
                            <td>@Text(row.MobileNo)</td>
                            <td>@Text(row.PropertyNo)</td>
                            <td>@Text(row.ConnectionType)</td>
                            <td>Rs. @Amount(row.OutstandingAmount)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.ActiveCaseNo) ? "-" : row.ActiveCaseNo)</td>
                            <td>@AppConstants.Divisions.FormatDisplay(row.DevType)</td>
                            <td class="text-end">
                                @if (string.IsNullOrWhiteSpace(row.ActiveCaseNo))
                                {
                                    <a class="btn btn-sm btn-primary" asp-action="Create" asp-route-consumerNo="@row.ConsumerNo">Generate Notice</a>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">Case active</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

<section class="wb-page-card wb-admin-card">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <h2 class="wb-section-title mb-1">Cases</h2>
            <p class="text-muted mb-0">Latest disconnection/reconnection cases first.</p>
        </div>
        <span class="badge text-bg-secondary">@Model.Cases.Count record@(Model.Cases.Count == 1 ? "" : "s")</span>
    </div>
    @if (Model.Cases.Count == 0)
    {
        <div class="wb-empty">No disconnection/reconnection cases found.</div>
    }
    else
    {
        <div class="table-responsive wb-approval-table-wrap">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Case No</th>
                        <th>Consumer</th>
                        <th>Property</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Notice Date</th>
                        <th>Outstanding</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Cases)
                {
                    <tr>
                        <td><strong>@row.CaseNo</strong></td>
                        <td><div class="fw-semibold">@row.ConsumerNo</div><small class="text-muted">@Text(row.ConsumerName) · @Text(row.MobileNo)</small></td>
                        <td>@Text(row.PropertyNo)</td>
                        <td>@DisconnectionReasons.Display(row.Reason)</td>
                        <td><span class="badge @Badge(row.Status)">@DisconnectionCaseStatuses.Display(row.Status)</span></td>
                        <td>@DateText(row.NoticeDate)</td>
                        <td>Rs. @Amount(row.OutstandingAmount)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@row.Id">View</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
