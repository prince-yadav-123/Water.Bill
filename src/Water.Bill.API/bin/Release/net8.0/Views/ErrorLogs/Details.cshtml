@model Water.Bill.API.Models.Audit.ErrorLogDetailsViewModel
@using Water.Bill.API.Helpers
@{
    var createdAt = Model.CreatedAt.ToString("dd MMM yyyy hh:mm:ss tt");
}

<div class="wb-page-head">
    <div>
        <h1>Error Log Details</h1>
        <p>Review complete diagnostic information for this captured runtime error.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <section class="wb-page-card wb-admin-card">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h2 class="h5 mb-1">@Model.ExceptionType</h2>
                    <p class="text-muted mb-0">@Model.Message</p>
                </div>
                <span class="badge @AdminStatusBadgeHelper.CssClass(Model.StatusCode >= 500 ? "Failed" : Model.StatusCode.ToString())">@Model.StatusCode</span>
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-4">Portal Type</dt>
                <dd class="col-sm-8">@Model.PortalType</dd>

                <dt class="col-sm-4">Handled</dt>
                <dd class="col-sm-8">
                    <span class="badge @AdminStatusBadgeHelper.CssClass(Model.IsHandled ? "Completed" : "ActionRequired")">@((Model.IsHandled) ? "Handled" : "Unhandled")</span>
                </dd>

                <dt class="col-sm-4">Created At</dt>
                <dd class="col-sm-8">@createdAt</dd>

                <dt class="col-sm-4">Trace ID</dt>
                <dd class="col-sm-8"><code>@(Model.TraceId ?? "-")</code></dd>

                <dt class="col-sm-4">Error ID</dt>
                <dd class="col-sm-8"><code>@Model.Id</code></dd>
            </dl>
        </section>

        <section class="wb-page-card wb-admin-card mt-3">
            <h2 class="h5 mb-3">Stack Trace</h2>
            @if (string.IsNullOrWhiteSpace(Model.StackTrace))
            {
                <div class="text-muted">No stack trace was captured for this error.</div>
            }
            else
            {
                <pre class="mb-0" style="white-space:pre-wrap;word-break:break-word;background:#0f172a;color:#e2e8f0;padding:16px;border-radius:12px;">@Model.StackTrace</pre>
            }
        </section>
    </div>

    <div class="col-lg-5">
        <section class="wb-page-card wb-admin-card">
            <h2 class="h5 mb-3">Request Context</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Path</dt>
                <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.RequestPath) ? Model.RequestPath : "-")</dd>

                <dt class="col-sm-4">Method</dt>
                <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.HttpMethod) ? Model.HttpMethod : "-")</dd>

                <dt class="col-sm-4">Query</dt>
                <dd class="col-sm-8" style="word-break:break-word;">@(!string.IsNullOrWhiteSpace(Model.QueryString) ? Model.QueryString : "-")</dd>

                <dt class="col-sm-4">Controller</dt>
                <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.ControllerName) ? Model.ControllerName : "-")</dd>

                <dt class="col-sm-4">Action</dt>
                <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.ActionName) ? Model.ActionName : "-")</dd>

                <dt class="col-sm-4">IP Address</dt>
                <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.IpAddress) ? Model.IpAddress : "-")</dd>

                <dt class="col-sm-4">Username</dt>
                <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.Username) ? Model.Username : "-")</dd>

                <dt class="col-sm-4">User ID</dt>
                <dd class="col-sm-8">@(!string.IsNullOrWhiteSpace(Model.UserId) ? Model.UserId : "-")</dd>

                <dt class="col-sm-4">User Agent</dt>
                <dd class="col-sm-8" style="word-break:break-word;">@(!string.IsNullOrWhiteSpace(Model.UserAgent) ? Model.UserAgent : "-")</dd>
            </dl>
        </section>
    </div>
</div>
