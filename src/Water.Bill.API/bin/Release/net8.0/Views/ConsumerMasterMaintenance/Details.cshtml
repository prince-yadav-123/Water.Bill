@model Water.Bill.API.Models.Consumers.ConsumerMasterMaintenanceDetailsViewModel
@using Water.Bill.Core.Common
@{
    ViewData["Title"] = "Consumer Details";
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    string DateText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy") : "-";
    string Amount(double? value) => value.HasValue ? value.Value.ToString("N2") : "-";
}

<div class="wb-page-head">
    <div>
        <h1>Consumer Details</h1>
        <p>Review live consumer profile, property, connection, and billing context.</p>
    </div>
    <div class="wb-actions">
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-consumerNo="@Model.ConsumerNo">Edit Consumer</a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success wb-alert">@success</div>
}

<section class="wb-page-card wb-admin-card">
    <div class="row g-3 align-items-stretch">
        <div class="col-md-3">
            <div class="border rounded-3 p-3 h-100">
                <span class="wb-kicker">Consumer No</span>
                <h2 class="h5 mb-0">@Model.ConsumerNo</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded-3 p-3 h-100">
                <span class="wb-kicker">Consumer Name</span>
                <h2 class="h6 mb-0">@Text(Model.ConsumerName)</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded-3 p-3 h-100">
                <span class="wb-kicker">Division</span>
                <h2 class="h6 mb-0">@AppConstants.Divisions.FormatDisplay(Model.DevType)</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded-3 p-3 h-100">
                <span class="wb-kicker">Status</span>
                <span class="badge @(Model.Status == 1 ? "text-bg-success" : "text-bg-secondary")">@(Model.Status == 1 ? "Active" : "Inactive")</span>
            </div>
        </div>
    </div>
</section>

<section class="wb-page-card wb-admin-card mt-4">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <h2 class="wb-section-title mb-1">Consumer Profile</h2>
            <p class="text-muted mb-0">Old-compatible fields used by billing, challan, NDC, and Consumer Portal flows.</p>
        </div>
        <form asp-action="ToggleStatus" method="post" onsubmit="return confirm('@(Model.Status == 1 ? "Deactivate" : "Activate") this consumer?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="consumerNo" value="@Model.ConsumerNo" />
            <button class="btn btn-sm @(Model.Status == 1 ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(Model.Status == 1 ? "Deactivate" : "Activate")</button>
        </form>
    </div>

    <dl class="wb-detail-grid">
        <div><dt>Father / Guardian</dt><dd>@Text(Model.FatherName)</dd></div>
        <div><dt>Mobile</dt><dd>@Text(Model.MobileNo)</dd></div>
        <div><dt>Email</dt><dd>@Text(Model.Email)</dd></div>
        <div><dt>Address</dt><dd>@Text(Model.Address)</dd></div>
        <div><dt>Property</dt><dd>@Text(Model.PropertyNo)</dd></div>
        <div><dt>Sector / Block / Plot</dt><dd>@Text(Model.Sector) / @Text(Model.Block) / @Text(Model.FlatNo)</dd></div>
        <div><dt>Plot Size</dt><dd>@(Model.PlotSize?.ToString() ?? "-")</dd></div>
        <div><dt>Pipe Size</dt><dd>@(Model.PipeSize?.ToString() ?? "-")</dd></div>
        <div><dt>Connection Type</dt><dd>@Text(Model.ConnectionType)</dd></div>
        <div><dt>Category</dt><dd>@Text(Model.Category)</dd></div>
        <div><dt>Flat Type</dt><dd>@Text(Model.FlatType)</dd></div>
        <div><dt>Connection Date</dt><dd>@DateText(Model.ConnectionDate)</dd></div>
        <div><dt>Registration No</dt><dd>@Text(Model.RegistrationNo)</dd></div>
        <div><dt>Village / Khasra</dt><dd>@Text(Model.VillageName) / @Text(Model.KhasraNo)</dd></div>
        <div><dt>Monthly Rate</dt><dd>@Amount(Model.MonthlyRate)</dd></div>
        <div><dt>Monthly Charges</dt><dd>@Amount(Model.MonthlyCharges)</dd></div>
        <div><dt>Cess Amount</dt><dd>@Amount(Model.CessAmount)</dd></div>
        <div><dt>Security Amount</dt><dd>@(Model.SecurityAmount?.ToString() ?? "-")</dd></div>
        <div><dt>Estimate No / Amount</dt><dd>@Text(Model.EstimateNo) / @(Model.EstimateAmount?.ToString() ?? "-")</dd></div>
        <div><dt>Purpose</dt><dd>@Text(Model.Purpose)</dd></div>
        <div><dt>Other Connection</dt><dd>@Text(Model.OtherConnection)</dd></div>
        <div><dt>Narration</dt><dd>@Text(Model.Narration)</dd></div>
        <div><dt>Entry Date</dt><dd>@DateText(Model.EntryDate)</dd></div>
        <div><dt>Modified On</dt><dd>@DateText(Model.ModifiedOn)</dd></div>
    </dl>
</section>

<section class="wb-page-card wb-admin-card mt-4">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <h2 class="wb-section-title mb-1">Recent Bills</h2>
            <p class="text-muted mb-0">Latest bill records linked with this consumer.</p>
        </div>
        <a class="btn btn-sm btn-outline-primary" asp-controller="BillSearchPrint" asp-action="Index" asp-route-consumerNo="@Model.ConsumerNo">Open Bill Search</a>
    </div>

    @if (Model.RecentBills.Count == 0)
    {
        <div class="wb-empty wb-empty-sm">No recent bills found.</div>
    }
    else
    {
        <div class="table-responsive wb-approval-table-wrap">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Bill No</th>
                        <th>Period</th>
                        <th>Bill Date</th>
                        <th>Total</th>
                        <th>Paid</th>
                        <th>Paid Date</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var bill in Model.RecentBills)
                {
                    <tr>
                        <td><strong>@Text(bill.BillNo)</strong></td>
                        <td>@DateText(bill.BillDateFrom) to @DateText(bill.BillDateTo)</td>
                        <td>@DateText(bill.BillDate)</td>
                        <td>@Amount(bill.TotalAmount)</td>
                        <td>@Amount(bill.PaidAmount)</td>
                        <td>@DateText(bill.PaidDate)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="wb-page-card wb-admin-card mt-4">
    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
        <div>
            <h2 class="wb-section-title mb-1">Recent Challans</h2>
            <p class="text-muted mb-0">Latest challans linked with this consumer.</p>
        </div>
        <a class="btn btn-sm btn-outline-primary" asp-controller="ChallanManagement" asp-action="Index" asp-route-consumerNo="@Model.ConsumerNo">Open Challans</a>
    </div>

    @if (Model.RecentChallans.Count == 0)
    {
        <div class="wb-empty wb-empty-sm">No recent challans found.</div>
    }
    else
    {
        <div class="table-responsive wb-approval-table-wrap">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Challan No</th>
                        <th>Generated On</th>
                        <th>Amount</th>
                        <th>Paid Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var challan in Model.RecentChallans)
                {
                    <tr>
                        <td><strong>@Text(challan.ChallanNo)</strong></td>
                        <td>@DateText(challan.GeneratedOn)</td>
                        <td>@Amount(challan.Amount)</td>
                        <td>@DateText(challan.PaidDate)</td>
                        <td><span class="badge @(challan.PaidDate.HasValue ? "text-bg-success" : "text-bg-warning")">@(challan.PaidDate.HasValue ? "Paid" : Text(challan.Status))</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
