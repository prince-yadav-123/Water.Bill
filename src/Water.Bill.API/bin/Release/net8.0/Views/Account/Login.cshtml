@model AuthorityLoginViewModel

@{
    ViewData["Title"] = "Authority Login";
}

<div class="wb-admin-login">
    <section class="wb-admin-login-hero" aria-label="Noida Jal administration">
        <div class="wb-admin-login-brand">
            <img class="wb-admin-login-logo" src="~/images/brand/noida-jal-logo.png" asp-append-version="true" alt="Noida Jal" />
            <div>
                <div class="wb-admin-login-brand-title">Noida Jal</div>
                <div class="wb-admin-login-brand-sub">Water Bill Authority</div>
            </div>
        </div>

        <div class="wb-admin-login-copy">
            <span class="wb-admin-login-eyebrow">Secure Authority Login</span>
            <h1>Manage water billing operations with confidence.</h1>
            <p>Access consumers, billing, collections, role permissions, menu management, and security settings from one controlled workspace.</p>
        </div>

        <div class="wb-admin-login-metrics">
            <div>
                <strong>Role Based</strong>
                <span>Controlled module access</span>
            </div>
            <div>
                <strong>Audit Ready</strong>
                <span>Track sensitive activity</span>
            </div>
            <div>
                <strong>Responsive</strong>
                <span>Works across devices</span>
            </div>
        </div>
    </section>

    <section class="wb-admin-login-form-wrap" aria-label="Authority sign in">
        <div class="wb-admin-login-card">
            <div class="wb-admin-login-card-head">
                <div class="wb-admin-login-mark">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.029 10 8 10c-2.029 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                    </svg>
                </div>
                <div>
                    <h2>Welcome back</h2>
                    <p>Sign in with your authority username or email.</p>
                </div>
            </div>

            <form class="wb-admin-login-form" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <input asp-for="KeyId" type="hidden" />
                <input asp-for="RequestToken" type="hidden" />
                <input asp-for="EncryptedKey" type="hidden" />
                <input asp-for="Iv" type="hidden" />
                <input asp-for="CipherText" type="hidden" />
                @if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger py-2">@errorMessage</div>
                }
                <div asp-validation-summary="ModelOnly" class="wb-admin-login-summary"></div>

                <div class="wb-admin-login-field">
                    <label asp-for="Username" class="form-label required">Username or Email</label>
                    <div class="wb-admin-input-shell">
                        @* <span class="wb-admin-input-icon">U</span> *@
                        <input asp-for="Username" class="wb-admin-input" autocomplete="username" autofocus placeholder="admin@noidajal.local" autocapitalize="off" spellcheck="false" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="wb-admin-login-field">
                    <label asp-for="Password" class="form-label required"></label>
                    <div class="wb-admin-input-shell wb-pw-shell">
                        <input asp-for="Password" id="adminPassword" class="wb-admin-input" autocomplete="current-password" placeholder="Enter password" />
                        <button type="button" class="wb-pw-eye" onclick="togglePw('adminPassword',this)" aria-label="Show password" tabindex="-1">
                            <svg class="wb-eye-show" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                            </svg>
                            <svg class="wb-eye-hide" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" style="display:none">
                                <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/>
                                <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
                                <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709z"/>
                                <path fill-rule="evenodd" d="M13.646 14.354l-12-12 .708-.708 12 12-.708.708z"/>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="wb-admin-login-options">
                    <label class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <span class="form-check-label">Keep me signed in</span>
                    </label>
                    <span class="wb-admin-login-help">Protected access</span>
                </div>

                <button type="submit" class="wb-admin-login-submit">Sign In</button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .wb-pw-shell { position: relative; }
        .wb-pw-eye {
            position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
            background: none; border: none; padding: 4px; cursor: pointer;
            color: #94a3b8; line-height: 1; display: flex; align-items: center;
            transition: color .15s;
        }
        .wb-pw-eye:hover { color: #475569; }
        .wb-admin-input.wb-pw-shell-input { padding-right: 2.5rem; }
    </style>
    <script>
        function togglePw(inputId, btn) {
            var inp = document.getElementById(inputId);
            if (!inp) return;
            var isHidden = inp.type === 'password';
            inp.type = isHidden ? 'text' : 'password';
            var showIcon = btn.querySelector('.wb-eye-show');
            var hideIcon = btn.querySelector('.wb-eye-hide');
            if (showIcon) showIcon.style.display = isHidden ? 'none' : '';
            if (hideIcon) hideIcon.style.display = isHidden ? '' : 'none';
            btn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        }
    </script>
    <script>
        (function () {
            const form = document.querySelector('.wb-admin-login-form');
            const usernameInput = form?.querySelector('input[name="Username"]');
            const passwordInput = form?.querySelector('input[name="Password"]');
            const rememberInput = form?.querySelector('input[name="RememberMe"]');
            const keyIdInput = form?.querySelector('input[name="KeyId"]');
            const requestTokenInput = form?.querySelector('input[name="RequestToken"]');
            const encryptedKeyInput = form?.querySelector('input[name="EncryptedKey"]');
            const ivInput = form?.querySelector('input[name="Iv"]');
            const cipherTextInput = form?.querySelector('input[name="CipherText"]');
            const submitButton = form?.querySelector('button[type="submit"]');
            let encryptionReady = null;
            let originalUsernameName = usernameInput?.getAttribute('name') ?? 'Username';
            let originalPasswordName = passwordInput?.getAttribute('name') ?? 'Password';
            const minFreshnessSeconds = 20;

            function toBase64(bytes) {
                let binary = '';
                const chunkSize = 0x8000;
                for (let i = 0; i < bytes.length; i += chunkSize) {
                    binary += String.fromCharCode(...bytes.subarray(i, i + chunkSize));
                }
                return btoa(binary);
            }

            function fromBase64(base64) {
                const binary = atob(base64);
                const bytes = new Uint8Array(binary.length);
                for (let i = 0; i < binary.length; i++) {
                    bytes[i] = binary.charCodeAt(i);
                }
                return bytes;
            }

            async function loadEncryptionKey() {
                const response = await fetch('/Account/LoginEncryptionKey', {
                    cache: 'no-store',
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                });

                if (!response.ok) {
                    throw new Error('Login encryption key could not be loaded.');
                }

                const keyData = await response.json();
                const publicKey = await window.crypto.subtle.importKey(
                    'spki',
                    fromBase64(keyData.publicKeySpkiBase64),
                    { name: 'RSA-OAEP', hash: 'SHA-256' },
                    false,
                    ['encrypt']);

                return { keyData, publicKey };
            }

            async function ensureFreshEncryptionReady(forceRefresh = false) {
                const nowUnixSeconds = Math.floor(Date.now() / 1000);
                const expiresAt = encryptionReady?.keyData?.expiresAtUnixSeconds ?? 0;
                const isFreshEnough = !forceRefresh && encryptionReady && expiresAt > (nowUnixSeconds + minFreshnessSeconds);

                if (isFreshEnough) {
                    return encryptionReady;
                }

                encryptionReady = await loadEncryptionKey();
                return encryptionReady;
            }

            async function encryptAndPopulateFields() {
                if (!window.crypto?.subtle) {
                    throw new Error('This browser does not support secure login encryption.');
                }

                const { keyData, publicKey } = await ensureFreshEncryptionReady();

                const payload = {
                    username: usernameInput?.value?.trim() ?? '',
                    password: passwordInput?.value ?? '',
                    rememberMe: rememberInput?.checked ?? true,
                    timestampUnixSeconds: Math.floor(Date.now() / 1000)
                };

                const payloadBytes = new TextEncoder().encode(JSON.stringify(payload));
                const aesKey = await window.crypto.subtle.generateKey(
                    { name: 'AES-GCM', length: 256 },
                    true,
                    ['encrypt']);
                const rawAesKey = new Uint8Array(await window.crypto.subtle.exportKey('raw', aesKey));
                const iv = window.crypto.getRandomValues(new Uint8Array(12));
                const encryptedPayload = new Uint8Array(await window.crypto.subtle.encrypt(
                    { name: 'AES-GCM', iv },
                    aesKey,
                    payloadBytes));
                const encryptedKey = new Uint8Array(await window.crypto.subtle.encrypt(
                    { name: 'RSA-OAEP' },
                    publicKey,
                    rawAesKey));

                keyIdInput.value = keyData.keyId;
                requestTokenInput.value = keyData.requestToken;
                encryptedKeyInput.value = toBase64(encryptedKey);
                ivInput.value = toBase64(iv);
                cipherTextInput.value = toBase64(encryptedPayload);
            }

            function suppressPlaintextFieldValidation() {
                const summary = document.querySelector('.wb-admin-login-summary');
                if (summary) {
                    summary.textContent = '';
                    summary.classList.remove('validation-summary-errors');
                }

                const validationSpans = form.querySelectorAll('[data-valmsg-for="Username"], [data-valmsg-for="Password"]');
                validationSpans.forEach(span => {
                    span.textContent = '';
                    span.classList.remove('field-validation-error');
                    span.classList.add('field-validation-valid');
                });

                if (usernameInput) {
                    usernameInput.disabled = true;
                    usernameInput.removeAttribute('name');
                }

                if (passwordInput) {
                    passwordInput.disabled = true;
                    passwordInput.removeAttribute('name');
                }
            }

            function restorePlaintextInputs() {
                if (usernameInput) {
                    usernameInput.disabled = false;
                    usernameInput.setAttribute('name', originalUsernameName);
                }

                if (passwordInput) {
                    passwordInput.disabled = false;
                    passwordInput.setAttribute('name', originalPasswordName);
                }
            }

            if (form) {
                ensureFreshEncryptionReady(true)
                    .then(result => { encryptionReady = result; })
                    .catch(() => { encryptionReady = null; });

                form.addEventListener('submit', async function (event) {
                    if (form.dataset.encryptedSubmit === 'true') {
                        return;
                    }

                    event.preventDefault();
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.textContent = 'Securing Sign In...';
                    }

                    try {
                        await encryptAndPopulateFields();
                        suppressPlaintextFieldValidation();
                        form.dataset.encryptedSubmit = 'true';
                        form.submit();
                    } catch (error) {
                        restorePlaintextInputs();
                        const summary = document.querySelector('.wb-admin-login-summary');
                        if (summary) {
                            summary.textContent = error instanceof Error
                                ? error.message
                                : 'Login request could not be secured. Please try again.';
                            summary.classList.add('validation-summary-errors');
                        }
                        if (submitButton) {
                            submitButton.disabled = false;
                            submitButton.textContent = 'Sign In';
                        }
                    }
                });
            }

            async function redirectIfAuthoritySessionExists() {
                try {
                    const response = await fetch('/Account/AuthStatus', {
                        cache: 'no-store',
                        credentials: 'same-origin',
                        headers: { 'Accept': 'application/json' }
                    });

                    if (!response.ok) return;

                    const result = await response.json();
                    if (result && result.isAuthenticated) {
                        window.location.replace(result.redirectUrl || '/Dashboard');
                    }
                } catch {
                    // Stay on login if the session check cannot be completed.
                }
            }

            window.addEventListener('pageshow', redirectIfAuthoritySessionExists);
            document.addEventListener('visibilitychange', function () {
                if (!document.hidden) {
                    redirectIfAuthoritySessionExists();
                }
            });
        })();
    </script>
}
