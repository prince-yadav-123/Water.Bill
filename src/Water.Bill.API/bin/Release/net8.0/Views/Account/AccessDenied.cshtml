@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Restricted";
    var permission = ViewBag.Permission as string;
    var returnUrl = ViewBag.ReturnUrl as string;
    var safeReturnUrl = !string.IsNullOrWhiteSpace(returnUrl) && Url.IsLocalUrl(returnUrl) ? returnUrl : null;
}

<div class="wb-page-head">
    <div>
        <h1>Access Restricted</h1>
        <p>This page is part of the authority portal, but your role does not currently have permission to open this module.</p>
    </div>
</div>

<div class="wb-page-card wb-access-card">
    <div class="wb-access-mark">403</div>
    <h2 class="wb-access-title">You do not have access to this module</h2>
    <p class="wb-access-text">
        Please contact your administrator if this access is required for your work. Your existing login session is still active.
    </p>

    @if (!string.IsNullOrWhiteSpace(permission))
    {
        <div class="wb-access-chip">@Uri.UnescapeDataString(permission)</div>
    }

    <div class="wb-access-actions">
        <a class="btn btn-outline-primary" href="@(safeReturnUrl ?? "javascript:history.back()")">Go Back</a>
        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Go to Dashboard</a>
    </div>
</div>

<style>
    .wb-access-card {
        max-width: 760px;
        margin: 0 auto;
        padding: 2.5rem 2rem;
        text-align: center;
    }

    .wb-access-mark {
        width: 74px;
        height: 74px;
        margin: 0 auto 1rem;
        border-radius: 999px;
        display: grid;
        place-items: center;
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f766e;
        background: #ecfeff;
        border: 1px solid #a5f3fc;
    }

    .wb-access-title {
        margin: 0 0 .75rem;
        font-size: 1.65rem;
        font-weight: 800;
        color: #0f172a;
    }

    .wb-access-text {
        max-width: 560px;
        margin: 0 auto 1.25rem;
        color: #64748b;
        line-height: 1.7;
    }

    .wb-access-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: .45rem .8rem;
        margin-bottom: 1.5rem;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #0f172a;
        font-size: .86rem;
        font-weight: 600;
    }

    .wb-access-actions {
        display: flex;
        justify-content: center;
        gap: .75rem;
        flex-wrap: wrap;
    }
</style>
