@model Water.Bill.API.Models.Notices.NoticeTemplateIndexViewModel
@using Water.Bill.API.Models.Notices
@{
    ViewData["Title"] = "Notice Templates";
}

<div class="wb-page-head">
    <div>
        <h1>Notice Templates</h1>
        <p>Reusable notice content used while creating consumer notices.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<section class="wb-page-card wb-admin-card">
    @if (Model.Rows.Count == 0)
    {
        <div class="wb-empty">No notice templates found. Run the module SQL seed to create defaults.</div>
    }
    else
    {
        <div class="table-responsive wb-approval-table-wrap">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Template</th>
                        <th>Type</th>
                        <th>Subject</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td><strong>@row.TemplateName</strong></td>
                        <td>@NoticeTypes.Display(row.NoticeType)</td>
                        <td>@row.Subject</td>
                        <td><span class="badge @(row.IsActive ? "text-bg-success" : "text-bg-secondary")">@(row.IsActive ? "Active" : "Inactive")</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
