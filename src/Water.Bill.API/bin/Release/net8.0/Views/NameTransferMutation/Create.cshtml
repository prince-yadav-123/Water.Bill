@model Water.Bill.API.Models.ConsumerWorkflows.NameTransferCreateViewModel
@using Water.Bill.Core.Common
@{
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}

<div class="wb-page-head">
    <div>
        <h1>Create Name Transfer</h1>
        <p>Stage a name transfer / mutation request. Live consumer data is updated only after approval.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="SearchConsumer">Back</a>
</div>

<section class="wb-page-card wb-admin-card">
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <small class="text-muted">Consumer No</small>
            <div class="fw-semibold">@Model.ConsumerNo</div>
        </div>
        <div class="col-md-3">
            <small class="text-muted">Current Name</small>
            <div class="fw-semibold">@Text(Model.Consumer?.ConsNm1)</div>
        </div>
        <div class="col-md-3">
            <small class="text-muted">Property</small>
            <div class="fw-semibold">@Text($"{Model.Consumer?.Sector}/{Model.Consumer?.BlkNo}-{Model.Consumer?.FlatNo}".Trim('/', '-'))</div>
        </div>
        <div class="col-md-3">
            <small class="text-muted">Division</small>
            <div class="fw-semibold">@AppConstants.Divisions.FormatDisplay(Model.Consumer?.DevType)</div>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ConsumerNo" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="wb-form-grid">
            <div>
                <label class="form-label" asp-for="NewConsumerName">New Consumer Name</label>
                <input class="form-control" asp-for="NewConsumerName" maxlength="100" />
                <span class="text-danger" asp-validation-for="NewConsumerName"></span>
            </div>
            <div>
                <label class="form-label" asp-for="NewFatherName">New Father / Name 2</label>
                <input class="form-control" asp-for="NewFatherName" maxlength="100" />
                <span class="text-danger" asp-validation-for="NewFatherName"></span>
            </div>
            <div>
                <label class="form-label" asp-for="MobileNo">Mobile No</label>
                <input class="form-control" asp-for="MobileNo" maxlength="12" />
                <span class="text-danger" asp-validation-for="MobileNo"></span>
            </div>
            <div>
                <label class="form-label" asp-for="ChallanNo">Challan No</label>
                <input class="form-control" asp-for="ChallanNo" maxlength="50" />
                <span class="text-danger" asp-validation-for="ChallanNo"></span>
            </div>
            <div>
                <label class="form-label" asp-for="ChallanDate">Challan Date</label>
                <input class="form-control" asp-for="ChallanDate" type="date" />
                <span class="text-danger" asp-validation-for="ChallanDate"></span>
            </div>
            <div>
                <label class="form-label" asp-for="TransferFee">Transfer Fee</label>
                <input class="form-control" asp-for="TransferFee" type="number" step="0.01" />
                <span class="text-danger" asp-validation-for="TransferFee"></span>
            </div>
            <div>
                <label class="form-label" asp-for="SecurityAmount">Security Amount</label>
                <input class="form-control" asp-for="SecurityAmount" type="number" step="0.01" />
                <span class="text-danger" asp-validation-for="SecurityAmount"></span>
            </div>
            <div class="wb-form-span-2">
                <label class="form-label" asp-for="Remarks">Remarks</label>
                <textarea class="form-control" asp-for="Remarks" rows="3" maxlength="500"></textarea>
                <span class="text-danger" asp-validation-for="Remarks"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-secondary" asp-action="SearchConsumer">Cancel</a>
            <button class="btn btn-primary" type="submit">Save Request</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
