@model Water.Bill.API.Models.Billing.BulkBillGenerationViewModel
@using Water.Bill.Core.Common
@{
    string Amount(double value) => value.ToString("N2");
    string DateValue(DateTime value) => value.ToString("yyyy-MM-dd");
    string DateText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy") : "-";
    var canGenerate = Model.PreviewRows.Any(x => !x.AlreadyGenerated && string.IsNullOrWhiteSpace(x.Warning));
}

<div class="wb-page-head">
    <div>
        <h1>Bulk Bill Generation</h1>
        <p>Generate old-compatible water bill records into <strong>jal_print_bill_master</strong> using configured rate slabs.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="BillSearchPrint" asp-action="Index">Bill Search & Print</a>
</div>

<section class="wb-page-card wb-admin-card">
    <form method="get" class="wb-bulk-bill-form">
        <input type="hidden" name="preview" value="1" />
        <div class="wb-form-section-head">
            <h2 class="wb-section-title mb-1">Bill Generation Details</h2>
            <p class="text-muted mb-0">Select billing period, consumer scope, and calculation options before previewing bills.</p>
        </div>

        <div class="wb-form-grid wb-form-grid-2">
            <div class="wb-form-field">
                <label class="form-label">Bill Date</label>
                <input class="form-control" type="date" name="BillDate" value="@DateValue(Model.BillDate)" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Due Date</label>
                <input class="form-control" type="date" name="BillDueDate" value="@DateValue(Model.BillDueDate)" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Period From</label>
                <input class="form-control" type="date" name="BillDateFrom" value="@DateValue(Model.BillDateFrom)" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Period To</label>
                <input class="form-control" type="date" name="BillDateTo" value="@DateValue(Model.BillDateTo)" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Division</label>
                <select class="form-select" name="DevType" asp-items="Model.DivisionOptions">
                    <option value="">All Divisions</option>
                </select>
            </div>
            <div class="wb-form-field">
                <label class="form-label">Consumer No</label>
                <input class="form-control" type="search" name="ConsumerNo" value="@Model.ConsumerNo" placeholder="Optional" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Sector</label>
                <input class="form-control" type="search" name="Sector" value="@Model.Sector" placeholder="Optional" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Block</label>
                <input class="form-control" type="search" name="Block" value="@Model.Block" placeholder="Optional" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Bill Type</label>
                <input class="form-control" name="BillType" value="@Model.BillType" maxlength="10" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Max Consumers</label>
                <input class="form-control" type="number" min="1" max="1000" name="MaxConsumers" value="@Model.MaxConsumers" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Rebate %</label>
                <input class="form-control" type="number" min="0" max="100" step="1" name="RebatePercent" value="@Model.RebatePercent" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Rebate Mode</label>
                <select class="form-select" name="RebateMode">
                    <option value="Manual" selected="@(Model.RebateMode == "Manual")">Manual</option>
                    <option value="EarlyAnnual" selected="@(Model.RebateMode == "EarlyAnnual")">Early annual window</option>
                    <option value="HalfYear" selected="@(Model.RebateMode == "HalfYear")">Half-year window</option>
                </select>
            </div>
            <div class="wb-form-field">
                <label class="form-label">GST %</label>
                <input class="form-control" type="number" min="0" max="100" step="0.01" name="GstPercent" value="@Model.GstPercent" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Arrear Interest %</label>
                <input class="form-control" type="number" min="0" max="100" step="0.01" name="ArrearInterestPercent" value="@Model.ArrearInterestPercent" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">After Due Surcharge %</label>
                <input class="form-control" type="number" min="0" max="100" step="0.01" name="AfterDueSurchargePercent" value="@Model.AfterDueSurchargePercent" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Scheme Id</label>
                <input class="form-control" name="SchemeId" value="@Model.SchemeId" maxlength="50" placeholder="Optional" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Bill Percentage</label>
                <input class="form-control" type="number" min="0" max="100" name="BillPercentage" value="@Model.BillPercentage" placeholder="Optional" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Legacy Rate Date</label>
                <input class="form-control" type="date" name="LegacyRateDate" value="@DateValue(Model.LegacyRateDate)" />
            </div>
            <div class="wb-form-field">
                <label class="form-label">Credit Rebate Guard Months</label>
                <input class="form-control" type="number" min="1" max="12" name="CreditRebateThresholdMonths" value="@Model.CreditRebateThresholdMonths" />
            </div>
        </div>

        <div class="wb-bulk-options">
            <label class="form-check">
                <input class="form-check-input" type="checkbox" name="IncludeArrears" value="true" checked="@Model.IncludeArrears" />
                <input type="hidden" name="IncludeArrears" value="false" />
                <span>Include arrears</span>
            </label>
            <label class="form-check">
                <input class="form-check-input" type="checkbox" name="IncludeCess" value="true" checked="@Model.IncludeCess" />
                <input type="hidden" name="IncludeCess" value="false" />
                <span>Include cess</span>
            </label>
            <label class="form-check">
                <input class="form-check-input" type="checkbox" name="IncludeGst" value="true" checked="@Model.IncludeGst" />
                <input type="hidden" name="IncludeGst" value="false" />
                <span>Include GST</span>
            </label>
            <label class="form-check">
                <input class="form-check-input" type="checkbox" name="UseLegacyRateDate" value="true" checked="@Model.UseLegacyRateDate" />
                <input type="hidden" name="UseLegacyRateDate" value="false" />
                <span>Use legacy rate date</span>
            </label>
            <label class="form-check">
                <input class="form-check-input" type="checkbox" name="ApplyCreditRebateGuard" value="true" checked="@Model.ApplyCreditRebateGuard" />
                <input type="hidden" name="ApplyCreditRebateGuard" value="false" />
                <span>Apply credit rebate guard</span>
            </label>
        </div>

        <div class="wb-form-actions">
            <button class="btn btn-primary" type="submit">Preview Bills</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </form>
</section>

@if (Model.Result is not null)
{
    <section class="wb-page-card wb-admin-card">
        <div class="wb-summary-strip">
            <div><span>Requested</span><strong>@Model.Result.RequestedCount</strong></div>
            <div><span>Generated</span><strong>@Model.Result.GeneratedCount</strong></div>
            <div><span>Skipped</span><strong>@Model.Result.SkippedCount</strong></div>
        </div>
        @if (Model.Result.GeneratedBillNos.Count > 0)
        {
            <p class="text-muted mb-0">Generated bill numbers: @string.Join(", ", Model.Result.GeneratedBillNos.Take(20))</p>
        }
    </section>
}

<section class="wb-page-card wb-admin-card">
    <div class="wb-card-title-row">
        <div>
            <h2 class="wb-section-title mb-1">Bill Preview</h2>
            <p class="text-muted mb-0">Existing period bills are skipped by default to protect old data.</p>
        </div>
        @if (Model.HasPreview && canGenerate)
        {
            <form method="post" asp-action="Generate">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BillDate" />
                <input type="hidden" asp-for="BillDueDate" />
                <input type="hidden" asp-for="BillDateFrom" />
                <input type="hidden" asp-for="BillDateTo" />
                <input type="hidden" asp-for="DevType" />
                <input type="hidden" asp-for="Sector" />
                <input type="hidden" asp-for="Block" />
                <input type="hidden" asp-for="ConsumerNo" />
                <input type="hidden" asp-for="BillType" />
                <input type="hidden" asp-for="IncludeArrears" />
                <input type="hidden" asp-for="IncludeCess" />
                <input type="hidden" asp-for="IncludeGst" />
                <input type="hidden" asp-for="GstPercent" />
                <input type="hidden" asp-for="RebatePercent" />
                <input type="hidden" asp-for="RebateMode" />
                <input type="hidden" asp-for="SchemeId" />
                <input type="hidden" asp-for="BillPercentage" />
                <input type="hidden" asp-for="ArrearInterestPercent" />
                <input type="hidden" asp-for="AfterDueSurchargePercent" />
                <input type="hidden" asp-for="UseLegacyRateDate" />
                <input type="hidden" asp-for="LegacyRateDate" />
                <input type="hidden" asp-for="ApplyCreditRebateGuard" />
                <input type="hidden" asp-for="CreditRebateThresholdMonths" />
                <input type="hidden" asp-for="MaxConsumers" />
                <button class="btn btn-primary" type="submit">Generate Eligible Bills</button>
            </form>
        }
    </div>

    @if (!Model.HasPreview)
    {
        <div class="wb-empty">Choose filters and click Preview Bills.</div>
    }
    else if (Model.PreviewRows.Count == 0)
    {
        <div class="wb-empty">No consumers found for selected filters.</div>
    }
    else
    {
        <div class="table-responsive wb-approval-table-wrap">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Consumer</th>
                        <th>Property</th>
                        <th>Division</th>
                        <th>Rate Source</th>
                        <th>Monthly Rate</th>
                        <th>Base</th>
                        <th>Cess</th>
                        <th>Arrear</th>
                        <th>Adjustments</th>
                        <th>Rebate</th>
                        <th>Total</th>
                        <th>After Due</th>
                        <th>Scheme</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.PreviewRows)
                    {
                        <tr>
                            <td>
                                <strong>@row.ConsumerNo</strong>
                                <small class="d-block text-muted">@row.ConsumerName</small>
                            </td>
                            <td>@(row.PropertyNo ?? "-")</td>
                            <td>@AppConstants.Divisions.FormatDisplay(row.DevType)</td>
                            <td>@(row.RateSource ?? "-")</td>
                            <td>@Amount(row.MonthlyRate)</td>
                            <td>@Amount(row.MinimumTotalAmount)</td>
                            <td>@Amount(row.CessAmount + row.GstAmount)</td>
                            <td>@Amount(row.ArrearAmount + row.ArrearInterest)</td>
                            <td>
                                <span class="text-danger">+@Amount(row.DebitAdjustmentAmount)</span>
                                <small class="d-block text-success">-@Amount(row.CreditAdjustmentAmount)</small>
                            </td>
                            <td>@Amount(row.RebateAmount)</td>
                            <td><strong>@Amount(row.TotalBillAmount)</strong></td>
                            <td>@Amount(row.AfterDueAmount)</td>
                            <td>
                                @(row.SchemeId ?? "-")
                                <small class="d-block text-muted">@(row.BillPercentage?.ToString() ?? "-")%</small>
                            </td>
                            <td>
                                @if (row.AlreadyGenerated)
                                {
                                    <span class="badge text-bg-secondary">Already Generated</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.Warning))
                                {
                                    <span class="badge text-bg-warning">@row.Warning</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Ready</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
