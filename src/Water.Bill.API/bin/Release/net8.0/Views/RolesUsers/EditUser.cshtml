@model UserFormViewModel
@{
    ViewData["Title"] = "Edit User";
    var divisions = ViewBag.DivisionOptions as IEnumerable<Water.Bill.Core.Common.AppConstants.DivisionOption> ?? Enumerable.Empty<Water.Bill.Core.Common.AppConstants.DivisionOption>();
    var roles = ViewBag.Roles as IEnumerable<Approle> ?? Enumerable.Empty<Approle>();
}

<div class="wb-page-head">
    <div>
        <h1>Edit User</h1>
        <p>Update user details, status, password, role, and division.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Users">Back</a>
</div>

<section class="wb-page-card wb-form-card">
    <form asp-action="EditUser" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label required" asp-for="FullName">Full Name</label>
                <input class="form-control" asp-for="FullName" required />
                <span class="text-danger small" asp-validation-for="FullName"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label required" asp-for="Username">Username</label>
                <input class="form-control" asp-for="Username" required />
                <span class="text-danger small" asp-validation-for="Username"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label required" asp-for="Email">Email</label>
                <input class="form-control" asp-for="Email" type="email" required />
                <span class="text-danger small" asp-validation-for="Email"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="PhoneNumber">Mobile Number</label>
                <input class="form-control" asp-for="PhoneNumber" />
                <span class="text-danger small" asp-validation-for="PhoneNumber"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label required" asp-for="RoleId">Role</label>
                <select class="form-select" asp-for="RoleId" required>
                    <option value="">Select Role</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </select>
                <span class="text-danger small" asp-validation-for="RoleId"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label required" asp-for="DivisionDevType">Division</label>
                <select class="form-select" asp-for="DivisionDevType" required>
                    <option value="">Select Division</option>
                    @foreach (var division in divisions)
                    {
                        <option value="@division.DevType">@division.Name</option>
                    }
                </select>
                <span class="text-danger small" asp-validation-for="DivisionDevType"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Password">New Password</label>
                <div class="input-group wb-password-group">
                    <input class="form-control" asp-for="Password" type="password" autocomplete="new-password" />
                    <button class="btn btn-outline-secondary wb-password-toggle" type="button" data-password-toggle aria-label="Show password" aria-pressed="false">
                        <span aria-hidden="true">&#128065;</span>
                    </button>
                </div>
                <span class="text-danger small" asp-validation-for="Password"></span>
                <div class="form-text">Leave blank to keep the existing password.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="ConfirmPassword">Confirm Password</label>
                <div class="input-group wb-password-group">
                    <input class="form-control" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    <button class="btn btn-outline-secondary wb-password-toggle" type="button" data-password-toggle aria-label="Show confirm password" aria-pressed="false">
                        <span aria-hidden="true">&#128065;</span>
                    </button>
                </div>
                <span class="text-danger small" asp-validation-for="ConfirmPassword"></span>
                <div class="form-text">Re-enter the new password only when changing it.</div>
            </div>
            <div class="col-12">
                <label class="form-check">
                    <input class="form-check-input" asp-for="IsActive" />
                    <span class="form-check-label">Active user</span>
                </label>
            </div>
        </div>
        <div class="wb-actions mt-4">
            <button class="btn btn-primary" type="submit">Save Changes</button>
            <a class="btn btn-outline-primary" asp-action="Users">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            document.querySelectorAll('[data-password-toggle]').forEach(button => {
                button.addEventListener('click', () => {
                    const group = button.closest('.wb-password-group');
                    const input = group?.querySelector('input');
                    if (!input) return;

                    const showing = input.type === 'text';
                    input.type = showing ? 'password' : 'text';
                    button.setAttribute('aria-pressed', (!showing).toString());
                    button.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
                    button.classList.toggle('active', !showing);
                });
            });
        })();
    </script>
}
