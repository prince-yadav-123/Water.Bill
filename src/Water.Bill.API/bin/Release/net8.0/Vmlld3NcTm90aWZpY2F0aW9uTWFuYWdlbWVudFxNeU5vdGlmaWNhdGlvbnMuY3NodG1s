@using Water.Bill.Infrastructure.Data.Entities
@model IReadOnlyList<InAppNotification>
@{
    ViewData["Title"] = "My Notifications";
}

<div class="wb-page-head">
    <div><p class="wb-kicker">Notifications</p><h1>My Notifications</h1></div>
    <form asp-action="MarkAllRead" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-secondary btn-sm" type="submit">Mark all as read</button>
    </form>
</div>

@if (TempData["NotificationMessage"] is string notificationMessage && !string.IsNullOrWhiteSpace(notificationMessage))
{
    <div class="alert alert-@((TempData["NotificationMessageType"] as string) ?? "success") alert-dismissible fade show mt-3" role="alert">
        @notificationMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="wb-page-card">
    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">No notifications yet.</div>
    }
    else
    {
        <div class="wb-notif-list-page">
            @foreach (var n in Model)
            {
                <div class="wb-notif-item @(n.IsRead ? "" : "wb-notif-unread")" data-id="@n.Id">
                    <div class="wb-notif-dot"></div>
                    <div class="wb-notif-body">
                        <div class="fw-semibold">@n.Title</div>
                        <div class="text-muted" style="font-size:.88rem">@n.Message</div>
                        <small class="text-muted">@n.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                    </div>
                    @if (!n.IsRead)
                    {
                        <button class="wb-notif-read-btn btn btn-xs btn-outline-secondary" data-read-id="@n.Id">Mark read</button>
                    }
                </div>
            }
        </div>
    }
</section>

<style>
    .wb-notif-list-page { display: flex; flex-direction: column; }
    .wb-notif-item { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.9rem 0; border-bottom: 1px solid #f1f5f9; }
    .wb-notif-item:last-child { border-bottom: none; }
    .wb-notif-unread { background: #f0f9ff; border-radius: 0.5rem; padding: 0.9rem 0.75rem; }
    .wb-notif-dot { width: 8px; height: 8px; border-radius: 50%; background: #2563eb; flex-shrink: 0; margin-top: 6px; opacity: 0; }
    .wb-notif-unread .wb-notif-dot { opacity: 1; }
    .wb-notif-body { flex: 1; }
    .btn-xs { padding: .15rem .45rem; font-size: .78rem; flex-shrink: 0; }
</style>

@section Scripts {
<script>
document.querySelectorAll('.wb-notif-read-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
        const id = btn.dataset.readId;
        const fd = new FormData();
        fd.append('__RequestVerificationToken', document.querySelector('[name="__RequestVerificationToken"]').value);
        await fetch('/NotificationManagement/MarkRead/' + id, { method: 'POST', body: fd, credentials: 'same-origin' });
        btn.closest('.wb-notif-item').classList.remove('wb-notif-unread');
        btn.remove();
    });
});
</script>
}
