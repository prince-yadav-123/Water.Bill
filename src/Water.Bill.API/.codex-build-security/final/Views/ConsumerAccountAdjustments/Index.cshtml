@model Water.Bill.API.Models.Adjustments.ConsumerAccountAdjustmentIndexViewModel
@using Water.Bill.API.Models.Adjustments
@{
    ViewData["Title"] = "Consumer Account Adjustments";
    string DateText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy") : "-";
    string Amount(decimal value) => value.ToString("N2");
    string Badge(string status) => status switch
    {
        ConsumerAdjustmentStatuses.Applied => "text-bg-success",
        ConsumerAdjustmentStatuses.Cancelled => "text-bg-danger",
        ConsumerAdjustmentStatuses.Reversed => "text-bg-secondary",
        _ => "text-bg-warning"
    };
}

<div class="wb-page-head">
    <div>
        <h1>Consumer Account Adjustments</h1>
        <p>Add arrear, credit, rebate, penalty, and advance entries without changing old bill rows.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New Adjustment</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success wb-alert">@success</div>
}

<section class="wb-page-card wb-admin-card">
    <form method="get" class="wb-filter-bar wb-bill-filter-bar">
        <div class="wb-filter-field wb-filter-search">
            <label class="form-label">Search</label>
            <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Adjustment / consumer / bill / remarks" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Consumer No</label>
            <input class="form-control" type="search" name="consumerNo" value="@Model.ConsumerNo" placeholder="Consumer No" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Type</label>
            <select class="form-select" name="adjustmentType" asp-items="Model.TypeOptions">
                <option value="">All Types</option>
            </select>
        </div>
        <div class="wb-filter-field">
            <label class="form-label">Status</label>
            <select class="form-select" name="status">
                <option value="">All Status</option>
                <option value="Pending" selected="@(Model.Status == ConsumerAdjustmentStatuses.Pending)">Pending</option>
                <option value="Applied" selected="@(Model.Status == ConsumerAdjustmentStatuses.Applied)">Applied</option>
                <option value="Cancelled" selected="@(Model.Status == ConsumerAdjustmentStatuses.Cancelled)">Cancelled</option>
                <option value="Reversed" selected="@(Model.Status == ConsumerAdjustmentStatuses.Reversed)">Reversed</option>
            </select>
        </div>
        <div class="wb-filter-field">
            <label class="form-label">From Date</label>
            <input class="form-control" type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="wb-filter-field">
            <label class="form-label">To Date</label>
            <input class="form-control" type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="wb-filter-actions">
            <button class="btn btn-primary" type="submit">Filter</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
        </div>
    </form>

    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mt-3 mb-3">
        <div>
            <h2 class="wb-section-title mb-1">Adjustment Ledger</h2>
            <p class="text-muted mb-0">Pending entries are picked up by future bulk bill generation.</p>
        </div>
        <span class="badge text-bg-secondary">@Model.Rows.Count record@(Model.Rows.Count == 1 ? "" : "s")</span>
    </div>

    @if (Model.Rows.Count == 0)
    {
        <div class="wb-empty">No adjustments found.</div>
    }
    else
    {
        <div class="table-responsive wb-approval-table-wrap">
            <table class="table align-middle wb-table wb-admin-table wb-approval-table">
                <thead>
                    <tr>
                        <th>Adjustment No</th>
                        <th>Consumer</th>
                        <th>Property</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Effective Date</th>
                        <th>Status</th>
                        <th>Applied Bill</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td><strong>@row.AdjustmentNo</strong></td>
                        <td>
                            <div class="fw-semibold">@row.ConsumerNo</div>
                            <small class="text-muted">@((row.ConsumerName ?? "-")) - @(row.MobileNo ?? "-")</small>
                        </td>
                        <td>@(row.PropertyNo ?? "-")</td>
                        <td>@ConsumerAdjustmentTypes.Display(row.AdjustmentType)</td>
                        <td class="@(row.SignedAmount < 0 ? "text-success" : "text-danger")">@(row.SignedAmount < 0 ? "-" : "+")@Amount(Math.Abs(row.SignedAmount))</td>
                        <td>@DateText(row.EffectiveDate)</td>
                        <td><span class="badge @Badge(row.Status)">@row.Status</span></td>
                        <td>@(row.AppliedBillNo ?? "-")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@row.Id">View</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
