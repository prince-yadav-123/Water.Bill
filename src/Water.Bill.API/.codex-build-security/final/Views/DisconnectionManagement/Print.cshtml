@model Water.Bill.API.Models.Disconnections.DisconnectionDetailsViewModel
@using Water.Bill.API.Models.Disconnections
@using Water.Bill.Core.Common
@{
    Layout = null;
    string DateText(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM yyyy") : "-";
    string Amount(decimal value) => value.ToString("N2");
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Disconnection Notice - @Model.CaseNo</title>
    <style>
        body { margin: 0; background: #f3f7fb; color: #0f172a; font-family: Arial, sans-serif; font-size: 13px; }
        .sheet { width: 900px; max-width: calc(100% - 32px); margin: 24px auto; background: #fff; border: 1px solid #dbe5ef; border-radius: 10px; overflow: hidden; }
        .head { display: flex; justify-content: space-between; gap: 16px; padding: 20px; border-bottom: 1px solid #dbe5ef; }
        h1 { margin: 0 0 6px; font-size: 22px; }
        .muted { color: #64748b; }
        .actions { display: flex; gap: 8px; align-items: flex-start; }
        button, a { border: 1px solid #0ea5b7; border-radius: 8px; padding: 8px 14px; background: #0ea5b7; color: #fff; font-weight: 700; text-decoration: none; cursor: pointer; }
        a { background: #fff; color: #0f172a; border-color: #cbd5e1; }
        .grid { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid #dbe5ef; }
        .grid div { padding: 12px 14px; border-right: 1px solid #dbe5ef; border-bottom: 1px solid #dbe5ef; }
        .grid div:nth-child(3n) { border-right: 0; }
        .grid span { display: block; color: #64748b; font-size: 11px; text-transform: uppercase; font-weight: 700; }
        .grid strong { display: block; margin-top: 4px; }
        .content { padding: 22px 24px; line-height: 1.65; }
        .amount { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 18px 0; }
        .amount div { border: 1px solid #dbe5ef; border-radius: 8px; padding: 12px; background: #f8fafc; }
        .sign { display: flex; justify-content: space-between; gap: 24px; margin-top: 42px; }
        @@media print {
            body { background: #fff; }
            .sheet { width: 100%; max-width: 100%; margin: 0; border: 0; border-radius: 0; }
            .actions { display: none; }
        }
    </style>
</head>
<body>
    <main class="sheet">
        <section class="head">
            <div>
                <h1>Disconnection Notice</h1>
                <div class="muted">Noida Jal Water Billing · Case @Model.CaseNo</div>
            </div>
            <div class="actions">
                <button type="button" onclick="window.print()">Print</button>
                <a href="javascript:window.close()">Close</a>
            </div>
        </section>

        <section class="grid">
            <div><span>Consumer No</span><strong>@Model.ConsumerNo</strong></div>
            <div><span>Consumer Name</span><strong>@Text(Model.ConsumerName)</strong></div>
            <div><span>Mobile</span><strong>@Text(Model.Consumer?.MobileNo)</strong></div>
            <div><span>Property</span><strong>@Text(Model.PropertyNo)</strong></div>
            <div><span>Division</span><strong>@AppConstants.Divisions.FormatDisplay(Model.Consumer?.DevType)</strong></div>
            <div><span>Notice Date</span><strong>@DateText(Model.NoticeDate)</strong></div>
            <div><span>Reason</span><strong>@DisconnectionReasons.Display(Model.Reason)</strong></div>
            <div><span>Compliance Due Date</span><strong>@DateText(Model.DueDate)</strong></div>
            <div><span>Status</span><strong>@DisconnectionCaseStatuses.Display(Model.Status)</strong></div>
        </section>

        <section class="content">
            <p>
                This is to inform you that your water connection account has been listed for disconnection action due to
                <strong>@DisconnectionReasons.Display(Model.Reason)</strong>. You are requested to clear dues or contact the authority
                before the compliance due date mentioned above.
            </p>
            <div class="amount">
                <div><span>Outstanding Amount</span><strong>Rs. @Amount(Model.OutstandingAmount)</strong></div>
                <div><span>Disconnection Fee</span><strong>Rs. @Amount(Model.DisconnectionFee)</strong></div>
                <div><span>Reconnection Fee</span><strong>Rs. @Amount(Model.ReconnectionFee)</strong></div>
            </div>
            <p><strong>Address:</strong> @Text(Model.Consumer?.Address)</p>
            <p><strong>Remarks:</strong> @Text(Model.Remarks)</p>
            <p>
                If payment or compliance has already been completed, please produce the receipt/details at the concerned office
                for verification.
            </p>
            <div class="sign">
                <div>
                    <strong>Field Officer</strong><br />
                    @Text(Model.FieldOfficerName)
                </div>
                <div>
                    <strong>Authorized Signatory</strong><br />
                    Noida Jal Authority
                </div>
            </div>
        </section>
    </main>
</body>
</html>
