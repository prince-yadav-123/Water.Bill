@model Water.Bill.API.Models.ConsumerWorkflows.ConnectionChangeCreateViewModel
@using Water.Bill.Core.Common
@{
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}

<div class="wb-page-head">
    <div>
        <h1>Create Connection Change</h1>
        <p>Stage a type/category change request. Live consumer data is updated only after approval.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="SearchConsumer">Back</a>
</div>

<section class="wb-page-card wb-admin-card">
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <small class="text-muted">Consumer No</small>
            <div class="fw-semibold">@Model.ConsumerNo</div>
        </div>
        <div class="col-md-3">
            <small class="text-muted">Consumer Name</small>
            <div class="fw-semibold">@Text(Model.Consumer?.ConsNm1)</div>
        </div>
        <div class="col-md-3">
            <small class="text-muted">Current Type / Category</small>
            <div class="fw-semibold">@Text(Model.Consumer?.ConTp) / @Text(Model.Consumer?.ConsCtg)</div>
        </div>
        <div class="col-md-3">
            <small class="text-muted">Division</small>
            <div class="fw-semibold">@AppConstants.Divisions.FormatDisplay(Model.Consumer?.DevType)</div>
        </div>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ConsumerNo" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="wb-form-grid">
            <div>
                <label class="form-label required" asp-for="NewConnectionType">New Connection Type</label>
                <select class="form-select" asp-for="NewConnectionType" asp-items="Model.ConnectionTypeOptions">
                    <option value="">Keep Existing</option>
                </select>
                <span class="text-danger" asp-validation-for="NewConnectionType"></span>
            </div>
            <div>
                <label class="form-label required" asp-for="NewConsumerCategory">New Consumer Category</label>
                <select class="form-select" asp-for="NewConsumerCategory" asp-items="Model.ConsumerCategoryOptions">
                    <option value="">Select Category</option>
                </select>
                <span class="text-danger" asp-validation-for="NewConsumerCategory"></span>
            </div>
            <div>
                <label class="form-label required" asp-for="TypeChangeDate">Type Change Date</label>
                <input class="form-control" asp-for="TypeChangeDate" type="date" />
                <span class="text-danger" asp-validation-for="TypeChangeDate"></span>
            </div>
            <div>
                <label class="form-label required" asp-for="EstimationNo">Estimation No</label>
                <input class="form-control" asp-for="EstimationNo" maxlength="10" />
                <span class="text-danger" asp-validation-for="EstimationNo"></span>
            </div>
            <div>
                <label class="form-label required" asp-for="EstimationAmount">Estimation Amount</label>
                <input class="form-control" asp-for="EstimationAmount" type="number" step="0.01" />
                <span class="text-danger" asp-validation-for="EstimationAmount"></span>
            </div>
            <div>
                <label class="form-label required" asp-for="SecurityAmount">Security Amount</label>
                <input class="form-control" asp-for="SecurityAmount" type="number" step="0.01" />
                <span class="text-danger" asp-validation-for="SecurityAmount"></span>
            </div>
            <div>
                <label class="form-label required" asp-for="MonthlyRate">Monthly Rate</label>
                <input class="form-control" asp-for="MonthlyRate" type="number" step="0.01" />
                <span class="text-danger" asp-validation-for="MonthlyRate"></span>
            </div>
            <div class="wb-form-span-2">
                <label class="form-label required" asp-for="Remarks">Remarks</label>
                <textarea class="form-control" asp-for="Remarks" rows="3" maxlength="500"></textarea>
                <span class="text-danger" asp-validation-for="Remarks"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-secondary" asp-action="SearchConsumer">Cancel</a>
            <button class="btn btn-primary" type="submit">Save Request</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
